{
  "name": "logic-estancia",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @logic-estancia/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts tests/e2e --no-error-on-unmatched-pattern",
    "test": "turbo run test",
    "check": "pnpm lint && turbo run typecheck test build && vitest run scripts/*.test.mjs",
    "e2e": "pnpm build && playwright test",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "images": "node scripts/images.mjs",
    "smoke:resend": "pnpm --filter @logic-estancia/worker smoke:resend",
    "commercial:template": "node scripts/commercial-template.mjs",
    "funnel:report": "node scripts/funnel-report.mjs",
    "deploy": "pnpm --filter @logic-estancia/worker deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.31.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.0",
    "sharp": "^0.34.3",
    "tslib": "^2.8.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.7",
    "wrangler": "4.113.0"
  }
}
