---
import type { DemoLocale, DemoSlug } from '../data';
import { demos } from '../data';
const { slug, locale } = Astro.props as { slug: DemoSlug; locale: DemoLocale };
const demo = demos[slug]; const c = demo[locale]; const prefix = locale === 'en' ? '/en' : '';
const hasManager = slug !== 'nivora';
const secondImage = `/media/${slug}/detail.webp`;
const imageAlt = locale === 'es' ? `Interior y atmósfera de ${demo.brand}` : `${demo.brand} interior and atmosphere`;
const detailAlt = locale === 'es' ? `Detalle de la experiencia ${demo.brand}` : `${demo.brand} experience detail`;
const arrival = slug === 'aurem' ? '2026-08-14' : '2026-08-21';
const departure = slug === 'aurem' ? '2026-08-17' : '2026-08-24';
const managerView = slug === 'terrava' ? 'enquiries' : 'bookings';
const managerHref = `${prefix}/demos/${slug}/gestion/?vista=${managerView}`;
---
<header class="demo-nav">
  <a class="demo-wordmark" href={`${prefix}/demos/${slug}/`}>{demo.brand}</a>
  <nav>{c.nav.map((item, i) => <a href={i === 2 ? '#reserva' : i === 1 ? '#experiencia' : '#espacio'}>{item}</a>)}</nav>
  {hasManager && <a class="manager-link" href={`${prefix}/demos/${slug}/gestion/`}>{locale === 'es' ? 'Ver gestor' : 'Open workspace'}</a>}
  <a class="book-link" href="#reserva">{c.cta}</a>
</header>
<main>
  <section class="demo-hero"><div class="demo-hero-copy"><p class="demo-eyebrow">{c.eyebrow}</p><h1>{c.title[0]} <em>{c.title[1]}</em></h1><p>{c.intro}</p><a href="#reserva">{c.cta}<span>→</span></a></div><figure><picture><source type="image/avif" srcset={`/media/${slug}/hero-640.avif 640w, /media/${slug}/hero-960.avif 960w, /media/${slug}/hero-1600.avif 1600w`} sizes="(max-width: 820px) 100vw, 55vw" /><img src={`/media/${slug}/hero.webp`} alt={imageAlt} width="2016" height="1344" fetchpriority="high" /></picture></figure></section>
  <section id="espacio" class="demo-intro"><div><p class="demo-eyebrow">{demo.kind}</p><h2>{c.section}</h2></div><div><p>{c.body}</p><ul>{c.detail.map((item) => <li>{item}</li>)}</ul></div></section>
  <section id="experiencia" class="demo-editorial"><figure><picture><source type="image/avif" srcset={`/media/${slug}/detail-640.avif 640w, /media/${slug}/detail-960.avif 960w, /media/${slug}/detail-1600.avif 1600w`} sizes="(max-width: 820px) 100vw, 50vw" /><img src={secondImage} alt={detailAlt} width="2016" height="1344" loading="lazy" /></picture></figure><div><p class="demo-eyebrow">{locale === 'es' ? 'Una estancia con contexto' : 'A stay with context'}</p><h2>{slug === 'nivora' ? (locale === 'es' ? 'Una guía que cabe en el bolsillo.' : 'A guide that fits in your pocket.') : slug === 'terrava' ? (locale === 'es' ? 'Caminar, cocinar, volver.' : 'Walk, cook, return.') : (locale === 'es' ? 'Servicio sin ruido.' : 'Service without noise.')}</h2><p>{slug === 'nivora' ? (locale === 'es' ? 'Mercado, café, arquitectura y rutas a pie seleccionadas desde la propia web.' : 'Markets, coffee, architecture and walks selected from the website.') : slug === 'terrava' ? (locale === 'es' ? 'Cada casa propone rutas y productores cercanos sin convertir el paisaje en un catálogo.' : 'Every home suggests nearby walks and makers without turning the landscape into a catalogue.') : (locale === 'es' ? 'Llegada preparada, habitación disponible y decisiones del equipo conectadas.' : 'Prepared arrival, available room and connected team decisions.')}</p></div></section>
  <section id="reserva" class="demo-booking"><div><p class="demo-eyebrow">{demo.level} · Logic Estancia</p><h2>{c.formTitle}</h2><p>{c.formBody}</p></div><form data-demo-form><label>{locale === 'es' ? 'Entrada' : 'Arrival'}<input name="from" type="date" value={arrival} required/></label><label>{locale === 'es' ? 'Salida' : 'Departure'}<input name="to" type="date" value={departure} required/></label><label>{locale === 'es' ? 'Huéspedes' : 'Guests'}<input name="guests" type="number" min="1" max="8" value="2" required/></label><label>{locale === 'es' ? 'Nombre' : 'Name'}<input name="name" required maxlength="120" value="Alex Demo"/></label><label class="full">Email<input name="email" type="email" required maxlength="200" value="alex@example.test"/></label><button type="submit">{slug === 'aurem' ? (locale === 'es' ? 'Continuar a pago demo' : 'Continue to demo payment') : c.cta}<span>→</span></button><p class="demo-result full" role="status"></p>{hasManager && <a class="demo-manager-next full" href={managerHref} data-manager-next hidden>{slug === 'terrava' ? (locale === 'es' ? 'Abrir la solicitud en el gestor' : 'Open the enquiry in the workspace') : (locale === 'es' ? 'Ver la reserva en el gestor' : 'View the booking in the workspace')} <span>→</span></a>}</form></section>
</main>
<dialog class="payment-demo" data-payment><button data-close aria-label="Cerrar">×</button><p class="demo-eyebrow">{locale === 'es' ? 'Pasarela neutra · demo' : 'Neutral checkout · demo'}</p><h2>{locale === 'es' ? 'No se realizará ningún cobro.' : 'No charge will be made.'}</h2><div><span data-stay-summary>{locale === 'es' ? 'Terrace · 3 noches' : 'Terrace · 3 nights'}</span><strong data-stay-amount>€ 684</strong></div><button data-pay>{locale === 'es' ? 'Confirmar reserva simulada' : 'Confirm simulated booking'}</button></dialog>
<script is:inline define:vars={{ slug, locale }}>
  const form = document.querySelector('[data-demo-form]'); const result = document.querySelector('.demo-result'); const dialog = document.querySelector('[data-payment]'); const managerNext = document.querySelector('[data-manager-next]');
  const fromInput = form?.querySelector('[name=from]'); const toInput = form?.querySelector('[name=to]');
  const dateError = locale === 'es' ? 'La salida debe ser posterior a la entrada.' : 'Departure must be after arrival.';
  const validateDates = () => {
    toInput?.setCustomValidity('');
    if (!fromInput?.value || !toInput?.value || new Date(toInput.value) > new Date(fromInput.value)) return true;
    toInput.setCustomValidity(dateError); if (result) result.textContent = dateError; managerNext?.setAttribute('hidden', ''); toInput.reportValidity(); return false;
  };
  const journey = () => {
    const data = Object.fromEntries(new FormData(form));
    const nights = Math.max(1, Math.round((new Date(data.to) - new Date(data.from)) / 86400000));
    return { name: String(data.name).trim(), email: String(data.email).trim(), from: String(data.from), to: String(data.to), guests: Number(data.guests), amount: nights * (slug === 'aurem' ? 228 : 204), source: 'website' };
  };
  const saveJourney = () => {
    if (slug !== 'terrava' && slug !== 'aurem') return;
    const key = `logic-estancia-demo-${slug}-v2`; let current = {};
    try { const parsed = JSON.parse(localStorage.getItem(key)); if (parsed?.version === 2) current = parsed; } catch {}
    const title = slug === 'aurem' ? 'Todo dispuesto antes de llegar.' : 'El tiempo cambia cuando llegas.';
    const defaults = { version: 2, selectedProperty: 'all', role: slug === 'aurem' ? 'direction' : 'reception', enquiry: 'new', cleaning: 'pending', stayOperation: 'original', arrivalRisk: 'detected', maintenance: 'new', channelReview: 'pending', aiDraft: null, aiReview: 'draft', aiRevision: 1, tourMode: 'unset', tourStep: null, completedFlows: [], website: { publishedTitle: title, draftTitle: title, status: 'clean' } };
    localStorage.setItem(key, JSON.stringify({ ...defaults, ...current, ...(slug === 'terrava' ? { enquiry: 'new' } : {}), stay: journey() }));
  };
  const showManager = () => managerNext?.removeAttribute('hidden');
  fromInput?.addEventListener('change', () => { if (toInput && fromInput.value) { const next = new Date(`${fromInput.value}T00:00:00Z`); next.setUTCDate(next.getUTCDate() + 1); toInput.min = next.toISOString().slice(0, 10); } validateDates(); });
  toInput?.addEventListener('change', validateDates);
  form?.addEventListener('input', () => { managerNext?.setAttribute('hidden', ''); if (result) result.textContent = ''; });
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (!validateDates() || !form.reportValidity()) return; if (slug === 'aurem') { const stay = journey(); const nights = Math.max(1, Math.round((new Date(stay.to) - new Date(stay.from)) / 86400000)); const summary = document.querySelector('[data-stay-summary]'); const amount = document.querySelector('[data-stay-amount]'); if (summary) summary.textContent = `Terrace · ${nights} ${locale === 'es' ? (nights === 1 ? 'noche' : 'noches') : (nights === 1 ? 'night' : 'nights')}`; if (amount) amount.textContent = `€ ${stay.amount}`; dialog?.showModal(); } else if (result) { if (slug === 'terrava') { saveJourney(); showManager(); } result.textContent = locale === 'es' ? (slug === 'terrava' ? 'Solicitud demo creada. El gestor propondrá Casa Bruma como alternativa.' : 'Consulta demo recibida. No se ha bloqueado inventario.') : (slug === 'terrava' ? 'Demo enquiry created. The workspace will suggest Casa Bruma.' : 'Demo enquiry received. No inventory was blocked.'); } });
  document.querySelector('[data-close]')?.addEventListener('click', () => dialog?.close());
  document.querySelector('[data-pay]')?.addEventListener('click', () => { saveJourney(); showManager(); dialog?.close(); if (result) result.textContent = locale === 'es' ? 'Reserva AUR-812 confirmada en esta demo. No se ha realizado ningún cobro.' : 'Booking AUR-812 confirmed in this demo. No charge was made.'; });
</script>
