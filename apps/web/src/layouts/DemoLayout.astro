---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@logic-estancia/ui/theme.css';
import '../styles/demos.css';
import { CONSENT } from '@logic-estancia/config';
import analyticsContract from '@logic-estancia/config/analytics-contract';
import type { DemoLocale, DemoSlug } from '../data';
import { demos } from '../data';
const { slug, locale, dashboard = false } = Astro.props as { slug: DemoSlug; locale: DemoLocale; dashboard?: boolean };
const demo = demos[slug]; const prefix = locale === 'en' ? '/en' : '';
const other = locale === 'es' ? `/en/demos/${slug}/${dashboard ? 'gestion/' : ''}` : `/demos/${slug}/${dashboard ? 'gestion/' : ''}`;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content={slug === 'aurem' ? '#131719' : slug === 'terrava' ? '#f1efe6' : '#f5f0e8'}/><link rel="icon" href="/favicon.svg"/><title>{demo.brand} · {dashboard ? 'Demo gestor' : 'Demo web'}</title></head><body class={`demo-body ${demo.theme} ${dashboard ? 'dashboard-page' : ''}`}>
  {!dashboard && <div class="fiction"><span>{locale === 'es' ? 'Demostración ficticia de Logic Estancia' : 'Fictitious Logic Estancia demonstration'}</span><a href={`${prefix}/`}>{locale === 'es' ? 'Volver al producto' : 'Back to product'} ↗</a></div>}
  <slot />
  {!dashboard && <footer class="demo-footer"><span>{demo.brand}</span><small>{locale === 'es' ? 'Marca ficticia · Sin reservas ni cobros reales' : 'Fictitious brand · No live bookings or charges'}</small><div><a href={other}>{locale === 'es' ? 'EN' : 'ES'}</a><a href={`${prefix}/legal/`}>Legal</a><a href="https://wa.me/34626432316" target="_blank" rel="noopener noreferrer">Logic2B ↗</a></div></footer>}
  <script is:inline define:vars={{ slug, locale, dashboard, consentKey: CONSENT.key, legacyConsentKey: CONSENT.legacyKey, consentVersion: CONSENT.version, allowedAnalyticsEvents: analyticsContract.surfaces.demo, allowedAnalyticsParameters: analyticsContract.parameters }}>
    const hasAnalyticsConsent = () => {
      try {
        const raw = localStorage.getItem(consentKey);
        const stored = raw ? JSON.parse(raw) : null;
        if (stored?.version === consentVersion && stored?.essential === true && typeof stored?.analytics === 'boolean') return stored.analytics;
        return localStorage.getItem(legacyConsentKey) === 'analytics';
      } catch { return false; }
    };
    const allowedEvents = new Set(allowedAnalyticsEvents);
    window.estanciaTrack = (event, parameters = {}) => {
      if (!hasAnalyticsConsent() || !allowedEvents.has(event)) return;
      const safe = Object.fromEntries(Object.entries(parameters).filter(([key, value]) => allowedAnalyticsParameters.includes(key) && (typeof value === 'string' || typeof value === 'number')));
      window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event, ...safe });
    };
    if (hasAnalyticsConsent()) {
      window.dataLayer = window.dataLayer || []; window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const script = document.createElement('script'); script.dataset.gtm = 'true'; script.async = true; script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TVDWZ9LC'; document.head.append(script);
      if (!dashboard) window.estanciaTrack('demo_open', { locale, demo: slug, source_section: 'website' });
    }
  </script>
</body></html>
