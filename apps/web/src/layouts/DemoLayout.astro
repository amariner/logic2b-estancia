---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@logic-estancia/ui/theme.css';
import '../styles/demos.css';
import type { DemoLocale, DemoSlug } from '../data';
import { demos } from '../data';
const { slug, locale, dashboard = false } = Astro.props as { slug: DemoSlug; locale: DemoLocale; dashboard?: boolean };
const demo = demos[slug]; const prefix = locale === 'en' ? '/en' : '';
const other = locale === 'es' ? `/en/demos/${slug}/${dashboard ? 'gestion/' : ''}` : `/demos/${slug}/${dashboard ? 'gestion/' : ''}`;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content={slug === 'aurem' ? '#131719' : slug === 'terrava' ? '#f1efe6' : '#f5f0e8'}/><link rel="icon" href="/favicon.svg"/><title>{demo.brand} · {dashboard ? 'Panel visual demo' : 'Demo web'}</title></head><body class={`demo-body ${demo.theme} ${dashboard ? 'dashboard-page' : ''}`}>
  {!dashboard && <div class="fiction" role="note" aria-label={locale === 'es' ? 'Límite de la demostración' : 'Demonstration boundary'}><span>{locale === 'es' ? 'MODO DEMO SEGURO · Datos ficticios · Sin efectos externos' : 'SAFE DEMO MODE · Fictitious data · No external effects'}</span><a href={`${prefix}/`}>{locale === 'es' ? 'Salir de la demo' : 'Leave demo'} ↗</a></div>}
  <slot />
  {!dashboard && <footer class="demo-footer"><span>{demo.brand}</span><small>{locale === 'es' ? 'Marca ficticia · Solo visualización' : 'Fictitious brand · View only'}</small><div><a href={other}>{locale === 'es' ? 'EN' : 'ES'}</a><a href={`${prefix}/legal/`}>Legal</a><a href={`${prefix}/#contacto`}>Logic2B ↗</a></div></footer>}
</body></html>
