{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "logic-estancia",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "LEADS_TRANSPORT": "resend"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEAD_COORDINATOR", "class_name": "LeadCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LeadCoordinator"] }
  ],
  "routes": [
    { "pattern": "estancia.logic2b.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
