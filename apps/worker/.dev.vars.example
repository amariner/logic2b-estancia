# Safe local demo. It starts and remains navigable without provider secrets.
DEMO_MODE=true
REAL_OPERATIONS_ENABLED=false
COMMERCIAL_LEADS_ENABLED=false
EMAIL_PROVIDER_MODE=disabled
ANALYTICS_PROVIDER_MODE=disabled
LEADS_TRANSPORT=disabled
LEADS_ALLOW_LOCAL_JURISDICTION_FALLBACK=true

# The commercial-lead exception needs COMMERCIAL_LEADS_ENABLED=true plus a
# complete Resend configuration. Product demos remain isolated either way.
# Real email addresses, provider credentials and meeting URLs belong only in an
# approved environment. Never add them to this tracked example.
