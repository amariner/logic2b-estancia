---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@logic-estancia/ui/theme.css';
import '../styles/site.css';
import { CONSENT, PRODUCT, type Locale } from '@logic-estancia/config';
import { logic2bContact } from '@logic-estancia/config/contact';
import analyticsContract from '@logic-estancia/config/analytics-contract';
import CookieBanner from '../components/CookieBanner.astro';
import { content } from '../content';

interface Props { locale: Locale; title?: string; description?: string; route?: string; alternateRoute?: string; translated?: boolean; }
const { locale, title = 'Logic Estancia', description = 'Web, reserva directa y operación para alojamientos.', route = '', alternateRoute, translated = true } = Astro.props;
const c = content[locale];
const prefix = locale === 'en' ? '/en' : '';
const cleanRoute = route.replace(/^\//, '').replace(/\/$/, '');
const routePath = cleanRoute ? `/${cleanRoute}/` : '/';
const canonical = `${PRODUCT.url}${prefix}${routePath}`;
const cleanAlternate = (alternateRoute ?? route).replace(/^\//, '').replace(/\/$/, '');
const alternatePath = cleanAlternate ? `/${cleanAlternate}/` : '/';
const alternateEs = `${PRODUCT.url}${locale === 'es' ? routePath : alternatePath}`;
const alternateEn = `${PRODUCT.url}/en${locale === 'en' ? routePath : alternatePath}`;
const localeHref = locale === 'es' ? `/en${alternatePath}` : alternatePath;
const socialLocale = locale === 'es' ? 'es_ES' : 'en_GB';
const alternateSocialLocale = locale === 'es' ? 'en_GB' : 'es_ES';
const wa = logic2bContact(locale, route.startsWith('docs') ? 'docs' : 'commercial');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${PRODUCT.url}/#organization`,
    name: 'Logic2B',
    url: 'https://logic2b.com',
    email: PRODUCT.email,
    telephone: wa.phone,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${PRODUCT.url}/#website`,
    url: PRODUCT.url,
    name: PRODUCT.name,
    inLanguage: ['es', 'en'],
    publisher: { '@id': `${PRODUCT.url}/#organization` },
  },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {translated && <link rel="alternate" hreflang="es" href={alternateEs} />}
    {translated && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {translated && <link rel="alternate" hreflang="x-default" href={alternateEs} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:locale:alternate" content={alternateSocialLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="topbar shell">
        <a class="wordmark" href={`${prefix}/`} aria-label="Logic2B Estancias">
          <span class="wordmark-core">Logic<strong>2B</strong></span><span class="wordmark-product">Estancias</span>
        </a>
        <nav aria-label={locale === 'es' ? 'Principal' : 'Main'}>
          <a href={`${prefix}/${locale === 'es' ? 'soluciones/gestores' : 'solutions/managers'}/`}>{c.nav.product}</a>
          <a href={`${prefix}/#demos`}>{c.nav.demos}</a>
          <a href={`${prefix}/${locale === 'es' ? 'planes' : 'plans'}/`}>{c.nav.levels}</a>
        </nav>
        <div class="top-actions">
          {translated && <a class="locale" href={localeHref}>{locale === 'es' ? 'EN' : 'ES'}</a>}
          <a class="pill" href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`} data-track="cta_click" data-section="header">{c.nav.contact}</a>
        </div>
        <button class="menu" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
      </div>
      <div id="mobile-nav" class="mobile-nav" hidden>
        <a href={`${prefix}/${locale === 'es' ? 'soluciones/gestores' : 'solutions/managers'}/`}>{c.nav.product}</a><a href={`${prefix}/#demos`}>{c.nav.demos}</a><a href={`${prefix}/${locale === 'es' ? 'planes' : 'plans'}/`}>{c.nav.levels}</a><a href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`}>{c.nav.contact}</a>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="footer shell">
      <a class="wordmark" href={`${prefix}/`} aria-label="Logic2B Estancias"><span class="wordmark-core">Logic<strong>2B</strong></span><span class="wordmark-product">Estancias</span></a>
      <div><a href={`${prefix}/docs/`}>{c.nav.docs}</a><a href={`${prefix}/legal/`}>Legal</a><a href={`${prefix}/privacidad/`}>{locale === 'es' ? 'Privacidad' : 'Privacy'}</a><a href={`${prefix}/cookies/`}>Cookies</a></div>
      <p>© 2026 Logic2B · Castelló</p>
    </footer>
    <a class="whatsapp" href={wa.href} target="_blank" rel="noopener noreferrer" aria-label={`${wa.label} · WhatsApp`} data-whatsapp hidden>{wa.label}<span aria-hidden="true">↗</span></a>
    <CookieBanner locale={locale} />
    <script is:inline define:vars={{ consentKey: CONSENT.key, legacyConsentKey: CONSENT.legacyKey, consentVersion: CONSENT.version, allowedAnalyticsEvents: analyticsContract.surfaces.site, allowedAnalyticsParameters: analyticsContract.parameters }}>
      const menu = document.querySelector('.menu');
      const mobile = document.querySelector('#mobile-nav');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!open)); if (mobile) mobile.hidden = open; });
      const consent = document.querySelector('[data-consent-banner]');
      function hasAnalyticsConsent() {
        try {
          const raw = localStorage.getItem(consentKey);
          const stored = raw ? JSON.parse(raw) : null;
          if (stored?.version === consentVersion && stored?.essential === true && typeof stored?.analytics === 'boolean') return stored.analytics;
          return localStorage.getItem(legacyConsentKey) === 'analytics';
        } catch { return false; }
      }
      function loadGtm() {
        if (document.querySelector('script[data-gtm]')) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const script = document.createElement('script'); script.dataset.gtm = 'true'; script.async = true; script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TVDWZ9LC'; document.head.append(script);
      }
      window.estanciaLoadGtm = loadGtm;
      if (hasAnalyticsConsent()) loadGtm();
      const allowedEvents = new Set(allowedAnalyticsEvents);
      window.estanciaTrack = (event, parameters = {}) => {
        if (!hasAnalyticsConsent() || !allowedEvents.has(event)) return;
        const safe = Object.fromEntries(Object.entries(parameters).filter(([key, value]) => allowedAnalyticsParameters.includes(key) && (typeof value === 'string' || typeof value === 'number')));
        window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event, ...safe });
      };
      document.addEventListener('click', (event) => { const target = event.target.closest?.('[data-track]'); if (!target) return; window.estanciaTrack?.(target.dataset.track, { locale: document.documentElement.lang, plan: target.dataset.plan, segment: target.dataset.segment, source_section: target.dataset.section }); });
      const wa = document.querySelector('[data-whatsapp]');
      const toggleWa = () => { if (wa) wa.hidden = window.scrollY < 280 || !consent?.hasAttribute('hidden'); };
      addEventListener('scroll', toggleWa, { passive: true });
      addEventListener('estancia:consent-visibility', toggleWa);
      toggleWa();
    </script>
  </body>
</html>
