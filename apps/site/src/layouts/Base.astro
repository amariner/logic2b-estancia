---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import sourceSerifFontUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '@logic-estancia/ui/theme.css';
import '../styles/site.css';
import { CONSENT, PRODUCT, type Locale } from '@logic-estancia/config';
import { logic2bContact } from '@logic-estancia/config/contact';
import analyticsContract from '@logic-estancia/config/analytics-contract';
import CookieBanner from '../components/CookieBanner.astro';
import BrandLockup from '../components/BrandLockup.astro';
import { content } from '../content';
import { getBusinesses } from '../businesses';
import { getHomeContract } from '../home-contract';
import { ANALYTICS_SAFE_PATHS } from '../public-routes';

interface Props { locale: Locale; title?: string; description?: string; route?: string; alternateRoute?: string; translated?: boolean; image?: string; imageAlt?: string; preloadImage?: string; preloadImageSrcset?: string; preloadImageSizes?: string; preloadImageType?: string; }
const { locale, title = 'Logic2B Estancias', description = 'Web, reservas y operación para alojamientos.', route = '', alternateRoute, translated = true, image = '/og-estancias.jpg', imageAlt, preloadImage, preloadImageSrcset, preloadImageSizes, preloadImageType } = Astro.props;
const c = content[locale];
const businessNav = getBusinesses(locale);
const prefix = locale === 'en' ? '/en' : '';
const cleanRoute = route.replace(/^\//, '').replace(/\/$/, '');
const routePath = cleanRoute ? `/${cleanRoute}/` : '/';
const productNav = getHomeContract(locale).navigation.map((item) => ({
  ...item,
  href: item.href.startsWith('#') ? (routePath === '/' ? item.href : `${prefix}/${item.href}`) : `${prefix}${item.href}`,
}));
const canonical = `${PRODUCT.url}${prefix}${routePath}`;
const cleanAlternate = (alternateRoute ?? route).replace(/^\//, '').replace(/\/$/, '');
const alternatePath = cleanAlternate ? `/${cleanAlternate}/` : '/';
const alternateEs = `${PRODUCT.url}${locale === 'es' ? routePath : alternatePath}`;
const alternateEn = `${PRODUCT.url}/en${locale === 'en' ? routePath : alternatePath}`;
const localeHref = locale === 'es' ? `/en${alternatePath}` : alternatePath;
const socialLocale = locale === 'es' ? 'es_ES' : 'en_GB';
const alternateSocialLocale = locale === 'es' ? 'en_GB' : 'es_ES';
const socialImage = new URL(image, PRODUCT.url).toString();
const socialImageAlt = imageAlt ?? (image === '/og-estancias.jpg'
  ? (locale === 'es' ? 'Logic2B Estancias — una forma más clara de dirigir tus estancias' : 'Logic2B Estancias — a clearer way to run your stays')
  : (locale === 'es' ? 'Escenario visual ficticio de un alojamiento' : 'Fictional visual scenario for an accommodation business'));
const wa = logic2bContact(locale, route.startsWith('docs') ? 'docs' : 'commercial');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${PRODUCT.url}/#organization`,
    name: 'Logic2B',
    url: 'https://logic2b.com',
    email: PRODUCT.email,
    telephone: wa.phone,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${PRODUCT.url}/#website`,
    url: PRODUCT.url,
    name: PRODUCT.publicName,
    inLanguage: ['es', 'en'],
    publisher: { '@id': `${PRODUCT.url}/#organization` },
  },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {translated && <link rel="alternate" hreflang="es" href={alternateEs} />}
    {translated && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {translated && <link rel="alternate" hreflang="x-default" href={alternateEs} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sourceSerifFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/poppins-800-logo.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" type={preloadImageType} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT.publicName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:locale:alternate" content={alternateSocialLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>
      const runtimeManifestTimeoutMs = 4_000;
      const safeRuntimeCapabilities = Object.freeze({ schemaVersion: '1.0.0', manifestAvailable: false, mode: 'demo', demoMode: true, commercialLeadsEnabled: false, sideEffects: false, durableWrites: false, jobs: false, providers: { analytics: 'disabled', email: 'disabled', payments: 'disabled', webhooks: 'disabled', externalStorage: 'disabled' }, operations: { commercialLead: 'blocked', payments: 'unavailable', webhooks: 'unavailable', automations: 'unavailable' } });
      const normalizeRuntimeCapabilities = (candidate) => {
        if (!candidate || candidate.schemaVersion !== '1.0.0' || !['demo', 'real_locked', 'real'].includes(candidate.mode) || candidate.jobs !== false) return safeRuntimeCapabilities;
        const emailLive = candidate.commercialLeadsEnabled === true && candidate.durableWrites === true && candidate.providers?.email === 'live' && candidate.operations?.commercialLead === 'active';
        const analyticsLive = candidate.mode === 'real' && candidate.demoMode === false && candidate.providers?.analytics === 'live';
        if (candidate.demoMode !== (candidate.mode === 'demo') || (!emailLive && !analyticsLive && candidate.sideEffects !== false)) return safeRuntimeCapabilities;
        return {
          ...safeRuntimeCapabilities,
          manifestAvailable: true,
          mode: candidate.mode, demoMode: candidate.demoMode === true, commercialLeadsEnabled: emailLive, sideEffects: emailLive || analyticsLive,
          durableWrites: emailLive,
          providers: {
            ...safeRuntimeCapabilities.providers,
            analytics: analyticsLive ? 'live' : 'disabled',
            email: emailLive ? 'live' : 'disabled',
          },
          operations: {
            ...safeRuntimeCapabilities.operations,
            commercialLead: emailLive ? 'active' : 'blocked',
          },
        };
      };
      window.estanciaRuntimeReady = (async () => {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), runtimeManifestTimeoutMs);
        try {
          const response = await fetch('/api/capabilities', { method: 'GET', headers: { accept: 'application/json' }, credentials: 'same-origin', signal: controller.signal });
          if (!response.ok) return safeRuntimeCapabilities;
          return normalizeRuntimeCapabilities(await response.json());
        } catch {
          return safeRuntimeCapabilities;
        } finally {
          clearTimeout(timeout);
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="topbar shell">
        <BrandLockup locale={locale} />
        <nav aria-label={locale === 'es' ? 'Principal' : 'Main'}>
          {productNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="top-actions">
          {translated && <a class="locale" href={localeHref}>{locale === 'es' ? 'EN' : 'ES'}</a>}
          <a class="pill" href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`} data-track="cta_click" data-section="header">{c.nav.contact}</a>
        </div>
        <button class="menu" type="button" aria-expanded="false" aria-controls="mobile-nav">{locale === 'es' ? 'Menú' : 'Menu'}</button>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label={locale === 'es' ? 'Principal móvil' : 'Mobile main'} hidden>
        {productNav.map((item) => <a href={item.href}>{item.label}</a>)}
        {businessNav.map((business) => <a class="mobile-nav-secondary" href={business.href}>{business.label}</a>)}
        <a class="mobile-nav-contact" href={`${prefix}/#contacto`} data-contact-trigger aria-haspopup="dialog">{locale === 'es' ? 'Contactar' : 'Contact us'} <span aria-hidden="true">→</span></a>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="footer shell">
      <BrandLockup locale={locale} />
      <div>{productNav.map((item) => <a href={item.href}>{item.label}</a>)}{businessNav.map((business) => <a href={business.href}>{business.label}</a>)}<a href={`${prefix}/docs/`}>{c.nav.docs}</a><a href={`${prefix}/legal/`}>Legal</a><a href={`${prefix}/privacidad/`}>{locale === 'es' ? 'Privacidad' : 'Privacy'}</a><a href={`${prefix}/cookies/`}>Cookies</a></div>
      <p>© 2026 Logic2B · Castelló</p>
    </footer>
    <a class="whatsapp" href={wa.href} target="_blank" rel="noopener noreferrer" aria-label={locale === 'es' ? 'Contacta con Logic2B por WhatsApp' : 'Contact Logic2B on WhatsApp'} title={`${locale === 'es' ? 'Contacta con Logic2B por WhatsApp' : 'Contact Logic2B on WhatsApp'} · ${wa.phone}`} data-whatsapp data-visible="false" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
      <span>{wa.label}</span>
    </a>
    <CookieBanner locale={locale} />
    <script is:inline define:vars={{ consentKey: CONSENT.key, legacyConsentKey: CONSENT.legacyKey, consentVersion: CONSENT.version, gtmContainerId: analyticsContract.containerId, allowedAnalyticsEvents: analyticsContract.surfaces.site, allowedAnalyticsParameters: analyticsContract.parameters, allowedAnalyticsParameterValues: analyticsContract.parameterValues, analyticsEventShapes: analyticsContract.eventShapes, analyticsSafePaths: ANALYTICS_SAFE_PATHS }}>
      const menu = document.querySelector('.menu');
      const mobile = document.querySelector('#mobile-nav');
      function setMobileMenu(open, moveFocus = false) {
        if (!(menu instanceof HTMLButtonElement) || !(mobile instanceof HTMLElement)) return;
        menu.setAttribute('aria-expanded', String(open));
        mobile.hidden = !open;
        const focusTarget = open ? mobile.querySelector('a') : menu;
        if (moveFocus && focusTarget instanceof HTMLElement) focusTarget.focus();
      }
      menu?.addEventListener('click', () => setMobileMenu(menu.getAttribute('aria-expanded') !== 'true', true));
      mobile?.addEventListener('click', (event) => { if (event.target instanceof HTMLAnchorElement) setMobileMenu(false); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') setMobileMenu(false, true); });
      const contactSection = document.querySelector('#contacto');
      const contactOrigin = document.querySelector('[data-contact-origin]');
      const contactDialog = document.querySelector('[data-contact-dialog]');
      const contactSlot = contactDialog?.querySelector('[data-contact-dialog-slot]');
      const contactClose = contactDialog?.querySelector('[data-contact-dialog-close]');
      let contactReturnTarget = null;
      function openContactDialog(trigger) {
        if (!(contactDialog instanceof HTMLDialogElement) || !(contactSlot instanceof HTMLElement) || !(contactSection instanceof HTMLElement) || typeof contactDialog.showModal !== 'function') return false;
        contactReturnTarget = mobile?.contains(trigger) && menu instanceof HTMLElement ? menu : trigger;
        if (!contactDialog.open) {
          contactSlot.append(contactSection);
          contactSection.classList.add('contact-in-dialog');
          document.body.classList.add('contact-dialog-open');
          contactDialog.showModal();
        }
        requestAnimationFrame(() => contactSection.querySelector('[data-contact-dialog-title]')?.focus());
        return true;
      }
      document.addEventListener('click', (event) => {
        const trigger = event.target.closest?.('[data-contact-trigger], a[href="#contacto"]');
        if (!(trigger instanceof HTMLAnchorElement) || !openContactDialog(trigger)) return;
        event.preventDefault();
        setMobileMenu(false);
      });
      contactClose?.addEventListener('click', () => { if (contactDialog instanceof HTMLDialogElement) contactDialog.close(); });
      contactDialog?.addEventListener('click', (event) => { if (event.target === contactDialog) contactDialog.close(); });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !(contactDialog instanceof HTMLDialogElement) || !contactDialog.open) return;
        event.preventDefault();
        contactDialog.close();
      });
      contactDialog?.addEventListener('close', () => {
        if (contactOrigin instanceof HTMLElement && contactSection instanceof HTMLElement) {
          contactOrigin.append(contactSection);
          contactSection.classList.remove('contact-in-dialog');
        }
        document.body.classList.remove('contact-dialog-open');
        if (contactReturnTarget instanceof HTMLElement && contactReturnTarget.isConnected) contactReturnTarget.focus();
        else contactSection?.querySelector('[data-contact-dialog-title]')?.focus();
        contactReturnTarget = null;
      });
      if (location.hash === '#contacto') openContactDialog(null);
      const consent = document.querySelector('[data-consent-banner]');
      function hasAnalyticsConsent() {
        try {
          const raw = localStorage.getItem(consentKey);
          const stored = raw ? JSON.parse(raw) : null;
          if (stored?.version === consentVersion && stored?.essential === true && typeof stored?.analytics === 'boolean') return stored.analytics;
          return localStorage.getItem(legacyConsentKey) === 'analytics';
        } catch { return false; }
      }
      function isAnalyticsSafeLocation() {
        if (!analyticsSafePaths.includes(location.pathname)) return false;
        const entries = [...new URLSearchParams(location.search).entries()];
        if (new Set(entries.map(([key]) => key)).size !== entries.length) return false;
        const values = Object.fromEntries(entries);
        const landing = location.pathname === '/' || location.pathname === '/en/';
        const assessment = location.pathname === '/diagnostico/' || location.pathname === '/en/assessment/';
        if (landing) {
          const allowedKeys = new Set(['assessment', 'contact']);
          if (entries.some(([key]) => !allowedKeys.has(key))) return false;
          if ('assessment' in values && values.assessment !== '1') return false;
          if ('contact' in values && !['rural', 'apartments', 'hotels'].includes(values.contact)) return false;
          if ('assessment' in values && 'contact' in values) return false;
          return ['', '#contacto', '#negocio', '#producto', '#demos', '#niveles', '#planes', '#webs', '#gestor', '#recorrido', '#conexiones', '#alcance'].includes(location.hash);
        }
        if (assessment) {
          const allowedKeys = new Set(['segment', 'plan', 'properties', 'units', 'demo']);
          if (entries.some(([key]) => !allowedKeys.has(key)) || location.hash) return false;
          if ('segment' in values && !['rural', 'apartments', 'hotels', 'managers'].includes(values.segment)) return false;
          if ('plan' in values && !['basico', 'gestion', 'inteligente'].includes(values.plan)) return false;
          if ('demo' in values && !['nivora', 'terrava', 'aurem'].includes(values.demo)) return false;
          for (const [key, maximum] of [['properties', 10_000], ['units', 100_000]]) {
            if (!(key in values)) continue;
            const numeric = Number(values[key]);
            if (!Number.isInteger(numeric) || numeric < 1 || numeric > maximum || String(numeric) !== values[key]) return false;
          }
          return true;
        }
        return entries.length === 0 && location.hash === '';
      }
      function loadGtm() {
        window.estanciaRuntimeReady.then((runtime) => {
          if (!hasAnalyticsConsent() || !isAnalyticsSafeLocation() || runtime.providers.analytics !== 'live' || document.querySelector('script[data-gtm]')) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          const script = document.createElement('script'); script.dataset.gtm = 'true'; script.async = true; script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmContainerId)}`; document.head.append(script);
        });
      }
      window.estanciaLoadGtm = loadGtm;
      if (hasAnalyticsConsent()) loadGtm();
      const allowedEvents = new Set(allowedAnalyticsEvents);
      window.estanciaTrack = (event, parameters = {}) => {
        if (!hasAnalyticsConsent() || !isAnalyticsSafeLocation() || !allowedEvents.has(event)) return;
        const safe = Object.fromEntries(Object.entries(parameters).filter(([key, value]) => {
          if (!allowedAnalyticsParameters.includes(key)) return false;
          if (key === 'step_index') return typeof value === 'number' && Number.isInteger(value) && value >= 1 && value <= 20;
          const allowed = allowedAnalyticsParameterValues[key];
          return typeof value === 'string' && Array.isArray(allowed) && allowed.includes(value);
        }));
        const shape = analyticsEventShapes[event];
        if (shape) {
          const keys = Object.keys(safe);
          if (shape.required.some((key) => !(key in safe)) || keys.some((key) => !shape.allowed.includes(key))) return;
          if (Object.entries(shape.values).some(([key, allowed]) => key in safe && !allowed.includes(safe[key]))) return;
        }
        window.estanciaRuntimeReady.then((runtime) => {
          if (!hasAnalyticsConsent() || !isAnalyticsSafeLocation() || runtime.providers.analytics !== 'live') return;
          window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event, ...safe });
        });
      };
      document.addEventListener('click', (event) => { const target = event.target.closest?.('[data-track]'); if (!target) return; window.estanciaTrack?.(target.dataset.track, { locale: document.documentElement.lang, plan: target.dataset.plan, segment: target.dataset.segment, source_section: target.dataset.section }); });
      const wa = document.querySelector('[data-whatsapp]');
      const footer = document.querySelector('footer');
      const commercialActions = document.querySelectorAll('.portfolio-card-links, .web-concept-next');
      const visibleCommercialActions = new Set();
      let footerVisible = false; let contactVisible = false;
      const toggleWa = () => {
        if (!(wa instanceof HTMLAnchorElement)) return;
        const visible = window.scrollY >= 280 && consent?.hasAttribute('hidden') && !footerVisible && !contactVisible && visibleCommercialActions.size === 0;
        wa.dataset.visible = String(visible);
        wa.tabIndex = visible ? 0 : -1;
      };
      if ('IntersectionObserver' in window) {
        const obstructionObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.target === footer) footerVisible = entry.isIntersecting;
            if (entry.target === contactSection) contactVisible = entry.isIntersecting;
            if (entry.target instanceof HTMLElement && entry.target.matches('.portfolio-card-links, .web-concept-next')) {
              if (entry.isIntersecting) visibleCommercialActions.add(entry.target);
              else visibleCommercialActions.delete(entry.target);
            }
          });
          toggleWa();
        });
        obstructionObserver.observe(footer);
        if (contactSection) obstructionObserver.observe(contactSection);
        commercialActions.forEach((actions) => obstructionObserver.observe(actions));
      }
      addEventListener('scroll', toggleWa, { passive: true });
      addEventListener('estancia:consent-visibility', toggleWa);
      toggleWa();
    </script>
  </body>
</html>
