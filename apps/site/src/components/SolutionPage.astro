---
import type { Locale } from '@logic-estancia/config';
import { CAPABILITIES, type PlanLevel } from '@logic-estancia/domain';
import {
  capabilityEvidenceHref,
  capabilityEvidenceLabel,
  capabilityStatusDetail,
  capabilityStatusLabel,
} from '../capability-evidence';
import { getBusiness, type BusinessSegment } from '../businesses';
import { guideContextForSolution } from '../guide-context';
import { getSpanishResourceForSegment } from '../resources';
import CommercialEvidence from './CommercialEvidence.astro';
import BusinessWorkflow from './BusinessWorkflow.astro';
import ContextualGuides from './ContextualGuides.astro';
import HumanService from './HumanService.astro';

const { locale, segment } = Astro.props as { locale: Locale; segment: BusinessSegment };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const business = getBusiness(segment, locale);
const relatedResource = en ? undefined : getSpanishResourceForSegment(segment);

const spanishCopy = {
  rural: {
    eyebrow: 'Para casas rurales y alojamientos con identidad propia',
    title: 'Tu casa rural, de la web a la consulta con contexto.',
    body: 'Presenta lo que hace especial tu casa y comprueba cómo revisar una consulta antes de responder. Empieza por web o gestión según tus necesidades, con implantación acompañada y alcance acordado.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'guest-context', 'website-editor', 'basic-reports'],
    demoTitle: 'Terrava Collection',
    demoCopy: 'Ocho casas, una consulta y una alternativa que conserva su contexto.',
    journey: 'Consulta y alternativa de muestra. La demo no confirma reservas ni prepara estancias reales.',
    faq: [['¿Necesito un motor de reservas para empezar?', 'No necesariamente. Si hoy necesitas explicar mejor la estancia y recibir consultas directas, Básico puede ser suficiente. Un motor o una gestión conectada solo se plantean cuando el alcance real lo justifica.'], ['¿Puedo mantener los portales que ya utilizo?', 'Sí. El proyecto no presupone que debas abandonar un canal que funciona. Revisamos qué papel conserva cada plataforma y qué relación quieres recuperar bajo tu propia marca.'], ['¿Sirve para una sola casa rural?', 'Sí. El tamaño ayuda a dimensionar la implantación, pero el plan se decide por capacidades. Una casa puede empezar con web y consultas; una colección puede necesitar planning y gestión.']],
  },
  apartments: {
    eyebrow: 'Para apartamentos turísticos y pequeños gestores',
    title: 'Más apartamentos. Menos tareas dispersas.',
    body: 'Construye una marca propia y organiza consultas, reservas y huéspedes sin multiplicar herramientas.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'guest-context', 'website-editor', 'basic-reports'],
    demoTitle: 'Nivora One',
    demoCopy: 'Una web propia para un apartamento con identidad.',
    journey: 'Descubrimiento → historia de marca → conversación comercial → evolución a Gestión.',
    faq: [['¿Puedo empezar con un solo apartamento?', 'Sí. Básico parte de una presencia de marca y SEO sin dashboard. Si después necesitas coordinar reservas o más unidades, el alcance puede evolucionar.'], ['¿Logic2B Estancias publica disponibilidad en portales de reservas?', 'No por defecto. Cualquier conexión con un proveedor requiere validación técnica y comercial específica.'], ['¿El número de apartamentos decide el plan?', 'No. El volumen dimensiona implantación y soporte; las capacidades deciden entre Básico, Gestión e Inteligente.']],
  },
  hotels: {
    eyebrow: 'Para hoteles y equipos operativos',
    title: 'Tu hotel, preparado para cada llegada.',
    body: 'Prioriza llegadas, habitaciones e incidencias con el mismo contexto para todo el equipo.',
    capabilityIds: ['operations-centre', 'cleaning', 'maintenance', 'roles', 'channels', 'automation', 'explainable-revenue', 'revenue'],
    demoTitle: 'Aurem Hotel',
    demoCopy: 'Una llegada en riesgo conecta recepción, limpieza y dirección.',
    journey: 'Riesgo de llegada → coordinación → decisión supervisada → seguimiento.',
    faq: [['¿Sustituye a nuestro PMS?', 'No de forma automática. Primero se identifica qué sistema conserva la fuente de verdad y qué integración sería necesaria.'], ['¿La IA toma decisiones o envía mensajes?', 'El enfoque es supervisado: la revisión y aprobación quedan en manos de tu equipo. Definimos contigo las tareas y el alcance del copiloto. En esta demo solo se revisa un borrador ficticio: no hay IA conectada ni se envían mensajes.'], ['¿Puede usarse solo para una parte de la operación?', 'Sí. El alcance debe empezar por el cuello de botella que tenga impacto y pueda validarse, sin obligar a sustituir de golpe las herramientas que ya funcionan.']],
  },
} as const;

const englishCopy = {
  rural: {
    eyebrow: 'For rural stays with an identity of their own',
    title: 'Your rural stay, from website to an enquiry with context.',
    body: 'Show what makes your stay special and explore how to review an enquiry before replying. Start with a website or management according to your needs, with guided implementation and an agreed scope.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'guest-context', 'website-editor', 'basic-reports'],
    demoTitle: 'Terrava Collection', demoCopy: 'Eight homes, one enquiry and an alternative that keeps its context.',
    journey: 'Sample enquiry and alternative. The demo confirms no booking and prepares no real stay.',
    faq: [['Do I need a booking engine to start?', 'Not necessarily. If you need to explain the stay better and receive direct enquiries, Basic may be enough. A booking engine or connected management is considered only when the real scope justifies it.'], ['Can I keep the platforms I already use?', 'Yes. The project does not assume you should abandon a channel that works. We review the role of each platform and the relationship you want to regain under your brand.'], ['Does it work for one rural stay?', 'Yes. Size helps scope implementation, while capabilities determine the plan. One stay may start with a website and enquiries; a collection may need planning and management.']],
  },
  apartments: {
    eyebrow: 'For holiday apartments and small managers',
    title: 'More apartments. Fewer scattered tasks.',
    body: 'Build an owned brand and organise enquiries, bookings and guests without multiplying tools.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'guest-context', 'website-editor', 'basic-reports'],
    demoTitle: 'Nivora One', demoCopy: 'An owned website for an apartment with its own identity.',
    journey: 'Discovery → brand story → commercial conversation → evolution to Management.',
    faq: [['Can I start with one apartment?', 'Yes. Basic starts with a brand website and SEO without a workspace. If you later need to coordinate bookings or more units, the scope can evolve.'], ['Does Logic2B Estancias publish availability to booking portals?', 'Not by default. Every provider connection requires specific technical and commercial validation.'], ['Does apartment count determine the plan?', 'No. Volume sizes implementation and support; capabilities determine Basic, Management or Intelligent.']],
  },
  hotels: {
    eyebrow: 'For hotels and operations teams',
    title: 'Your hotel, ready for every arrival.',
    body: 'Prioritise arrivals, rooms and incidents with the same context for the whole team.',
    capabilityIds: ['operations-centre', 'cleaning', 'maintenance', 'roles', 'channels', 'automation', 'explainable-revenue', 'revenue'],
    demoTitle: 'Aurem Hotel', demoCopy: 'One at-risk arrival connects reception, housekeeping and management.',
    journey: 'At-risk arrival → coordination → supervised decision → follow-up.',
    faq: [['Does it replace our PMS?', 'Not automatically. We first identify which system keeps the source of truth and which integration would be required.'], ['Does AI make decisions or send messages?', 'The approach is supervised: review and approval stay with your team. Together we define the copilot’s tasks and scope. This demo only reviews a fictional draft: no AI provider is connected and no messages are sent.'], ['Can we use it for only one part of operations?', 'Yes. Scope should begin with a bottleneck that has impact and can be validated, without forcing you to replace tools that already work.']],
  },
} as const;

const copy = (en ? englishCopy : spanishCopy)[segment];
const ruralSource = en ? '/en/solutions/rural-stays/' : '/soluciones/casas-rurales/';
const ruralAssessment = `${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=rural&sourcePath=${encodeURIComponent(ruralSource)}`;
const ruralTour = `${prefix}/${en ? 'journey' : 'recorrido'}/?step=enquiries&segment=rural&sourcePath=${encodeURIComponent(ruralSource)}`;
const planNames: Record<PlanLevel, string> = en ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' } : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
const visible = CAPABILITIES.filter(({ id }) => (copy.capabilityIds as readonly string[]).includes(id));
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: copy.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<section class="solution-hero" data-solution-view data-locale={locale} data-segment={segment}>
  <div class="shell solution-hero-layout">
    <div><p class="eyebrow">{copy.eyebrow}</p><h1 class="display">{copy.title}</h1><p>{copy.body}</p><div class="hero-actions"><a class="pill" href={segment === 'rural' ? ruralAssessment : `${prefix}/?contact=${segment}#contacto`} data-contact-trigger={segment !== 'rural' || undefined} data-track="cta_click" data-segment={segment} data-section="solution_hero">{segment === 'rural' ? (en ? 'Assess what my stay needs' : 'Evaluar qué necesita mi casa') : (en ? 'Request a conversation' : 'Pedir una conversación')}</a><a class="pill ghost" href={segment === 'rural' ? ruralTour : `${prefix}/demos/${business.demo}/`}>{segment === 'rural' ? (en ? 'Inspect a sample enquiry' : 'Revisar una solicitud de muestra') : (en ? 'Explore the design' : 'Explorar el diseño')}</a></div>{segment === 'rural' && <p class="hero-note">{en ? 'Assessment: an on-screen plan recommendation, without contact details. Demo: fictional data, no live bookings or messages.' : 'Evaluación: una recomendación de plan en pantalla, sin datos de contacto. Demo: datos ficticios, sin reservas ni mensajes reales.'}</p>}{segment === 'rural' && <a class="text-link" href={`${prefix}/?contact=rural#contacto`} data-contact-trigger>{en ? 'Request a conversation' : 'Pedir una conversación'} <span aria-hidden="true">→</span></a>}</div>
    <a class="solution-hero-media" href={`${prefix}/demos/${business.demo}/`} aria-label={en ? `Explore the fictional ${copy.demoTitle} case` : `Explorar el diseño ${copy.demoTitle}`}><picture><source type="image/avif" srcset={`${business.image.replace('.webp', '')}-640.avif 640w, ${business.image.replace('.webp', '')}-960.avif 960w`} sizes="(max-width: 900px) 100vw, 45vw" /><img src={business.image} alt="" width="2016" height="1344" /></picture><span><small>{en ? 'Website and style' : 'Web y estilo'}</small><strong>{copy.demoTitle}</strong></span><b aria-hidden="true">↗</b></a>
  </div>
</section>

{segment === 'rural' && <section class="section shell" aria-label={en ? 'Two questions to assess your project' : 'Dos preguntas para evaluar tu proyecto'}><CommercialEvidence locale={locale} sourcePath={ruralSource} rural /></section>}

<BusinessWorkflow locale={locale} segment={segment} />

<HumanService locale={locale} ctaHref={segment === 'rural' ? ruralAssessment : `${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} />


<section class="section capability-section">
  <div class="shell">
    <div class="section-head compact-head">
      <p class="eyebrow">{en ? 'Verifiable status' : 'Estado verificable'}</p>
      <h2 class="heading">{en ? 'Explore the features for your accommodation.' : 'Explora las funciones para tu alojamiento.'}</h2>
      <p>{en ? '“Visible in the demo” never means “active in production”. Every capability keeps its evidence, status and boundary in view.' : '«Visible en la demo» nunca significa «activo en producción». Cada capacidad mantiene a la vista su evidencia, estado y límite.'}</p>
    </div>
    <details class="commercial-disclosure" data-solution-capabilities><summary>{en ? 'View features and demo availability' : 'Ver funciones y disponibilidad en la demo'}</summary>
    <div class="capability-grid" data-commercial-actions>
      {visible.map((capability) => {
        const evidenceHref = capabilityEvidenceHref(capability, locale);
        return (
          <article class="card" data-capability={capability.id} data-capability-status={capability.status}>
            <div class="capability-meta">
              <span>{en ? 'From' : 'Desde'} {planNames[capability.minimumPlan]}</span>
              <span class={`capability-status ${capability.status}`}>{capabilityStatusLabel(capability.status, locale)}</span>
            </div>
            <h3>{capability.label[locale]}</h3>
            <p>{capability.description[locale]}</p>
            <p class="capability-status-detail">{capabilityStatusDetail(capability.status, locale)}</p>
            <div class="capability-proof">
              <p><b>{en ? 'What is evidenced' : 'Qué se evidencia'}:</b> {capability.evidence.proof[locale]}</p>
              <p class="capability-boundary"><b>{en ? 'Boundary' : 'Límite'}:</b> {capability.evidence.boundary[locale]}</p>
            </div>
            {evidenceHref ? (
              <a class="capability-link" href={evidenceHref} data-capability-evidence={capability.id}>
                {capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="capability-no-evidence" data-capability-evidence-unavailable={capability.id}>
                {capabilityEvidenceLabel(capability, locale)}
              </span>
            )}
          </article>
        );
      })}
    </div>
    </details>
  </div>
</section>

<ContextualGuides locale={locale} contextId={guideContextForSolution(segment)} />

{relatedResource && (
  <aside class="related-resource shell" aria-labelledby={`related-resource-${segment}`} data-related-resource={segment}>
    <div>
      <p class="eyebrow">{relatedResource.eyebrow}</p>
      <h2 id={`related-resource-${segment}`}>{relatedResource.related.title}</h2>
      <p>{relatedResource.related.body}</p>
    </div>
    <a class="text-link" href={relatedResource.href} data-resource-link={relatedResource.slug}>
      {relatedResource.related.cta} <span aria-hidden="true">→</span>
    </a>
  </aside>
)}

<section class="section proof-band"><div class="shell commercial-columns"><div class="section-head"><p class="eyebrow">{en ? 'Website and style' : 'Web y estilo'}</p><h2 class="heading">{copy.demoTitle}</h2><p>{copy.demoCopy}</p></div><div class="solution-proof card" data-demo-proof={business.demo}><strong data-demo-plan={business.plan}>{planNames[business.plan]}</strong><p>{copy.journey}</p><a class="pill" href={`${prefix}/demos/${business.demo}/`}>{en ? 'Explore the design' : 'Explorar el diseño'} →</a></div></div></section>

<section class="section shell faq"><div class="section-head"><p class="eyebrow">{en ? `Questions from ${business.plural.toLowerCase()}` : `Preguntas de ${business.plural.toLowerCase()}`}</p><h2 class="heading">{en ? 'Resolve the boundary before changing tools.' : 'Aclara el alcance antes de cambiar herramientas.'}</h2></div><div class="faq-list">{copy.faq.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="section shell final-cta"><p class="eyebrow">{en ? 'A recommendation before a proposal' : 'Una recomendación antes que una propuesta'}</p><h2 class="heading">{en ? `See where ${business.plural.toLowerCase()} should start.` : `Descubre por dónde debería empezar tu ${segment === 'rural' ? 'casa rural' : segment === 'apartments' ? 'negocio de apartamentos' : 'hotel'}.`}</h2><p>{en ? 'The assessment uses capabilities; size only helps scope implementation.' : 'El diagnóstico utiliza capacidades; el tamaño solo ayuda a dimensionar la implantación.'}</p><a class="pill" href={segment === 'rural' ? ruralAssessment : `${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_footer">{en ? 'Start the assessment' : 'Empezar diagnóstico'} →</a></section>

<script>
  import { getConsent } from '../scripts/analytics-consent';

  const solutionView = document.querySelector<HTMLElement>('[data-solution-view]');
  const allowedLocales = new Set(['es', 'en']);
  const allowedSegments = new Set(['rural', 'apartments', 'hotels']);
  let solutionViewEmitted = false;

  async function emitSolutionView(): Promise<void> {
    if (solutionViewEmitted || !solutionView) return;

    const runtime = await window.estanciaRuntimeReady;
    if (solutionViewEmitted || runtime?.providers.analytics !== 'live' || !getConsent()?.analytics || !window.estanciaTrack) return;

    const { locale, segment } = solutionView.dataset;
    if (!locale || !segment || !allowedLocales.has(locale) || !allowedSegments.has(segment)) return;

    solutionViewEmitted = true;
    window.estanciaTrack('solution_view', { locale, segment, source_section: 'solution' });
  }

  window.addEventListener('estancia:consent-updated', () => { void emitSolutionView(); });
  if (document.readyState === 'loading') window.addEventListener('DOMContentLoaded', () => { void emitSolutionView(); }, { once: true });
  else void emitSolutionView();
</script>
