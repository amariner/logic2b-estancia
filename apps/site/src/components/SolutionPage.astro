---
import { CAPABILITIES } from '@logic-estancia/domain';
import type { Locale } from '@logic-estancia/config';
import { capabilityEvidenceHref, capabilityEvidenceLabel } from '../capability-evidence';
const { locale, segment } = Astro.props as { locale: Locale; segment: 'managers' | 'hotels' };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const copy = segment === 'managers' ? {
  eyebrow: en ? 'For managers and rural stays' : 'Para gestores y alojamientos rurales',
  title: en ? 'Grow your portfolio without making every new stay another layer of work.' : 'Haz crecer tu cartera sin que cada nueva estancia añada otra capa de trabajo.',
  body: en ? 'Win more direct conversations under your own brand and give every enquiry continuity across availability, bookings and guests—without erasing what makes each property different.' : 'Gana más conversaciones directas bajo tu propia marca y da continuidad a cada consulta entre disponibilidad, reservas y huéspedes, sin borrar lo que hace distinta a cada propiedad.',
  problems: en ? ['A guest finds you on a platform but cannot recognise your brand', 'Answering “is it available?” means opening several calendars', 'Growing the portfolio multiplies repeated tasks and scattered context'] : ['El huésped te descubre en una plataforma, pero no reconoce tu marca', 'Responder “¿está disponible?” obliga a abrir varios calendarios', 'Crecer multiplica tareas repetidas y contexto disperso'],
  demo: 'terrava', plan: 'gestion', brand: 'Terrava Collection',
} : {
  eyebrow: en ? 'For hotels and operations teams' : 'Para hoteles y equipos operativos',
  title: en ? 'Get ahead of the shift before the guest notices what went wrong.' : 'Anticípate al turno antes de que el huésped note lo que ha fallado.',
  body: en ? 'Bring arrival risks, room readiness, incidents and owners into one daily view so the team knows what deserves attention before urgency takes over.' : 'Reúne riesgos de llegada, habitaciones, incidencias y responsables en una vista diaria para que el equipo sepa qué merece atención antes de que mande la urgencia.',
  problems: en ? ['Arrival risks appear when the guest is already at reception', 'Each department reaches the shift with a different version of the day', 'A decision is made, but its owner and context disappear'] : ['Los riesgos aparecen cuando el huésped ya está en recepción', 'Cada departamento llega al turno con una versión distinta del día', 'Se toma una decisión, pero se pierden su responsable y su contexto'],
  demo: 'aurem', plan: 'inteligente', brand: 'Aurem Hotel',
};
const visible = CAPABILITIES.filter(({ minimumPlan }) => segment === 'managers' ? minimumPlan !== 'inteligente' : minimumPlan !== 'basico');
const maturity = en ? { demo: 'Demo', simulated: 'Simulated', 'to-validate': 'To validate', future: 'Future' } : { demo: 'Demo', simulated: 'Simulada', 'to-validate': 'A validar', future: 'Futura' };
const planNames = en ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' } : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
---
<section class="commercial-hero shell">
  <p class="eyebrow">{copy.eyebrow}</p><h1 class="display">{copy.title}</h1><p>{copy.body}</p>
  <div class="hero-actions"><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_hero">{en ? 'Find my starting point' : 'Ver mi punto de partida'}</a><a class="pill ghost" href={`${prefix}/demos/${copy.demo}/`}>{en ? `See the ${copy.brand} case` : `Ver el caso ${copy.brand}`}</a></div>
</section>
<section class="section soft"><div class="shell commercial-columns"><div><p class="eyebrow">{en ? 'Where margin and time disappear' : 'Dónde se escapan margen y tiempo'}</p><h2 class="heading">{en ? 'The problem lives in the handoffs.' : 'El problema vive en los saltos entre tareas.'}</h2></div><ol class="problem-list">{copy.problems.map((problem, index) => <li><span>0{index + 1}</span><p>{problem}</p></li>)}</ol></div></section>
<section class="section shell"><div class="section-head"><p class="eyebrow">{en ? 'A path you can verify' : 'Un camino que puedes comprobar'}</p><h2 class="heading">{en ? 'Start at the bottleneck. Add only what earns its place.' : 'Empieza por el cuello de botella. Añade solo lo que se gane su sitio.'}</h2><p>{en ? 'Every capability shows its minimum plan, what the fictional demo proves and what a real implementation would still need to validate.' : 'Cada capacidad muestra su plan mínimo, lo que prueba la demo ficticia y lo que una implantación real todavía tendría que validar.'}</p></div><div class="capability-grid">{visible.map((capability) => <article class="card" data-capability={capability.id}><div class="capability-meta"><span>{en ? 'From' : 'Desde'} {planNames[capability.minimumPlan]}</span><span class={`maturity ${capability.maturity}`}>{maturity[capability.maturity]}</span></div><h3>{capability.label[locale]}</h3><p class="capability-description">{capability.description[locale]}</p><div class="capability-proof"><strong>{en ? 'What you can verify' : 'Qué puedes comprobar'}</strong><p>{capability.evidence.proof[locale]}</p><p class="capability-boundary"><b>{en ? 'Boundary' : 'Límite'}:</b> {capability.evidence.boundary[locale]}</p><a href={capabilityEvidenceHref(capability, locale)} data-capability-evidence={capability.id}>{capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span></a></div></article>)}</div></section>
<section class="section proof-band"><div class="shell commercial-columns"><div><p class="eyebrow">{en ? 'See the work before the meeting' : 'Comprueba el trabajo antes de la reunión'}</p><h2 class="heading">{copy.brand}</h2><p>{en ? 'Choose the guided journey or explore freely. Every data point and action is fictional, stays in your browser and carries its boundary with it.' : 'Elige la visita guiada o explora libremente. Cada dato y acción es ficticio, permanece en tu navegador y muestra su límite.'}</p></div><div class="solution-proof card"><strong>{copy.plan === 'gestion' ? (en ? 'Management' : 'Gestión') : (en ? 'Intelligent' : 'Inteligente')}</strong><p>{segment === 'managers' ? (en ? 'Enquiry → alternative → booking → stay operation.' : 'Solicitud → alternativa → reserva → operación de estancia.') : (en ? 'At-risk arrival → team coordination → supervised resolution.' : 'Llegada en riesgo → coordinación → resolución supervisada.')}</p><a class="pill" href={`${prefix}/demos/${copy.demo}/`}>{en ? 'Open the fictional case' : 'Abrir el caso ficticio'} →</a></div></div></section>
<section class="section shell final-cta"><p class="eyebrow">{en ? 'A useful next step' : 'Un siguiente paso útil'}</p><h2 class="heading">{en ? 'See which starting point fits the way you operate today.' : 'Descubre qué punto de partida encaja con tu forma de operar hoy.'}</h2><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_footer">{en ? 'Get my recommendation' : 'Obtener mi recomendación'} →</a></section>
<script is:inline define:vars={{ locale, segment }}>
  addEventListener('DOMContentLoaded', () => {
    window.estanciaTrack?.('solution_view', { locale, segment, source_section: 'solution' });
  }, { once: true });
</script>
