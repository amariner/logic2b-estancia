---
import { CAPABILITIES } from '@logic-estancia/domain';
import type { Locale } from '@logic-estancia/config';
import { capabilityEvidenceHref, capabilityEvidenceLabel } from '../capability-evidence';
const { locale, segment } = Astro.props as { locale: Locale; segment: 'managers' | 'hotels' };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const copy = segment === 'managers' ? {
  eyebrow: en ? 'For managers and rural stays' : 'Para gestores y alojamientos rurales',
  title: en ? 'One brand for every stay. One view for the entire portfolio.' : 'Una marca para cada estancia. Una visión para todo el portfolio.',
  body: en ? 'Connect a distinctive website with enquiries, bookings, guests and planning without turning each property into an isolated spreadsheet.' : 'Conecta una web con carácter con solicitudes, reservas, huéspedes y planning sin convertir cada propiedad en una hoja aislada.',
  problems: en ? ['Enquiries arrive through disconnected channels', 'Availability is checked manually', 'Every property repeats the same work'] : ['Las solicitudes llegan por canales desconectados', 'La disponibilidad se comprueba a mano', 'Cada propiedad repite el mismo trabajo'],
  demo: 'terrava', plan: 'gestion', brand: 'Terrava Collection',
} : {
  eyebrow: en ? 'For hotels and operations teams' : 'Para hoteles y equipos operativos',
  title: en ? 'A calm guest experience starts with a coordinated operation.' : 'Una experiencia tranquila empieza con una operación coordinada.',
  body: en ? 'Bring arrivals, room readiness, incidents, teams and supervised decisions into one daily operations centre.' : 'Reúne llegadas, preparación, incidencias, equipos y decisiones supervisadas dentro de un centro operativo diario.',
  problems: en ? ['Arrival risks surface too late', 'Departments work with different information', 'Decisions lack owner and context'] : ['Los riesgos de llegada aparecen demasiado tarde', 'Cada departamento trabaja con información distinta', 'Las decisiones no tienen responsable ni contexto'],
  demo: 'aurem', plan: 'inteligente', brand: 'Aurem Hotel',
};
const visible = CAPABILITIES.filter(({ minimumPlan }) => segment === 'managers' ? minimumPlan !== 'inteligente' : minimumPlan !== 'basico');
const maturity = en ? { demo: 'Demo', simulated: 'Simulated', 'to-validate': 'To validate', future: 'Future' } : { demo: 'Demo', simulated: 'Simulada', 'to-validate': 'A validar', future: 'Futura' };
const planNames = en ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' } : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
---
<section class="commercial-hero shell">
  <p class="eyebrow">{copy.eyebrow}</p><h1 class="display">{copy.title}</h1><p>{copy.body}</p>
  <div class="hero-actions"><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_hero">{en ? 'Discover your setup' : 'Descubre tu configuración'}</a><a class="pill ghost" href={`${prefix}/demos/${copy.demo}/`}>{en ? `Explore ${copy.brand}` : `Explorar ${copy.brand}`}</a></div>
</section>
<section class="section soft"><div class="shell commercial-columns"><div><p class="eyebrow">{en ? 'Where value is lost' : 'Dónde se pierde valor'}</p><h2 class="heading">{en ? 'Less friction between selling and operating.' : 'Menos fricción entre vender y operar.'}</h2></div><ol class="problem-list">{copy.problems.map((problem, index) => <li><span>0{index + 1}</span><p>{problem}</p></li>)}</ol></div></section>
<section class="section shell"><div class="section-head"><p class="eyebrow">{en ? 'Capability map' : 'Mapa de capacidades'}</p><h2 class="heading">{en ? 'A modular path, with visible boundaries.' : 'Una evolución modular, con límites visibles.'}</h2><p>{en ? 'Every capability shows its minimum plan, what the demo proves and what still needs validating for a real project.' : 'Cada capacidad muestra su plan mínimo, lo que demuestra la demo y lo que todavía debe validarse para un proyecto real.'}</p></div><div class="capability-grid">{visible.map((capability) => <article class="card" data-capability={capability.id}><div class="capability-meta"><span>{en ? 'From' : 'Desde'} {planNames[capability.minimumPlan]}</span><span class={`maturity ${capability.maturity}`}>{maturity[capability.maturity]}</span></div><h3>{capability.label[locale]}</h3><p class="capability-description">{capability.description[locale]}</p><div class="capability-proof"><strong>{en ? 'What you can verify' : 'Qué puedes comprobar'}</strong><p>{capability.evidence.proof[locale]}</p><p class="capability-boundary"><b>{en ? 'Boundary' : 'Límite'}:</b> {capability.evidence.boundary[locale]}</p><a href={capabilityEvidenceHref(capability, locale)} data-capability-evidence={capability.id}>{capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span></a></div></article>)}</div></section>
<section class="section proof-band"><div class="shell commercial-columns"><div><p class="eyebrow">{en ? 'Evidence before promises' : 'Evidencia antes que promesas'}</p><h2 class="heading">{copy.brand}</h2><p>{en ? 'Choose a short guided journey or explore freely. All data and actions are fictitious and remain in your browser.' : 'Elige una visita guiada o explora libremente. Todos los datos y acciones son ficticios y permanecen en tu navegador.'}</p></div><div class="solution-proof card"><strong>{copy.plan === 'gestion' ? (en ? 'Management' : 'Gestión') : (en ? 'Intelligent' : 'Inteligente')}</strong><p>{segment === 'managers' ? (en ? 'Enquiry → alternative → booking → stay operation.' : 'Solicitud → alternativa → reserva → operación de estancia.') : (en ? 'At-risk arrival → team coordination → supervised resolution.' : 'Llegada en riesgo → coordinación → resolución supervisada.')}</p><a class="pill" href={`${prefix}/demos/${copy.demo}/`}>{en ? 'Open the demo' : 'Abrir la demo'} →</a></div></div></section>
<section class="section shell final-cta"><p class="eyebrow">{en ? 'One business day response' : 'Respuesta en un día laborable'}</p><h2 class="heading">{en ? 'See which configuration fits your operation.' : 'Descubre qué configuración encaja con tu operación.'}</h2><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_footer">{en ? 'Start the assessment' : 'Empezar diagnóstico'} →</a></section>
<script is:inline define:vars={{ locale, segment }}>
  addEventListener('DOMContentLoaded', () => {
    window.estanciaTrack?.('solution_view', { locale, segment, source_section: 'solution' });
  }, { once: true });
</script>
