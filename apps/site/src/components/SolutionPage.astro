---
import type { Locale } from '@logic-estancia/config';
import { CAPABILITIES, type PlanLevel } from '@logic-estancia/domain';
import {
  capabilityEvidenceHref,
  capabilityEvidenceLabel,
  capabilityStatusDetail,
  capabilityStatusLabel,
} from '../capability-evidence';
import { getBusiness, type BusinessSegment } from '../businesses';
import { getSpanishResourceForSegment } from '../resources';
import BusinessWorkflow from './BusinessWorkflow.astro';
import HumanService from './HumanService.astro';

const { locale, segment } = Astro.props as { locale: Locale; segment: BusinessSegment };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const business = getBusiness(segment, locale);
const relatedResource = en ? undefined : getSpanishResourceForSegment(segment);

const spanishCopy = {
  rural: {
    eyebrow: 'Para casas rurales y alojamientos con identidad propia',
    title: 'Haz que elijan tu casa por lo que se vive allí. No solo por la fecha y el precio.',
    body: 'Convierte lo que hace especial tu casa en consultas directas y una gestión que conserva el trato cercano.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'website-editor', 'basic-reports'],
    demoTitle: 'Terrava Collection',
    demoCopy: 'Ocho casas, una consulta y una alternativa que conserva su contexto.',
    journey: 'Consulta → alternativa → reserva → preparación de la estancia.',
    faq: [['¿Necesito un motor de reservas para empezar?', 'No necesariamente. Si hoy necesitas explicar mejor la estancia y recibir consultas directas, Básico puede ser suficiente. Un motor o una gestión conectada solo se plantean cuando el alcance real lo justifica.'], ['¿Puedo mantener los portales que ya utilizo?', 'Sí. El proyecto no presupone que debas abandonar un canal que funciona. Revisamos qué papel conserva cada plataforma y qué relación quieres recuperar bajo tu propia marca.'], ['¿Sirve para una sola casa rural?', 'Sí. El tamaño ayuda a dimensionar la implantación, pero el plan se decide por capacidades. Una casa puede empezar con web y consultas; una colección puede necesitar planning y gestión.']],
  },
  apartments: {
    eyebrow: 'Para apartamentos turísticos y pequeños gestores',
    title: 'Haz crecer tus apartamentos sin multiplicar calendarios, mensajes y tareas.',
    body: 'Construye una marca propia y organiza consultas, reservas y huéspedes sin multiplicar herramientas.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'website-editor', 'basic-reports'],
    demoTitle: 'Nivora One',
    demoCopy: 'Una web propia para un apartamento ficticio.',
    journey: 'Descubrimiento → historia de marca → conversación comercial → evolución a Gestión.',
    faq: [['¿Puedo empezar con un solo apartamento?', 'Sí. Básico parte de una presencia de marca y SEO sin dashboard. Si necesitas solicitudes por email, se valida en el alcance comercial; si después coordinas reservas o más unidades, el alcance puede evolucionar.'], ['¿Logic2B Estancias publica disponibilidad en Airbnb o Booking?', 'No por defecto. Cualquier conexión con canales requiere validación técnica y comercial específica. Las demos no publican inventario, precios ni mensajes reales.'], ['¿El número de apartamentos decide el plan?', 'No. El volumen dimensiona implantación y soporte; las capacidades deciden entre Básico, Gestión e Inteligente.']],
  },
  hotels: {
    eyebrow: 'Para hoteles y equipos operativos',
    title: 'Que cada turno empiece con prioridades claras. No con la primera urgencia.',
    body: 'Prioriza llegadas, habitaciones e incidencias con el mismo contexto para todo el equipo.',
    capabilityIds: ['operations-centre', 'cleaning', 'maintenance', 'roles', 'channels', 'automation', 'revenue'],
    demoTitle: 'Aurem Hotel',
    demoCopy: 'Una llegada en riesgo conecta recepción, limpieza y dirección.',
    journey: 'Riesgo de llegada → coordinación → decisión supervisada → seguimiento.',
    faq: [['¿Sustituye a nuestro PMS?', 'No de forma automática. Primero se identifica qué sistema conserva la fuente de verdad y qué integración sería necesaria. La demo no está conectada a ningún PMS.'], ['¿La IA toma decisiones o envía mensajes?', 'No. La demo pública no expone borradores de IA. No hay modelo, proveedor o mensajería conectados; esa capacidad sigue pendiente de una representación validada.'], ['¿Puede usarse solo para una parte de la operación?', 'Sí. El alcance debe empezar por el cuello de botella que tenga impacto y pueda validarse, sin obligar a sustituir de golpe las herramientas que ya funcionan.']],
  },
} as const;

const englishCopy = {
  rural: {
    eyebrow: 'For rural stays with an identity of their own',
    title: 'Be chosen for what guests experience there. Not only for the date and price.',
    body: 'Turn what makes your stay special into direct enquiries and management that keeps the personal touch.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'website-editor', 'basic-reports'],
    demoTitle: 'Terrava Collection', demoCopy: 'Eight homes, one enquiry and an alternative that keeps its context.',
    journey: 'Enquiry → alternative → booking → stay preparation.',
    faq: [['Do I need a booking engine to start?', 'Not necessarily. If you need to explain the stay better and receive direct enquiries, Basic may be enough. A booking engine or connected management is considered only when the real scope justifies it.'], ['Can I keep the platforms I already use?', 'Yes. The project does not assume you should abandon a channel that works. We review the role of each platform and the relationship you want to regain under your brand.'], ['Does it work for one rural stay?', 'Yes. Size helps scope implementation, while capabilities determine the plan. One stay may start with a website and enquiries; a collection may need planning and management.']],
  },
  apartments: {
    eyebrow: 'For holiday apartments and small managers',
    title: 'Grow your apartments without multiplying calendars, messages and tasks.',
    body: 'Build an owned brand and organise enquiries, bookings and guests without multiplying tools.',
    capabilityIds: ['brand-web', 'email-enquiries', 'enquiry-workspace', 'planning', 'website-editor', 'basic-reports'],
    demoTitle: 'Nivora One', demoCopy: 'An owned website for one fictional apartment.',
    journey: 'Discovery → brand story → commercial conversation → evolution to Management.',
    faq: [['Can I start with one apartment?', 'Yes. Basic starts with a brand website and SEO without a workspace. Email enquiries are validated in the commercial scope; if you later coordinate bookings or more units, the scope can evolve.'], ['Does Logic2B Estancias publish availability to Airbnb or Booking?', 'Not by default. Every channel connection requires specific technical and commercial validation. The demos publish no live inventory, rates or messages.'], ['Does apartment count determine the plan?', 'No. Volume sizes implementation and support; capabilities determine Basic, Management or Intelligent.']],
  },
  hotels: {
    eyebrow: 'For hotels and operations teams',
    title: 'Start every shift with clear priorities. Not with the first emergency.',
    body: 'Prioritise arrivals, rooms and incidents with the same context for the whole team.',
    capabilityIds: ['operations-centre', 'cleaning', 'maintenance', 'roles', 'channels', 'automation', 'revenue'],
    demoTitle: 'Aurem Hotel', demoCopy: 'One at-risk arrival connects reception, housekeeping and management.',
    journey: 'At-risk arrival → coordination → supervised decision → follow-up.',
    faq: [['Does it replace our PMS?', 'Not automatically. We first identify which system keeps the source of truth and which integration would be required. The demo is not connected to a PMS.'], ['Does AI make decisions or send messages?', 'No. The public demo exposes no AI drafts. No model, provider or messaging service is connected; the capability remains pending a validated representation.'], ['Can we use it for only one part of operations?', 'Yes. Scope should begin with a bottleneck that has impact and can be validated, without forcing you to replace tools that already work.']],
  },
} as const;

const copy = (en ? englishCopy : spanishCopy)[segment];
const visible = CAPABILITIES.filter(({ id }) => (copy.capabilityIds as readonly string[]).includes(id));
const planNames: Record<PlanLevel, string> = en ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' } : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: copy.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<section class="solution-hero">
  <div class="shell solution-hero-layout">
    <div><p class="eyebrow">{copy.eyebrow}</p><h1 class="display">{copy.title}</h1><p>{copy.body}</p><div class="hero-actions"><a class="pill" href={`${prefix}/?contact=${segment}#contacto`} data-contact-trigger data-track="cta_click" data-segment={segment} data-section="solution_hero">{en ? 'Request a conversation' : 'Pedir una conversación'}</a><a class="pill ghost" href={`${prefix}/demos/${business.demo}/`}>{en ? 'Explore the fictional case' : 'Explorar el caso ficticio'}</a></div></div>
    <a class="solution-hero-media" href={`${prefix}/demos/${business.demo}/`} aria-label={en ? `Explore the fictional ${copy.demoTitle} case` : `Explorar el caso ficticio ${copy.demoTitle}`}><picture><source type="image/avif" srcset={`/media/${business.demo}/hero-640.avif 640w, /media/${business.demo}/hero-960.avif 960w`} sizes="(max-width: 900px) 100vw, 45vw" /><img src={business.image} alt="" width="2016" height="1344" /></picture><span><small>{en ? 'Fictional visual case' : 'Caso visual ficticio'}</small><strong>{copy.demoTitle}</strong></span><b aria-hidden="true">↗</b></a>
  </div>
</section>

<BusinessWorkflow locale={locale} segment={segment} />

<HumanService locale={locale} ctaHref={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} />

<section class="section capability-section">
  <div class="shell">
    <div class="section-head compact-head">
      <p class="eyebrow">{en ? 'Verifiable status' : 'Estado verificable'}</p>
      <h2 class="heading">{en ? 'See what is visible today and what still requires activation.' : 'Comprueba qué puedes ver hoy y qué requiere activación.'}</h2>
      <p>{en ? '“Visible in the demo” never means “active in production”. Every capability keeps its evidence, status and boundary in view.' : '«Visible en la demo» nunca significa «activo en producción». Cada capacidad mantiene a la vista su evidencia, estado y límite.'}</p>
    </div>
    <div class="capability-grid">
      {visible.map((capability) => {
        const evidenceHref = capabilityEvidenceHref(capability, locale);
        return (
          <article class="card" data-capability={capability.id} data-capability-status={capability.status}>
            <div class="capability-meta">
              <span>{en ? 'From' : 'Desde'} {planNames[capability.minimumPlan]}</span>
              <span class={`capability-status ${capability.status}`}>{capabilityStatusLabel(capability.status, locale)}</span>
            </div>
            <h3>{capability.label[locale]}</h3>
            <p>{capability.description[locale]}</p>
            <p class="capability-status-detail">{capabilityStatusDetail(capability.status, locale)}</p>
            <div class="capability-proof">
              <p><b>{en ? 'What is evidenced' : 'Qué se evidencia'}:</b> {capability.evidence.proof[locale]}</p>
              <p class="capability-boundary"><b>{en ? 'Boundary' : 'Límite'}:</b> {capability.evidence.boundary[locale]}</p>
            </div>
            {evidenceHref ? (
              <a class="capability-link" href={evidenceHref} data-capability-evidence={capability.id}>
                {capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="capability-no-evidence" data-capability-evidence-unavailable={capability.id}>
                {capabilityEvidenceLabel(capability, locale)}
              </span>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

{relatedResource && (
  <aside class="related-resource shell" aria-labelledby={`related-resource-${segment}`} data-related-resource={segment}>
    <div>
      <p class="eyebrow">{relatedResource.eyebrow}</p>
      <h2 id={`related-resource-${segment}`}>{relatedResource.related.title}</h2>
      <p>{relatedResource.related.body}</p>
    </div>
    <a class="text-link" href={relatedResource.href} data-resource-link={relatedResource.slug}>
      {relatedResource.related.cta} <span aria-hidden="true">→</span>
    </a>
  </aside>
)}

<section class="section proof-band"><div class="shell commercial-columns"><div class="section-head"><p class="eyebrow">{en ? 'Fictional visual case' : 'Caso visual ficticio'}</p><h2 class="heading">{copy.demoTitle}</h2><p>{copy.demoCopy}</p></div><div class="solution-proof card" data-demo-proof={business.demo}><strong data-demo-plan={business.plan}>{planNames[business.plan]}</strong><p>{copy.journey}</p><small>{en ? 'Local demo · no external actions' : 'Demo local · sin acciones externas'}</small><a class="pill" href={`${prefix}/demos/${business.demo}/`}>{en ? 'Explore the fictional case' : 'Explorar el caso ficticio'} →</a></div></div></section>

<section class="section shell faq"><div class="section-head"><p class="eyebrow">{en ? `Questions from ${business.plural.toLowerCase()}` : `Preguntas de ${business.plural.toLowerCase()}`}</p><h2 class="heading">{en ? 'Resolve the boundary before changing tools.' : 'Aclara el alcance antes de cambiar herramientas.'}</h2></div><div class="faq-list">{copy.faq.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="section shell final-cta"><p class="eyebrow">{en ? 'A recommendation before a proposal' : 'Una recomendación antes que una propuesta'}</p><h2 class="heading">{en ? `See where ${business.plural.toLowerCase()} should start.` : `Descubre por dónde debería empezar tu ${segment === 'rural' ? 'casa rural' : segment === 'apartments' ? 'negocio de apartamentos' : 'hotel'}.`}</h2><p>{en ? 'The assessment uses capabilities; size only helps scope implementation.' : 'El diagnóstico utiliza capacidades; el tamaño solo ayuda a dimensionar la implantación.'}</p><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?segment=${segment}`} data-track="cta_click" data-segment={segment} data-section="solution_footer">{en ? 'Start the assessment' : 'Empezar diagnóstico'} →</a></section>
