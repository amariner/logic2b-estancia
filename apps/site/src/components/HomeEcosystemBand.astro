---
import type { Locale } from '@logic-estancia/config';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const sectors = en ? [['Rural stays', '/solutions/rural-stays/'], ['Holiday apartments', '/solutions/apartments/'], ['Hotels', '/solutions/hotels/']] : [['Casas rurales', '/soluciones/casas-rurales/'], ['Apartamentos turísticos', '/soluciones/apartamentos/'], ['Hoteles', '/soluciones/hoteles/']];
---
<section class="home-ecosystem-band" aria-label={en ? 'Designed for your accommodation' : 'Pensado para tu alojamiento'} data-home-ecosystem>
  <div class="shell sector-band"><p>{en ? 'Different ways to host. One way to work better.' : 'Distintas formas de alojar. Una forma de trabajar mejor.'}</p><nav aria-label={en ? 'Accommodation types' : 'Tipos de alojamiento'}>{sectors.map(([label, href]) => <a href={`${prefix}${href}`}>{label}<span aria-hidden="true">↗</span></a>)}</nav></div>
</section>
