---
import { CAPABILITIES, hasLevel, type PlanLevel } from '@logic-estancia/domain';
import type { Locale } from '@logic-estancia/config';
import {
  capabilityEvidenceHref,
  capabilityEvidenceLabel,
  capabilityPlanStatusLabel,
  capabilityStatusDetail,
  capabilityStatusLabel,
} from '../capability-evidence';
import { getPlanCards } from '../plan-contract';
import HumanService from './HumanService.astro';
import ContextualGuides from './ContextualGuides.astro';
import PlanCard from './PlanCard.astro';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en'; const prefix = en ? '/en' : '';
const plans = getPlanCards(locale);
const planNames = Object.fromEntries(plans.map(({ id, name }) => [id, name])) as Record<PlanLevel, string>;
const sourcePath = en ? '/en/plans/' : '/planes/';
---
<section class="commercial-hero shell"><p class="eyebrow">{en ? 'Three starting points · one path forward' : 'Tres puntos de partida · un camino para avanzar'}</p><h1 class="display">{en ? 'Pay for the problem you need to solve. Not for the suite you might need one day.' : 'Paga por el problema que necesitas resolver. No por la suite que quizá uses algún día.'}</h1><p>{en ? 'Every plan combines personalised implementation, configuration by the Logic2B team and a subscription. Basic improves attraction, Management gives bookings continuity and Intelligent helps teams anticipate operations.' : 'Cada plan combina implantación personalizada, configuración por el equipo de Logic2B y una suscripción. Básico mejora la captación, Gestión da continuidad a las reservas e Inteligente ayuda a anticipar la operación.'}</p><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-track="cta_click" data-section="plans_hero">{en ? 'Find my starting point' : 'Ver mi punto de partida'} →</a></section>
<section class="section shell"><div class="plans-grid" data-plan-showcase>{plans.map((plan, index) => <PlanCard locale={locale} plan={plan} sourcePath={sourcePath} featured={index === 1} />)}</div><p class="pricing-note">{en ? 'All plans include hosting, technical maintenance, security and base support. Domain, migrations, integrations, advanced branding and extended support are scoped separately.' : 'Todos incluyen hosting, mantenimiento técnico, seguridad y soporte base. Dominio, migraciones, integraciones, branding avanzado y soporte extendido se presupuestan aparte.'}</p></section>
<HumanService locale={locale} ctaHref={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} />
<ContextualGuides locale={locale} contextId="plans" />
<section class="section soft">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">{en ? 'Compare with status and boundaries visible' : 'Compara con estado y límites a la vista'}</p>
      <h2 class="heading">{en ? 'Separate what the demo shows from what a live project must activate.' : 'Separa lo que muestra la demo de lo que debe activar un proyecto real.'}</h2>
      <p>{en ? 'The plan indicates a possible starting point. Status states what can be evidenced today; every live capability still requires an agreed scope and validation.' : 'El plan indica un posible punto de partida. El estado dice qué puede evidenciarse hoy; toda capacidad real exige alcance acordado y validación.'}</p>
    </div>
    <p class="table-scroll-hint">{en ? 'Swipe to view evidence, plan fit, status and boundaries.' : 'Desliza para ver evidencia, encaje por plan, estado y límites.'}</p>
    <div class="capability-table" role="table">
      <div class="capability-row header" role="row">
        <span role="columnheader">{en ? 'Capability' : 'Capacidad'}</span>
        <span role="columnheader">{en ? 'Evidence and boundary' : 'Evidencia y límite'}</span>
        {plans.map((plan) => <span role="columnheader">{plan.name}</span>)}
        <span role="columnheader">{en ? 'Current status' : 'Estado actual'}</span>
      </div>
      {CAPABILITIES.map((capability) => {
        const evidenceHref = capabilityEvidenceHref(capability, locale);
        return (
          <div class="capability-row" role="row" data-capability={capability.id} data-capability-status={capability.status}>
            <span role="cell">
              <strong>{capability.label[locale]}</strong>
              <small>{capability.description[locale]}</small>
              <small class="minimum-plan">{en ? 'Starting plan' : 'Plan de partida'}: {planNames[capability.minimumPlan]}</small>
            </span>
            <span role="cell" class="capability-table-evidence">
              {evidenceHref ? (
                <a href={evidenceHref} data-capability-evidence={capability.id}>
                  {capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span>
                </a>
              ) : (
                <strong class="capability-no-evidence" data-capability-evidence-unavailable={capability.id}>
                  {capabilityEvidenceLabel(capability, locale)}
                </strong>
              )}
              <small><b>{en ? 'Evidence' : 'Evidencia'}:</b> {capability.evidence.proof[locale]}</small>
              <small class="capability-boundary"><b>{en ? 'Boundary' : 'Límite'}:</b> {capability.evidence.boundary[locale]}</small>
            </span>
            {plans.map((plan) => {
              const fitsPlan = hasLevel(plan.id, capability.minimumPlan);
              const statusLabel = fitsPlan ? capabilityPlanStatusLabel(capability.status, locale) : '—';
              const ariaLabel = fitsPlan
                ? `${plan.name}: ${capabilityStatusLabel(capability.status, locale)}`
                : `${plan.name}: ${en ? 'not a starting-plan capability' : 'no corresponde a este plan de partida'}`;
              return <span role="cell" class="capability-plan-cell" aria-label={ariaLabel}>{statusLabel}</span>;
            })}
            <span role="cell" class="capability-status-cell">
              <i class={`capability-status ${capability.status}`}>{capabilityStatusLabel(capability.status, locale)}</i>
              <small>{capabilityStatusDetail(capability.status, locale)}</small>
            </span>
          </div>
        );
      })}
    </div>
  </div>
</section>
<section class="section shell extras"><div class="section-head"><p class="eyebrow">{en ? 'Scoped additions' : 'Extras con alcance'}</p><h2 class="heading">{en ? 'The core stays clear. Exceptional work stays visible.' : 'El núcleo se mantiene claro. Lo excepcional se presupuesta.'}</h2></div><ul>{(en ? ['Advanced brand identity', 'Content or data migration', 'External integrations', 'Extended training and support', 'Campaigns and new sections'] : ['Identidad de marca avanzada', 'Migración de contenido o datos', 'Integraciones externas', 'Formación y soporte extendidos', 'Campañas y nuevas secciones']).map((item) => <li>{item}</li>)}</ul></section>
<section class="section shell final-cta"><p class="eyebrow">{en ? 'No gated result' : 'Resultado sin bloqueo'}</p><h2 class="heading">{en ? 'Answer six steps and see your recommendation.' : 'Responde seis pasos y consulta tu recomendación.'}</h2><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`}>{en ? 'Start assessment' : 'Empezar diagnóstico'} →</a></section>
