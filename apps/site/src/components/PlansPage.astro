---
import { CAPABILITIES, hasLevel, type PlanLevel } from '@logic-estancia/domain';
import type { Locale } from '@logic-estancia/config';
import { capabilityEvidenceHref, capabilityEvidenceLabel } from '../capability-evidence';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en'; const prefix = en ? '/en' : '';
const plans: { id: PlanLevel; name: string; summary: string; excludes: string; service: string }[] = en ? [
  { id: 'basico', name: 'Basic', summary: 'Brand website, SEO foundations, hosting, maintenance and email enquiries.', excludes: 'No workspace, live inventory, booking or payment.', service: 'Managed website and base support.' },
  { id: 'gestion', name: 'Management', summary: 'Enquiries, bookings, planning, guests, rates, basic reports and website editor.', excludes: 'No advanced operations, teams, channels or AI.', service: 'Setup and initial training included.' },
  { id: 'inteligente', name: 'Intelligent', summary: 'Operations centre, cleaning, teams, maintenance, automation, supervised AI and advanced metrics.', excludes: 'No autonomous action or unscoped integrations.', service: 'Periodic operations review included.' },
] : [
  { id: 'basico', name: 'Básico', summary: 'Web de marca, SEO inicial, hosting, mantenimiento y solicitudes por email.', excludes: 'Sin dashboard, inventario, reserva o cobro real.', service: 'Web gestionada y soporte base.' },
  { id: 'gestion', name: 'Gestión', summary: 'Solicitudes, reservas, planning, huéspedes, tarifas, informes básicos y editor web.', excludes: 'Sin operaciones avanzadas, equipos, canales o IA.', service: 'Configuración y formación inicial incluidas.' },
  { id: 'inteligente', name: 'Inteligente', summary: 'Centro operativo, limpieza, equipos, mantenimiento, automatización, IA supervisada y métricas.', excludes: 'Sin autonomía ni integraciones no presupuestadas.', service: 'Revisión operativa periódica incluida.' },
];
const maturity = en ? { demo: 'Demo', simulated: 'Simulated', 'to-validate': 'To validate', future: 'Future' } : { demo: 'Demo', simulated: 'Simulada', 'to-validate': 'A validar', future: 'Futura' };
const planNames = Object.fromEntries(plans.map(({ id, name }) => [id, name])) as Record<PlanLevel, string>;
---
<section class="commercial-hero shell"><p class="eyebrow">{en ? 'Three clear plans' : 'Tres planes claros'}</p><h1 class="display">{en ? 'Start where you are. Evolve when the operation asks for it.' : 'Empieza donde estás. Evoluciona cuando la operación lo pida.'}</h1><p>{en ? 'Every plan combines an implementation fee and a monthly subscription. Public price ranges will only appear after commercial validation.' : 'Todos combinan una implantación inicial y una suscripción mensual. Los rangos públicos solo aparecerán tras validarlos comercialmente.'}</p><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-track="cta_click" data-section="plans_hero">{en ? 'Discover my plan' : 'Descubrir mi plan'} →</a></section>
<section class="section shell"><div class="plans-grid">{plans.map((plan, index) => <article class={`plan-card card ${index === 1 ? 'featured' : ''}`}><span class="plan-number">0{index}</span><h2>{plan.name}</h2><p>{plan.summary}</p><div><strong>{en ? 'Service' : 'Servicio'}</strong><p>{plan.service}</p></div><div><strong>{en ? 'Boundary' : 'Límite'}</strong><p>{plan.excludes}</p></div><p class="price-status">{en ? 'Scope after assessment' : 'Presupuesto tras diagnóstico'}</p><a href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/?plan=${plan.id}`} data-track="plan_select" data-plan={plan.id} data-section="plans_grid">{en ? 'Assess this plan' : 'Evaluar este plan'} →</a></article>)}</div><p class="pricing-note">{en ? 'All plans include hosting, technical maintenance, security and base support. Domain, migrations, integrations, advanced branding and extended support are scoped separately.' : 'Todos incluyen hosting, mantenimiento técnico, seguridad y soporte base. Dominio, migraciones, integraciones, branding avanzado y soporte extendido se presupuestan aparte.'}</p></section>
<section class="section soft"><div class="shell"><div class="section-head"><p class="eyebrow">{en ? 'Complete comparison' : 'Comparación completa'}</p><h2 class="heading">{en ? 'Capabilities, maturity and evidence, without fine print.' : 'Capacidades, madurez y evidencia, sin letra pequeña.'}</h2><p>{en ? 'Open the exact fictitious flow behind every capability and check its boundary before assessing your setup.' : 'Abre el flujo ficticio exacto de cada capacidad y comprueba su límite antes de evaluar tu configuración.'}</p></div><p class="table-scroll-hint">{en ? 'Swipe to view evidence, plan coverage and maturity.' : 'Desliza para ver evidencia, cobertura por plan y madurez.'}</p><div class="capability-table" role="table"><div class="capability-row header" role="row"><span role="columnheader">{en ? 'Capability' : 'Capacidad'}</span><span role="columnheader">{en ? 'Evidence and boundary' : 'Evidencia y límite'}</span>{plans.map((plan) => <span role="columnheader">{plan.name}</span>)}<span role="columnheader">{en ? 'Maturity' : 'Madurez'}</span></div>{CAPABILITIES.map((capability) => <div class="capability-row" role="row" data-capability={capability.id}><span role="cell"><strong>{capability.label[locale]}</strong><small>{capability.description[locale]}</small><small class="minimum-plan">{en ? 'Minimum plan' : 'Plan mínimo'}: {planNames[capability.minimumPlan]}</small></span><span role="cell" class="capability-table-evidence"><a href={capabilityEvidenceHref(capability, locale)} data-capability-evidence={capability.id}>{capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span></a><small>{capability.evidence.boundary[locale]}</small></span>{plans.map((plan) => <span role="cell" aria-label={`${plan.name}: ${hasLevel(plan.id, capability.minimumPlan) ? (en ? 'included' : 'incluida') : (en ? 'not included' : 'no incluida')}`}>{hasLevel(plan.id, capability.minimumPlan) ? '✓' : '—'}</span>)}<span role="cell"><i class={`maturity ${capability.maturity}`}>{maturity[capability.maturity]}</i></span></div>)}</div></div></section>
<section class="section shell extras"><div class="section-head"><p class="eyebrow">{en ? 'Scoped additions' : 'Extras con alcance'}</p><h2 class="heading">{en ? 'The core stays clear. Exceptional work stays visible.' : 'El núcleo se mantiene claro. Lo excepcional se presupuesta.'}</h2></div><ul>{(en ? ['Advanced brand identity', 'Content or data migration', 'External integrations', 'Extended training and support', 'Campaigns and new sections'] : ['Identidad de marca avanzada', 'Migración de contenido o datos', 'Integraciones externas', 'Formación y soporte extendidos', 'Campañas y nuevas secciones']).map((item) => <li>{item}</li>)}</ul></section>
<section class="section shell final-cta"><p class="eyebrow">{en ? 'No gated result' : 'Resultado sin bloqueo'}</p><h2 class="heading">{en ? 'Answer six steps and see your recommendation.' : 'Responde seis pasos y consulta tu recomendación.'}</h2><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`}>{en ? 'Start assessment' : 'Empezar diagnóstico'} →</a></section>
