---
import type { Locale } from '@logic-estancia/config';
import { getPanelPortfolio, getPublishedPanels } from '../panel-portfolio';
import PanelPreview from './PanelPreview.astro';
import ContextualGuides from './ContextualGuides.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const panels = getPanelPortfolio(locale);
const publishedCount = getPublishedPanels(locale).length;
const filters = en ? {
  search: 'Search', placeholder: 'Panel, decision or responsibility', plan: 'Starting plan', all: 'All', management: 'Management', intelligent: 'Intelligent',
  result: `Showing ${publishedCount} verified workspaces`, visible: 'verified workspaces shown', empty: 'No workspace matches this search and filter combination.',
} : {
  search: 'Buscar', placeholder: 'Panel, decisión o responsabilidad', plan: 'Plan de partida', all: 'Todos', management: 'Gestión', intelligent: 'Inteligente',
  result: `Mostrando ${publishedCount} paneles verificados`, visible: 'paneles verificados visibles', empty: 'Ningún panel coincide con la búsqueda y el filtro.',
};
---

<div data-panel-portfolio>
  <section class="panel-portfolio-hero section">
    <div class="shell panel-portfolio-hero-grid">
      <div>
        <p class="eyebrow">{en ? 'Workspace portfolio' : 'Portfolio de paneles'}</p>
        <h1 class="display">{en ? 'See the decision before you see the software.' : 'Mira la decisión antes que el software.'}</h1>
      </div>
      <div>
        <p>{en ? 'Six management surfaces organise the commercial evidence for Management and Intelligent. Only pages with complete content and an exact local demo count as navigable.' : 'Seis superficies de gestión ordenan la evidencia comercial de Gestión e Inteligente. Solo cuentan como navegables las fichas con contenido completo y una demo local exacta.'}</p>
        <dl><div><dt>{en ? 'Verified now' : 'Verificadas ahora'}</dt><dd>{publishedCount}/6</dd></div><div><dt>{en ? 'External actions' : 'Acciones externas'}</dt><dd>{en ? 'None' : 'Ninguna'}</dd></div></dl>
      </div>
    </div>
  </section>

  <section class="section panel-portfolio-catalog" aria-labelledby="panel-catalog-title">
    <div class="shell">
      <div class="panel-portfolio-heading">
        <div><p class="eyebrow">{en ? 'Evidence by responsibility' : 'Evidencia por responsabilidad'}</p><h2 id="panel-catalog-title" class="heading">{en ? 'Start with the surfaces that can already be checked.' : 'Empieza por las superficies que ya se pueden comprobar.'}</h2></div>
        <p>{en ? 'All six pages now open exact local evidence: three Management surfaces in Terrava and three Intelligent surfaces in Aurem. Their boundaries distinguish what is visible from what remains pending or on the roadmap.' : 'Las seis fichas ya abren evidencia local exacta: tres superficies de Gestión en Terrava y tres de Inteligente en Aurem. Sus límites distinguen lo visible de lo pendiente o en ruta.'}</p>
      </div>
      <div class="portfolio-filters panel-portfolio-filters" aria-label={en ? 'Filter workspace pages' : 'Filtrar fichas de panel'}>
        <fieldset class="portfolio-search"><legend>{filters.search}</legend><label class="sr-only" for="panel-portfolio-search">{filters.placeholder}</label><input id="panel-portfolio-search" type="search" placeholder={filters.placeholder} autocomplete="off" data-panel-search /></fieldset>
        <fieldset><legend>{filters.plan}</legend><div class="portfolio-filter-list">
          {[
            ['all', filters.all],
            ['gestion', filters.management],
            ['inteligente', filters.intelligent],
          ].map(([value, label], index) => <button type="button" class={index === 0 ? 'is-active' : ''} aria-pressed={index === 0 ? 'true' : 'false'} data-panel-plan-filter={value}>{label}</button>)}
        </div></fieldset>
      </div>
      <p class="portfolio-filter-status" data-panel-filter-status aria-live="polite">{filters.result}</p>
      <div class="panel-portfolio-grid">
        {panels.map((panel) => (
          <article class:list={['panel-portfolio-card', { 'is-published': panel.status === 'published' }]} data-panel-card={panel.id} data-panel-status={panel.status} data-panel-plan={panel.plan}>
            <header><span>{panel.number}</span><small>{panel.statusLabel}</small></header>
            <div class="panel-portfolio-card-title"><div><p>{panel.planLabel}</p><h2>{panel.title}</h2></div><span aria-hidden="true">{panel.status === 'published' ? '↗' : '·'}</span></div>
            <p>{panel.summary}</p>
            {panel.preview ? <PanelPreview locale={locale} kind={panel.preview} compact /> : <div class="panel-preview-pending" aria-hidden="true"><i></i><i></i><i></i><span>{en ? 'Page structure in preparation' : 'Estructura de ficha en preparación'}</span></div>}
            <div class="panel-portfolio-card-foot">
              <p><strong>{en ? 'Decision it supports' : 'Decisión que acompaña'}</strong>{panel.decision}</p>
              {panel.detailHref ? <a class="text-link" href={panel.detailHref} data-panel-open={panel.id}>{en ? `Explore ${panel.title}` : `Explorar ${panel.title}`} <span aria-hidden="true">→</span></a> : <span>{en ? 'Not counted as navigable yet' : 'Todavía no cuenta como navegable'}</span>}
            </div>
          </article>
        ))}
      </div>
      <p class="portfolio-filter-empty" data-panel-filter-empty hidden>{filters.empty}</p>
    </div>
  </section>

  <ContextualGuides locale={locale} contextId="panels" />

  <section class="section shell panel-index-cta" data-commercial-actions>
    <div><p class="eyebrow">{en ? 'Choose by capability' : 'Elige por capacidad'}</p><h2 class="heading">{en ? 'The plan follows the problem you need to solve.' : 'El plan sigue el problema que necesitas resolver.'}</h2><p>{en ? 'Management begins with continuity for enquiries and planning. Intelligent adds operating coordination only when the required capabilities justify it.' : 'Gestión empieza con continuidad para solicitudes y planning. Inteligente añade coordinación operativa solo cuando las capacidades necesarias lo justifican.'}</p></div>
    <a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-track="cta_click" data-section="panel_portfolio">{en ? 'Find my starting point' : 'Ver mi punto de partida'} <span aria-hidden="true">→</span></a>
  </section>
</div>

<script is:inline define:vars={{ locale, result: filters.result, visibleLabel: filters.visible }}>
  const panelPortfolio = document.querySelector('[data-panel-portfolio]');
  const panelCards = panelPortfolio ? [...panelPortfolio.querySelectorAll('[data-panel-card]')] : [];
  const panelStatus = panelPortfolio?.querySelector('[data-panel-filter-status]');
  const panelEmpty = panelPortfolio?.querySelector('[data-panel-filter-empty]');
  let panelPlan = 'all';
  let panelSearch = '';
  const refreshPanels = () => {
    let visible = 0;
    panelCards.forEach((card) => {
      const searchable = (card.textContent ?? '').toLocaleLowerCase(locale);
      const matches = (panelPlan === 'all' || card.dataset.panelPlan === panelPlan) && (!panelSearch || searchable.includes(panelSearch));
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (panelStatus) panelStatus.textContent = visible === panelCards.length ? result : `${visible} ${visibleLabel}`;
    if (panelEmpty) panelEmpty.hidden = visible !== 0;
  };
  panelPortfolio?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-panel-plan-filter]') : null;
    if (!(target instanceof HTMLButtonElement)) return;
    panelPlan = target.dataset.panelPlanFilter ?? 'all';
    panelPortfolio.querySelectorAll('[data-panel-plan-filter]').forEach((button) => {
      const selected = button.dataset.panelPlanFilter === panelPlan;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    refreshPanels();
  });
  panelPortfolio?.querySelector('[data-panel-search]')?.addEventListener('input', (event) => {
    panelSearch = event.target instanceof HTMLInputElement ? event.target.value.trim().toLocaleLowerCase(locale) : '';
    refreshPanels();
  });
</script>
