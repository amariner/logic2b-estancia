---
import type { Locale } from '@logic-estancia/config';
import { getWebPortfolio } from '../web-portfolio';
import { getWebThemeVisual } from '../web-theme-visuals';
const { locale, slug = 'nivora' } = Astro.props as { locale: Locale; slug?: string };
const concept = getWebPortfolio(locale).find(item => item.slug === slug)!;
const visual = getWebThemeVisual(concept.slug);
const heroSource = concept.image.replace(/\.webp$/, '');
const detailSource = concept.status === 'canonical' ? `/media/${slug}/detail-640.avif` : `${heroSource}-640.avif`;
const en = locale === 'en';
const pages = concept.visiblePages.slice(0, 2);
---
<div class:list={['website-preview', `website-${visual.composition}`]} style={visual.style} data-theme-visual={concept.slug} role="img" aria-label={`${en ? 'Fictional website preview' : 'Vista de web ficticia'} · ${concept.brand} · ${concept.showcase.title}`}>
  <div class="website-browser"><span><i></i><i></i><i></i></span><small>{concept.slug}.example</small><span aria-hidden="true">↗</span></div>
  <div class="website-canvas" aria-hidden="true">
    <div class="website-nav"><b>{concept.brand}</b><span>{pages.join(' · ')}</span><i>↗</i></div>
    <div class="website-hero">
      <picture><source type="image/avif" srcset={`${heroSource}-640.avif 640w, ${heroSource}-960.avif 960w`} sizes="(max-width:760px) 90vw, 600px" /><img src={concept.image} alt="" width="960" height="640" loading="lazy" decoding="async" /></picture>
      <div><small>{concept.verticalLabel}</small><strong>{concept.showcase.title}</strong><span>{pages[0]} <b>→</b></span></div>
    </div>
    <div class="website-intro"><span>01 /</span><strong>{pages[1]}</strong><span>↓</span></div>
    <div class="website-rooms">{pages.map((page, index) => <div><img src={index === 0 ? detailSource : `${heroSource}-640.avif`} alt="" width="640" height="427" loading="lazy" decoding="async" /><span>{page}<b>↗</b></span></div>)}</div>
    <div class="website-bottom"><b>{concept.brand}</b><span>{en ? 'Fictional website' : 'Web ficticia'}</span></div>
  </div>
</div>
<style>
  .website-preview { container-type: inline-size; width:100%; min-width:0; overflow:hidden; border:1px solid color-mix(in srgb, var(--theme-ink) 18%, transparent); border-radius:14px; color:var(--theme-ink); background:var(--theme-paper); box-shadow:0 18px 40px #1b35281a; }
  .website-browser { display:flex; align-items:center; justify-content:space-between; min-height:30px; padding:8px 12px; border-bottom:1px solid #e1e5df; background:#f5f6f3; font:10px var(--sans); }
  .website-browser > span:first-child { display:flex; gap:4px; }
  .website-browser i { width:5px; height:5px; border-radius:50%; background:#bfc9be; }
  .website-browser small { font-size:9px; color:#5e695f; }
  .website-canvas { font-family:var(--sans); }
  .website-nav { display:flex; gap:3cqw; align-items:center; min-height:10cqw; padding:3cqw 4cqw; font-size:1.7cqw; }
  .website-nav b { margin-right:auto; font-family:var(--serif); font-size:3cqw; font-weight:400; }
  .website-nav > span { text-align:right; }
  .website-nav i { font-size:2.4cqw; font-style:normal; }
  .website-hero { position:relative; margin:0 2cqw; height:47cqw; overflow:hidden; isolation:isolate; color:white; background:var(--theme-ink); }
  .website-hero picture, .website-hero img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:var(--theme-image-position); z-index:-2; }
  .website-hero::before { content:''; position:absolute; inset:0; background:linear-gradient(90deg,#101810dd,#10181052); z-index:-1; }
  .website-hero > div { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; height:100%; padding:5cqw; }
  .website-hero small { font-size:1.8cqw; text-transform:uppercase; letter-spacing:.1em; }
  .website-hero strong { max-width:75%; margin:3cqw 0 4cqw; font:400 7cqw/1.02 var(--serif); letter-spacing:-.03em; text-wrap:balance; overflow-wrap:anywhere; }
  .website-hero span { display:flex; justify-content:space-between; gap:5cqw; min-width:26cqw; padding-block:1.5cqw; border-bottom:1px solid #ffffffa3; font-size:1.7cqw; }
  .website-intro { display:flex; gap:3cqw; align-items:center; padding:5cqw 4cqw 3cqw; }
  .website-intro > span { font-size:1.6cqw; }
  .website-intro > span:last-child { margin-left:auto; }
  .website-intro strong { font:400 4cqw var(--serif); }
  .website-rooms { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3cqw; padding:0 4cqw 4cqw; }
  .website-rooms img { display:block; width:100%; height:19cqw; object-fit:cover; object-position:var(--theme-image-position); }
  .website-rooms span { display:flex; justify-content:space-between; gap:2cqw; margin-top:1.6cqw; font-size:1.7cqw; }
  .website-bottom { display:flex; justify-content:space-between; padding:2.4cqw 4cqw; border-top:1px solid color-mix(in srgb, var(--theme-ink) 20%, transparent); font-size:1.5cqw; }
  .website-split .website-hero { margin-inline:0; color:var(--theme-ink); background:var(--theme-paper); }
  .website-split .website-hero picture { left:auto; width:51%; }
  .website-split .website-hero::before { content:none; }
  .website-split .website-hero > div { width:49%; padding:4cqw; }
  .website-split .website-hero small { color:var(--theme-accent); }
  .website-split .website-hero strong { max-width:100%; font-size:6.2cqw; }
  .website-split .website-hero span { width:100%; min-width:0; border-color:var(--theme-ink); }
  .website-framed .website-nav b { letter-spacing:.025em; }
  .website-framed .website-hero > div { align-items:center; margin:3cqw; height:calc(100% - 6cqw); border:1px solid #ffffff75; padding:3cqw; text-align:center; }
  .website-framed .website-hero strong { max-width:88%; font-size:6.5cqw; }
  .website-framed .website-hero span { justify-content:center; }
</style>
