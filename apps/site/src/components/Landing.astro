---
import type { Locale } from '@logic-estancia/config';
import { logic2bContact } from '@logic-estancia/config/contact';
import { content } from '../content';
import { getHomeContract } from '../home-contract';
import { getPlanCards } from '../plan-contract';
import { getWebPortfolio } from '../web-portfolio';
import CapabilityBand from './CapabilityBand.astro';
import HomeAftercare from './HomeAftercare.astro';
import HomeClosing from './HomeClosing.astro';
import HomeEcosystemBand from './HomeEcosystemBand.astro';
import HomeJourney from './HomeJourney.astro';
import HomePanelShowcase from './HomePanelShowcase.astro';
import HomeThemeShowcase from './HomeThemeShowcase.astro';
import HomeTourDialog from './HomeTourDialog.astro';
import PlanCard from './PlanCard.astro';
import ProductExplorer from './ProductExplorer.astro';
const { locale } = Astro.props as { locale: Locale };
const c = content[locale];
const home = getHomeContract(locale);
const heroConcepts = getWebPortfolio(locale);
const planCards = getPlanCards(locale);
const prefix = locale === 'en' ? '/en' : '';
const heroShortcutHrefs = [
  home.heroCases[0]?.href,
  `${prefix}/${locale === 'es' ? 'recorrido' : 'journey'}/`,
  `${prefix}/demos/terrava/gestion/?vista=home`,
] as const;
const wa = logic2bContact(locale, 'commercial');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const leadRequestTimeoutMs = 15_000;
const runtimeCopy = locale === 'es' ? {
  demoLabel: 'Modo demo seguro.',
  demoNote: 'Puedes completar el recorrido, pero no se enviará ni guardará ningún dato fuera de esta página.',
  demoOutcome: 'Simulación completada. No se ha enviado, almacenado ni comunicado ningún dato.',
  unavailableLabel: 'Envío no disponible temporalmente.',
  unavailableNote: 'No hemos podido verificar el estado del servicio. Tus datos no saldrán de esta página; recarga para intentarlo de nuevo o escríbenos por WhatsApp.',
  unavailableOutcome: 'No hemos podido verificar el servicio. No se ha enviado, almacenado ni comunicado ningún dato.',
  liveLabel: 'Solicitud comercial real.',
  liveNote: 'Al enviarla, Logic2B recibirá estos datos por email únicamente para responderte.',
} : {
  demoLabel: 'Safe demo mode.',
  demoNote: 'You can complete the journey, but no data will be sent or stored outside this page.',
  demoOutcome: 'Simulation complete. No data was sent, stored or communicated.',
  unavailableLabel: 'Sending is temporarily unavailable.',
  unavailableNote: 'We could not verify the service status. Your details will not leave this page; reload to try again or contact us on WhatsApp.',
  unavailableOutcome: 'We could not verify the service. No data was sent, stored or communicated.',
  liveLabel: 'Live commercial enquiry.',
  liveNote: 'When submitted, Logic2B will receive these details by email only to reply to you.',
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://estancia.logic2b.com/#service',
  name: 'Logic2B Estancias',
  serviceType: locale === 'es' ? 'Web y gestión de estancias online para alojamientos' : 'Website and online accommodation management for accommodation businesses',
  provider: { '@id': 'https://estancia.logic2b.com/#organization' },
  areaServed: { '@type': 'Country', name: 'Spain' },
  audience: { '@type': 'BusinessAudience', audienceType: locale === 'es' ? 'Casas rurales, apartamentos turísticos y hoteles' : 'Rural stays, holiday apartments and hotels' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: locale === 'es' ? 'Planes de Logic2B Estancias' : 'Logic2B Estancias plans',
  itemListElement: planCards.map(({ name, summary }) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, description: summary } })),
  },
};
---
<section class="hero" data-hero data-hero-pause={c.hero.pause} data-hero-resume={c.hero.resume}>
  <div class="hero-layout shell">
    <div class="hero-copy">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 class="display hero-title" aria-label={c.hero.label}>
        <span>{c.hero.lead}</span>
        <span class="hero-word-stack" aria-hidden="true">{c.hero.terms.map((term) => <span class="hero-word" data-hero-word>{term}</span>)}</span>
        <span>{c.hero.tail}</span>
      </h1>
      <p>{c.hero.body}</p>
      <div class="hero-start" aria-label={locale === 'es' ? 'Siguiente paso' : 'Next step'}>
        <a class="pill" href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`} data-track="cta_click" data-section="hero">{c.hero.primary} <span aria-hidden="true">→</span></a>
        <a class="hero-start-link" href="#producto">{c.hero.secondary} <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="hero-shortcuts" aria-label={locale === 'es' ? 'Accesos al recorrido' : 'Journey shortcuts'}>{c.hero.shortcuts.map((shortcut, index) => <li><a href={heroShortcutHrefs[index]} data-hero-shortcut>{shortcut} <span aria-hidden="true">↗</span></a></li>)}</ul>
      <p class="hero-note">{c.hero.note}</p>
    </div>
    <aside id="webs" class="hero-case-gallery" aria-labelledby="hero-case-gallery-title">
      <div class="hero-case-gallery-top"><div><p class="eyebrow">{c.hero.rail}</p><h2 id="hero-case-gallery-title">{c.hero.railTitle}</h2></div><button type="button" class="hero-motion-toggle" data-hero-motion-toggle aria-pressed="false"><span data-hero-motion-label>{c.hero.pause}</span><span aria-hidden="true">Ⅱ</span></button></div>
      <div class="hero-case-rails" data-hero-rail>
        <div class="hero-case-rail"><div class="hero-case-track hero-case-track-up">
          {[...heroConcepts, ...heroConcepts].map((concept, index) => index < heroConcepts.length ? <a class="hero-gallery-case" href={concept.demoHref} data-hero-proof={concept.status === 'canonical' ? concept.slug : undefined}><picture><source type="image/avif" srcset={`/media/${concept.slug}/hero-640.avif 640w, /media/${concept.slug}/hero-960.avif 960w`} sizes="(max-width: 640px) calc(100vw - 64px), 250px" /><img src={concept.image} alt="" width="2016" height="1344" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /></picture><span>{concept.verticalLabel} · {concept.planLabel}</span><strong>{concept.brand}</strong><b aria-hidden="true">↗</b></a> : <div class="hero-gallery-case" aria-hidden="true" data-hero-case-clone={concept.status === 'canonical' ? '' : undefined}><img src={concept.image} alt="" width="2016" height="1344" loading="lazy" decoding="async" /><span>{concept.verticalLabel} · {concept.planLabel}</span><strong>{concept.brand}</strong></div>)}
        </div></div>
        <div class="hero-case-rail hero-case-rail-secondary" aria-hidden="true"><div class="hero-case-track hero-case-track-down">
          {[...heroConcepts].reverse().concat([...heroConcepts].reverse()).map((concept) => <div class="hero-gallery-case"><img src={concept.image} alt="" width="2016" height="1344" loading="lazy" decoding="async" /><span>{concept.verticalLabel} · {concept.planLabel}</span><strong>{concept.brand}</strong></div>)}
        </div></div>
      </div>
      <a class="hero-case-gallery-all" href={`${prefix}/webs/`}>{locale === 'es' ? 'Ver las doce direcciones web' : 'See all twelve website directions'} <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const rail = hero?.querySelector<HTMLElement>('[data-hero-rail]');
  const toggle = hero?.querySelector<HTMLButtonElement>('[data-hero-motion-toggle]');
  const label = hero?.querySelector<HTMLElement>('[data-hero-motion-label]');
  const setMotion = (paused: boolean) => {
    if (!hero || !rail || !toggle || !label) return;
    rail.dataset.paused = String(paused);
    toggle.setAttribute('aria-pressed', String(paused));
    label.textContent = paused ? hero.dataset.heroResume ?? '' : hero.dataset.heroPause ?? '';
  };
  toggle?.addEventListener('click', () => setMotion(toggle.getAttribute('aria-pressed') !== 'true'));
</script>

<HomeEcosystemBand locale={locale} />
<HomeJourney locale={locale} />
<ProductExplorer locale={locale} />
<CapabilityBand locale={locale} />

<section id="planes" class="section levels">
  <div class="shell">
    <div class="section-head"><p class="eyebrow">{c.levels.eyebrow}</p><h2 class="heading">{c.levels.title}</h2><p>{locale === 'es' ? 'Cada punto de partida combina una web demostrable, un alcance explícito y un siguiente paso que puedes revisar. No publicamos precios hasta completar la validación comercial prevista.' : 'Each starting point combines a demonstrable website, a clear boundary and a next step you can review. We do not publish prices before completing the planned commercial validation.'}</p></div>
    <div class="plans-grid" data-plan-showcase>{planCards.map((plan, index) => <PlanCard locale={locale} plan={plan} sourcePath={locale === 'en' ? '/en/' : '/'} featured={index === 1} />)}</div>
    <p class="level-note">{c.levels.note}</p>
    <a class="text-link" href={`${prefix}/${locale === 'es' ? 'planes' : 'plans'}/`}>{locale === 'es' ? 'Comparar los tres planes y sus límites' : 'Compare all three plans and their boundaries'} <span aria-hidden="true">→</span></a>

    <div id="alcance" class="home-plan-assist" aria-labelledby="home-plan-assist-title">
      <div class="section-head"><p class="eyebrow">{c.scope.eyebrow}</p><h3 id="home-plan-assist-title" class="heading">{c.scope.title}</h3><p>{c.scope.body}</p></div>
      <div class="scope-builder artifact" data-scope-estimator data-copy={JSON.stringify(c.scope)}>
        <form class="scope-controls" data-scope-controls>
          <div class="scope-counts">
            <label>{c.scope.properties}<input name="scopeProperties" type="number" inputmode="numeric" min="1" max="10000" value="1" required /></label>
            <label>{c.scope.units}<input name="scopeUnits" type="number" inputmode="numeric" min="1" max="100000" value="1" required /></label>
          </div>
          <fieldset><legend>{c.scope.needs}</legend>
            <label><input name="scopeBookings" type="checkbox" /><span>{c.scope.booking}</span></label>
            <label><input name="scopeAutomation" type="checkbox" /><span>{c.scope.automation}</span></label>
            <label><input name="scopeOperations" type="checkbox" /><span>{c.scope.operations}</span></label>
          </fieldset>
        </form>
        <article class="scope-result" data-scope-result>
          <div aria-live="polite" aria-atomic="true">
            <span>{c.scope.result}</span><p class="scope-plan-code" data-scope-code>00</p><h3 data-scope-name>{c.scope.plans.basico[0]}</h3><p data-scope-description>{c.scope.plans.basico[1]}</p><ul data-scope-reasons><li>{c.scope.reasons.single}</li></ul>
          </div>
          <a class="pill" href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`} data-use-scope>{c.scope.use}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<HomeThemeShowcase locale={locale} />
<HomePanelShowcase locale={locale} />
<HomeAftercare locale={locale} />

<section class="section shell faq">
  <div class="section-head"><p class="eyebrow">{c.faq.eyebrow}</p><h2 class="heading">{c.faq.title}</h2></div>
  <div class="faq-list">{c.faq.items.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>

<HomeClosing locale={locale} />
<HomeTourDialog locale={locale} />

<div data-contact-origin>
<section id="contacto" class="section shell" aria-labelledby="contact-dialog-title">
  <div class="contact-wrap"><div class="section-head"><p class="eyebrow">{c.contact.eyebrow}</p><h2 id="contact-dialog-title" class="heading" tabindex="-1" data-contact-dialog-title>{c.contact.title}</h2><p id="contact-dialog-description">{c.contact.body}</p><ul class="contact-promises"><li>{locale === 'es' ? 'Revisamos el cuello de botella, no solo el número de habitaciones.' : 'We review the bottleneck, not only the number of rooms.'}</li><li>{locale === 'es' ? 'Separamos lo que ya puede demostrarse de lo que requiere integración.' : 'We separate what can be demonstrated now from what needs integration.'}</li><li>{locale === 'es' ? 'Tus datos se usan únicamente para responder y, si lo autorizas, hacer seguimiento.' : 'Your details are used only to reply and, if authorised, follow up.'}</li></ul><p><a href={wa.href} target="_blank" rel="noopener noreferrer">WhatsApp · {wa.phone} →</a></p></div>
  <form class="lead-form" data-lead method="dialog" novalidate>
    <p class="sr-only" role="status" aria-live="polite" data-assessment-context-status></p>
    <section class="assessment-handoff wide" data-assessment-handoff hidden aria-labelledby="assessment-handoff-title">
      <div><p class="eyebrow">{locale === 'es' ? 'Diagnóstico recuperado' : 'Assessment recovered'}</p><h3 id="assessment-handoff-title">{locale === 'es' ? 'No tienes que empezar de nuevo.' : 'You do not have to start again.'}</h3><p>{locale === 'es' ? 'Hemos precargado la recomendación y la escala. Puedes corregirlas abajo; las demás respuestas solo se adjuntarán cuando envíes este formulario.' : 'We prefilled the recommendation and scale. You can edit them below; the remaining answers are attached only when you submit this form.'}</p></div>
      <details><summary>{locale === 'es' ? 'Revisar el contexto que se adjuntará' : 'Review the context that will be attached'}<span aria-hidden="true">+</span></summary><dl data-assessment-summary></dl></details>
      <button class="text-link" type="button" data-assessment-discard>{locale === 'es' ? 'No adjuntar estas respuestas' : 'Do not attach these answers'}</button>
    </section>
    <p class="form-expectation wide">{c.contact.expectation}</p>
    <p class="runtime-lead-note wide" data-runtime-lead-note role="note"><strong data-runtime-lead-label>{runtimeCopy.demoLabel}</strong> <span data-runtime-lead-copy>{runtimeCopy.demoNote}</span></p>
    <label>{locale === 'es' ? 'Nombre' : 'Name'}<input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>{locale === 'es' ? 'Empresa o alojamiento' : 'Business or stay'}<input name="businessName" required maxlength="160" autocomplete="organization" /></label>
    <label>Email<input name="email" required type="email" maxlength="200" autocomplete="email" /></label>
    <label>{locale === 'es' ? 'Teléfono (opcional)' : 'Phone (optional)'}<input name="phone" maxlength="60" autocomplete="tel" /></label>
    <label>{locale === 'es' ? 'Tipo' : 'Type'}<select name="accommodationType" required><option value="apartment">{locale === 'es' ? 'Piso turístico' : 'Holiday apartment'}</option><option value="rural">{locale === 'es' ? 'Casas rurales' : 'Rural stays'}</option><option value="hotel">Hotel</option></select></label>
    <label>{locale === 'es' ? 'Plan de interés' : 'Plan of interest'}<select name="plan"><option value="">—</option><option value="basico">{locale === 'es' ? 'Básico' : 'Basic'}</option><option value="gestion">{locale === 'es' ? 'Gestión' : 'Management'}</option><option value="inteligente">{locale === 'es' ? 'Inteligente' : 'Intelligent'}</option></select></label>
    <label>{locale === 'es' ? 'Cuándo te gustaría empezar' : 'When would you like to start'}<select name="timeline"><option value="exploring">{locale === 'es' ? 'Estoy explorando' : 'I am exploring'}</option><option value="0-3">{locale === 'es' ? 'En los próximos 3 meses' : 'Within 3 months'}</option><option value="3-6">{locale === 'es' ? 'Entre 3 y 6 meses' : 'Within 3 to 6 months'}</option><option value="6-12">{locale === 'es' ? 'Entre 6 y 12 meses' : 'Within 6 to 12 months'}</option></select></label>
    <label>{locale === 'es' ? 'Propiedades' : 'Properties'}<input name="propertyCount" type="number" min="1" max="10000" value="1" required /></label>
    <label>{locale === 'es' ? 'Unidades' : 'Units'}<input name="unitCount" type="number" min="1" max="100000" value="1" required /></label>
    <label class="wide">{locale === 'es' ? 'Qué quieres poner en marcha' : 'What do you want to launch'}<textarea name="message" rows="5" maxlength="2000" placeholder={locale === 'es' ? 'Cuéntanos qué gestionas hoy, qué te frena y qué te gustaría conectar.' : 'Tell us what you manage today, what gets in the way and what you would like to connect.'}></textarea></label>
    <label class="honeypot" inert aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /></label>
    <label class="check wide"><input name="accept" type="checkbox" required /><span>{locale === 'es' ? <>He leído la <a href="/privacidad/" target="_blank" rel="noopener noreferrer">política de privacidad</a> y acepto que Logic2B use estos datos para responder.</> : <>I have read the <a href="/en/privacidad/" target="_blank" rel="noopener noreferrer">privacy policy</a> and accept that Logic2B uses these details to reply.</>}</span></label>
    <label class="check wide"><input name="marketingConsent" type="checkbox" /><span>{locale === 'es' ? 'También quiero recibir seguimiento comercial relevante (opcional).' : 'I would also like to receive relevant commercial follow-up (optional).'}</span></label>
    <div class="wide"><button class="pill" type="submit" data-lead-submit><span>{c.contact.submit}</span><span aria-hidden="true">→</span></button></div>
    <p class="form-status wide" role="status" aria-live="polite"></p>
    <section class="lead-receipt wide" data-lead-receipt hidden tabindex="-1" role="status" aria-live="polite" aria-atomic="true" aria-labelledby="lead-receipt-title">
      <span class="receipt-mark" aria-hidden="true">✓</span>
      <div><p class="eyebrow">{locale === 'es' ? 'Solicitud recibida' : 'Request received'}</p><h3 id="lead-receipt-title">{c.contact.receiptTitle}</h3><p>{c.contact.receiptBody}</p><p class="receipt-reference" data-lead-reference hidden><span>{c.contact.reference}</span><code data-lead-reference-value></code></p><p data-meeting-copy>{c.contact.meetingFallback}</p><a class="text-link" href={`${prefix}/#contacto`} data-meeting-link hidden target="_blank" rel="noopener noreferrer" data-track="meeting_click" data-section="homepage_contact">{c.contact.meetingCta} <span aria-hidden="true">→</span></a></div>
    </section>
  </form></div>
</section>
</div>

<dialog class="contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title" aria-describedby="contact-dialog-description">
  <div class="contact-dialog-panel">
    <div class="contact-dialog-bar"><span>{locale === 'es' ? 'Empecemos por tu proyecto' : 'Let’s start with your project'}</span><button type="button" data-contact-dialog-close aria-label={locale === 'es' ? 'Cerrar formulario de contacto' : 'Close contact form'}>{locale === 'es' ? 'Cerrar' : 'Close'} <span aria-hidden="true">×</span></button></div>
    <div data-contact-dialog-slot></div>
  </div>
</dialog>

<script is:inline define:vars={{ locale, sending: c.contact.sending, ok: c.contact.ok, error: c.contact.error, timeout: c.contact.timeout, rateLimited: c.contact.rateLimited, retrying: c.contact.retrying, submit: c.contact.submit, meetingAvailable: c.contact.meetingAvailable, meetingFallback: c.contact.meetingFallback, leadRequestTimeoutMs, demoLabel: runtimeCopy.demoLabel, demoNote: runtimeCopy.demoNote, demoOutcome: runtimeCopy.demoOutcome, unavailableLabel: runtimeCopy.unavailableLabel, unavailableNote: runtimeCopy.unavailableNote, unavailableOutcome: runtimeCopy.unavailableOutcome, liveLabel: runtimeCopy.liveLabel, liveNote: runtimeCopy.liveNote }}>
  const form = document.querySelector('[data-lead]');
  const status = form?.querySelector('.form-status');
  const receipt = form?.querySelector('[data-lead-receipt]');
  const runtimeNote = form?.querySelector('[data-runtime-lead-note]');
  const runtimeLabel = runtimeNote?.querySelector('[data-runtime-lead-label]');
  const runtimeCopy = runtimeNote?.querySelector('[data-runtime-lead-copy]');
  const contactSegment = new URLSearchParams(location.search).get('contact');
  const contactContexts = locale === 'es' ? {
    rural: { accommodationType: 'rural', sourcePath: '/soluciones/casas-rurales/' },
    apartments: { accommodationType: 'apartment', sourcePath: '/soluciones/apartamentos/' },
    hotels: { accommodationType: 'hotel', sourcePath: '/soluciones/hoteles/' },
  } : {
    rural: { accommodationType: 'rural', sourcePath: '/en/solutions/rural-stays/' },
    apartments: { accommodationType: 'apartment', sourcePath: '/en/solutions/apartments/' },
    hotels: { accommodationType: 'hotel', sourcePath: '/en/solutions/hotels/' },
  };
  const contactContext = contactSegment && contactContexts[contactSegment];
  const contactAccommodationType = form?.querySelector('[name=accommodationType]');
  if (contactContext && contactAccommodationType instanceof HTMLSelectElement) contactAccommodationType.value = contactContext.accommodationType;
  window.estanciaRuntimeReady?.then((runtime) => {
    const live = runtime.operations?.commercialLead === 'active' && runtime.providers?.email === 'live';
    const unavailable = runtime.manifestAvailable === false;
    if (runtimeLabel) runtimeLabel.textContent = unavailable ? unavailableLabel : live ? liveLabel : demoLabel;
    if (runtimeCopy) runtimeCopy.textContent = unavailable ? unavailableNote : live ? liveNote : demoNote;
    if (runtimeNote) runtimeNote.dataset.mode = unavailable ? 'unavailable' : live ? 'real' : 'demo';
  });
  document.querySelectorAll('[data-plan]').forEach((link) => link.addEventListener('click', () => {
    const plan = form?.querySelector('[name=plan]');
    if (plan && link.dataset.plan) plan.value = link.dataset.plan;
  }));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector('[data-lead-submit]'); const label = button?.querySelector('span');
    if (button) button.disabled = true; if (label) label.textContent = sending; if (status) status.textContent = '';
    const runtime = await (window.estanciaRuntimeReady ?? Promise.resolve(null));
    if (runtime?.operations?.commercialLead !== 'active' || runtime?.providers?.email !== 'live') {
      if (status) status.textContent = runtime?.manifestAvailable === false ? unavailableOutcome : demoOutcome;
      if (button) button.disabled = false;
      if (label) label.textContent = submit;
      return;
    }
    const d = Object.fromEntries(new FormData(form));
    const assessmentFields = window.estanciaAssessment?.leadFields() || {};
    const payload = { ...assessmentFields, ...d, propertyCount: Number(d.propertyCount), unitCount: Number(d.unitCount), accept: d.accept === 'on', marketingConsent: d.marketingConsent === 'on', lang: locale, sourcePath: assessmentFields.sourcePath || contactContext?.sourcePath || location.pathname };
    const controller = new AbortController();
    const requestTimeout = setTimeout(() => controller.abort(), leadRequestTimeoutMs);
    let retryAfter = 0;
    try {
      const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload), signal: controller.signal });
      const result = await response.json().catch(() => ({}));
      if (response.status === 429) {
        const delay = Number(result.retryAfter ?? response.headers.get('retry-after'));
        retryAfter = Number.isFinite(delay) ? Math.min(60, Math.max(1, Math.ceil(delay))) : 60;
        throw new Error('rate_limited');
      }
      if (!response.ok || !['delivered', 'delivered_degraded'].includes(result.outcome)) throw new Error('delivery');
      const reference = typeof result.ref === 'string' && /^[a-zA-Z0-9-]{1,100}$/.test(result.ref) ? result.ref : null;
      let meetingUrl = null;
      try { const candidate = new URL(result.meetingUrl); if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) meetingUrl = candidate.href; } catch {}
      const referenceRow = receipt?.querySelector('[data-lead-reference]');
      const referenceValue = receipt?.querySelector('[data-lead-reference-value]');
      const meetingCopy = receipt?.querySelector('[data-meeting-copy]');
      const meetingLink = receipt?.querySelector('[data-meeting-link]');
      if (referenceRow) referenceRow.hidden = !reference;
      if (referenceValue) referenceValue.textContent = reference || '';
      if (meetingCopy) meetingCopy.textContent = meetingUrl ? meetingAvailable : meetingFallback;
      if (meetingLink) { meetingLink.hidden = !meetingUrl; if (meetingUrl) meetingLink.href = meetingUrl; else meetingLink.removeAttribute('href'); }
      form.reset(); window.estanciaAssessment?.clear();
      form.dataset.submitted = 'true';
      if (status) status.textContent = ok;
      if (receipt) { receipt.hidden = false; receipt.focus(); }
      window.estanciaTrack?.('lead_submit', { locale, plan: payload.plan || 'none', source_section: 'homepage_contact' });
    }
    catch (failure) {
      if (status) status.textContent = controller.signal.aborted ? timeout : failure instanceof Error && failure.message === 'rate_limited' ? rateLimited.replace('{seconds}', String(retryAfter)) : error;
    }
    finally {
      clearTimeout(requestTimeout);
      if (button && !form.dataset.submitted && retryAfter > 0) {
        let remaining = retryAfter;
        const updateRetry = () => { if (label) label.textContent = retrying.replace('{seconds}', String(remaining)); };
        updateRetry();
        const retryTimer = setInterval(() => {
          remaining -= 1;
          if (remaining > 0) updateRetry();
          else { clearInterval(retryTimer); button.disabled = false; if (label) label.textContent = submit; }
        }, 1_000);
      }
      else { if (button && !form.dataset.submitted) button.disabled = false; if (label) label.textContent = submit; }
    }
  });
</script>

