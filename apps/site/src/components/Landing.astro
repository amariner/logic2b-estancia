---
import type { Locale } from '@logic-estancia/config';
import { logic2bContact } from '@logic-estancia/config/contact';
import { content } from '../content';
const { locale } = Astro.props as { locale: Locale };
const c = content[locale];
const prefix = locale === 'en' ? '/en' : '';
const wa = logic2bContact(locale, 'commercial');
const demos = locale === 'es' ? [
  { slug: 'nivora', level: 'Inicio · monoestancia', name: 'Nivora One', text: 'Un piso turístico con una web que convierte interés en una consulta clara.', image: '/media/nivora/hero.webp' },
  { slug: 'terrava', level: 'Gestión · 8 propiedades', name: 'Terrava Collection', text: 'Una solicitud, ocho casas y una alternativa que acaba en reserva.', image: '/media/terrava/hero.webp' },
  { slug: 'aurem', level: 'Visión · 96 habitaciones', name: 'Aurem Hotel', text: 'Reserva directa, canales y una habitación que debe estar lista a tiempo.', image: '/media/aurem/hero.webp' },
] : [
  { slug: 'nivora', level: 'Start · single stay', name: 'Nivora One', text: 'One holiday apartment and a website that turns interest into a clear enquiry.', image: '/media/nivora/hero.webp' },
  { slug: 'terrava', level: 'Manage · 8 properties', name: 'Terrava Collection', text: 'One enquiry, eight homes and an alternative that becomes a booking.', image: '/media/terrava/hero.webp' },
  { slug: 'aurem', level: 'Vision · 96 rooms', name: 'Aurem Hotel', text: 'Direct booking, channels and a room that must be ready on time.', image: '/media/aurem/hero.webp' },
];
const levels = locale === 'es' ? [
  ['00', 'Inicio', 'Web, SEO y consultas. Sin un gestor que no necesitas todavía.', 'inicio'],
  ['01', 'Gestión', 'Reservas, huéspedes, planning, cobro opcional, limpieza básica e iCal.', 'gestion'],
  ['02', 'Automatiza', 'Mensajes, recordatorios, reseñas, canales y copiloto supervisado.', 'automatiza'],
  ['03', 'Inteligente', 'Centro operativo, equipo, mantenimiento, revenue y previsión.', 'inteligente'],
] : [
  ['00', 'Start', 'Website, SEO and enquiries. No workspace you do not need yet.', 'inicio'],
  ['01', 'Manage', 'Bookings, guests, planning, optional payment, basic cleaning and iCal.', 'gestion'],
  ['02', 'Automate', 'Messages, reminders, reviews, channels and a supervised copilot.', 'automatiza'],
  ['03', 'Intelligent', 'Operations centre, teams, maintenance, revenue and forecasting.', 'inteligente'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<section class="hero">
  <div class="hero-copy shell">
    <p class="eyebrow">{c.hero.eyebrow}</p>
    <h1 class="display">{c.hero.title.split(', ')[0]}, <em>{c.hero.title.split(', ').slice(1).join(', ')}</em></h1>
    <p>{c.hero.body}</p>
    <div class="hero-actions"><a class="pill" href="#demos">{c.hero.primary}</a><a class="pill ghost" href="#contacto">{c.hero.secondary}</a></div>
  </div>
  <article class="floating artifact a"><span>{locale === 'es' ? 'Llegadas de hoy' : 'Today’s arrivals'}</span><strong>18</strong><span class="status">{locale === 'es' ? '3 requieren atención' : '3 need attention'}</span></article>
  <article class="floating artifact b"><span>{locale === 'es' ? 'Habitaciones listas' : 'Rooms ready'}</span><strong>92%</strong><span class="status">{locale === 'es' ? '6 en preparación' : '6 in preparation'}</span></article>
  <article class="floating artifact c"><span>{locale === 'es' ? 'Ocupación prevista · próximos 14 días' : 'Forecast occupancy · next 14 days'}</span><div class="mini-chart" aria-hidden="true">{[42,55,62,48,68,78,72,83,91,88,74,86,92,80].map((h) => <i style={`--h:${h}%`}></i>)}</div></article>
</section>

<section id="producto" class="section shell">
  <div class="section-head"><p class="eyebrow">{c.proof.eyebrow}</p><h2 class="heading">{c.proof.title}</h2><p>{c.proof.body}</p></div>
  <div class="product-stage">
    <ul class="feature-list">
      <li><strong>{locale === 'es' ? 'Una fuente de verdad' : 'One source of truth'}</strong><span class="muted">{locale === 'es' ? 'Empresa, propiedad y unidad comparten el mismo modelo.' : 'Organisation, property and unit share one model.'}</span></li>
      <li><strong>{locale === 'es' ? 'Acciones supervisadas' : 'Supervised actions'}</strong><span class="muted">{locale === 'es' ? 'Precio, cobro y mensajes siempre exigen confirmación.' : 'Pricing, payments and messages always require confirmation.'}</span></li>
      <li><strong>{locale === 'es' ? 'La realidad a la vista' : 'Truth in plain sight'}</strong><span class="muted">{locale === 'es' ? 'Disponible, demo, por validar o futuro: nunca una promesa ambigua.' : 'Available, demo, to validate or future: never an ambiguous promise.'}</span></li>
    </ul>
    <div class="product-window artifact" aria-label={locale === 'es' ? 'Vista simulada del gestor' : 'Simulated workspace view'}>
      <div class="window-bar"><span>Aurem Hotel · {locale === 'es' ? 'Todas las propiedades' : 'All properties'}</span><span>{locale === 'es' ? 'Dirección' : 'Direction'} · Demo</span></div>
      <div class="window-grid"><article><span>{locale === 'es' ? 'Riesgos para las entradas' : 'Arrival risks'}</span><b>3</b><small class="muted">{locale === 'es' ? 'Limpieza · pago · asignación' : 'Cleaning · payment · assignment'}</small></article><article><span>{locale === 'es' ? 'Ocupación' : 'Occupancy'}</span><b>87%</b></article><article><span>{locale === 'es' ? 'Preparación' : 'Preparation'}</span><b>14/18</b></article><article><span>Canales</span><b>4</b><small class="muted">{locale === 'es' ? 'Demo · no conectados' : 'Demo · not connected'}</small></article></div>
    </div>
  </div>
</section>

<section class="section modes">
  <div class="shell"><div class="section-head"><p class="eyebrow">{c.modes.eyebrow}</p><h2 class="heading">{c.modes.title}</h2></div><div class="mode-grid"><article class="card"><span>01</span><h3>{c.modes.mono[0]}</h3><p>{c.modes.mono[1]}</p></article><article class="card"><span>02</span><h3>{c.modes.multi[0]}</h3><p>{c.modes.multi[1]}</p></article></div></div>
</section>

<section id="demos" class="section shell">
  <div class="section-head"><p class="eyebrow">{c.demos.eyebrow}</p><h2 class="heading">{c.demos.title}</h2></div>
  <div class="demo-grid">{demos.map((demo) => <a class="demo-card card" href={`${prefix}/demos/${demo.slug}/`}><picture><source type="image/avif" srcset={`/media/${demo.slug}/hero-640.avif 640w, /media/${demo.slug}/hero-960.avif 960w`} sizes="(max-width: 760px) 100vw, 33vw" /><img src={demo.image} alt="" loading="lazy" width="2016" height="1344" /></picture><div><span class="eyebrow">{demo.level}</span><h3>{demo.name}</h3><p>{demo.text}</p><span>{c.demos.open} →</span></div></a>)}</div>
</section>

<section id="niveles" class="section levels">
  <div class="shell"><div class="section-head"><p class="eyebrow">{c.levels.eyebrow}</p><h2 class="heading">{c.levels.title}</h2></div><div class="level-grid">{levels.map(([n, name, text, value]) => <article><span>{n}</span><h3>{name}</h3><p>{text}</p><a href="#contacto" data-plan={value}>{locale === 'es' ? 'Me interesa' : 'I’m interested'} <span aria-hidden="true">→</span></a></article>)}</div><p class="level-note">{c.levels.note}</p></div>
</section>

<section id="alcance" class="section scope-section">
  <div class="shell">
    <div class="section-head"><p class="eyebrow">{c.scope.eyebrow}</p><h2 class="heading">{c.scope.title}</h2><p>{c.scope.body}</p></div>
    <div class="scope-builder artifact" data-scope-estimator data-copy={JSON.stringify(c.scope)}>
      <form class="scope-controls" data-scope-controls>
        <div class="scope-counts">
          <label>{c.scope.properties}<input name="scopeProperties" type="number" inputmode="numeric" min="1" max="10000" value="1" required /></label>
          <label>{c.scope.units}<input name="scopeUnits" type="number" inputmode="numeric" min="1" max="100000" value="1" required /></label>
        </div>
        <fieldset><legend>{c.scope.needs}</legend>
          <label><input name="scopeBookings" type="checkbox" /><span>{c.scope.booking}</span></label>
          <label><input name="scopeAutomation" type="checkbox" /><span>{c.scope.automation}</span></label>
          <label><input name="scopeOperations" type="checkbox" /><span>{c.scope.operations}</span></label>
        </fieldset>
      </form>
      <article class="scope-result" data-scope-result>
        <div aria-live="polite" aria-atomic="true">
          <span>{c.scope.result}</span>
          <p class="scope-plan-code" data-scope-code>00</p>
          <h3 data-scope-name>{c.scope.plans.inicio[0]}</h3>
          <p data-scope-description>{c.scope.plans.inicio[1]}</p>
          <ul data-scope-reasons><li>{c.scope.reasons.single}</li></ul>
        </div>
        <a class="pill" href="#contacto" data-use-scope>{c.scope.use}<span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<section class="section activation">
  <div class="shell activation-wrap">
    <div class="section-head"><p class="eyebrow">{c.activation.eyebrow}</p><h2 class="heading">{c.activation.title}</h2><p>{c.activation.body}</p><a class="pill ghost" href="#contacto">{c.activation.cta}</a></div>
    <ol class="activation-steps">{c.activation.steps.map(([name, text], index) => <li><span>0{index + 1}</span><div><h3>{name}</h3><p>{text}</p></div></li>)}</ol>
  </div>
</section>

<section class="section shell faq">
  <div class="section-head"><p class="eyebrow">{c.faq.eyebrow}</p><h2 class="heading">{c.faq.title}</h2></div>
  <div class="faq-list">{c.faq.items.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section id="contacto" class="section shell">
  <div class="contact-wrap"><div class="section-head"><p class="eyebrow">{c.contact.eyebrow}</p><h2 class="heading">{c.contact.title}</h2><p>{c.contact.body}</p><p><a href={wa.href} target="_blank" rel="noopener noreferrer">WhatsApp · {wa.phone} →</a></p></div>
  <form class="lead-form" data-lead novalidate>
    <label>{locale === 'es' ? 'Nombre' : 'Name'}<input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>{locale === 'es' ? 'Empresa o alojamiento' : 'Business or stay'}<input name="businessName" required maxlength="160" autocomplete="organization" /></label>
    <label>Email<input name="email" required type="email" maxlength="200" autocomplete="email" /></label>
    <label>{locale === 'es' ? 'Teléfono (opcional)' : 'Phone (optional)'}<input name="phone" maxlength="60" autocomplete="tel" /></label>
    <label>{locale === 'es' ? 'Tipo' : 'Type'}<select name="accommodationType" required><option value="apartment">{locale === 'es' ? 'Piso turístico' : 'Holiday apartment'}</option><option value="rural">{locale === 'es' ? 'Casas rurales' : 'Rural stays'}</option><option value="hotel">Hotel</option></select></label>
    <label>{locale === 'es' ? 'Plan de interés' : 'Plan of interest'}<select name="plan"><option value="">—</option><option value="inicio">{locale === 'es' ? 'Inicio' : 'Start'}</option><option value="gestion">{locale === 'es' ? 'Gestión' : 'Manage'}</option><option value="automatiza">{locale === 'es' ? 'Automatiza' : 'Automate'}</option><option value="inteligente">{locale === 'es' ? 'Inteligente' : 'Intelligent'}</option></select></label>
    <label>{locale === 'es' ? 'Propiedades' : 'Properties'}<input name="propertyCount" type="number" min="1" max="10000" value="1" required /></label>
    <label>{locale === 'es' ? 'Unidades' : 'Units'}<input name="unitCount" type="number" min="1" max="100000" value="1" required /></label>
    <label class="wide">{locale === 'es' ? 'Qué quieres poner en marcha' : 'What do you want to launch'}<textarea name="message" rows="5" maxlength="2000" placeholder={locale === 'es' ? 'Cuéntanos qué gestionas hoy, qué te frena y qué te gustaría conectar.' : 'Tell us what you manage today, what gets in the way and what you would like to connect.'}></textarea></label>
    <label><span class="sr-only">Website</span><input name="website" tabindex="-1" autocomplete="off" /></label>
    <label class="check wide"><input name="accept" type="checkbox" required /><span>{locale === 'es' ? 'He leído la política de privacidad y acepto que Logic2B use estos datos para responder.' : 'I have read the privacy policy and accept that Logic2B uses these details to reply.'}</span></label>
    <div class="wide"><button class="pill" type="submit"><span>{c.contact.submit}</span><span aria-hidden="true">→</span></button></div>
    <p class="form-status wide" role="status" aria-live="polite"></p>
  </form></div>
</section>

<script is:inline define:vars={{ locale, sending: c.contact.sending, ok: c.contact.ok, error: c.contact.error }}>
  const form = document.querySelector('[data-lead]');
  const status = form?.querySelector('.form-status');
  document.querySelectorAll('[data-plan]').forEach((link) => link.addEventListener('click', () => {
    const plan = form?.querySelector('[name=plan]');
    if (plan && link.dataset.plan) plan.value = link.dataset.plan;
  }));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector('button[type=submit]'); const label = button?.querySelector('span');
    if (button) button.disabled = true; if (label) label.textContent = sending; if (status) status.textContent = '';
    const d = Object.fromEntries(new FormData(form));
    const payload = { ...d, propertyCount: Number(d.propertyCount), unitCount: Number(d.unitCount), accept: d.accept === 'on', lang: locale };
    try { const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }); if (!response.ok) throw new Error('delivery'); form.reset(); if (status) status.textContent = ok; window.dataLayer?.push({ event: 'estancia_submit_lead', accommodation_type: payload.accommodationType, plan: payload.plan || 'none' }); }
    catch { if (status) status.textContent = error; }
    finally { if (button) button.disabled = false; if (label) label.textContent = locale === 'es' ? 'Enviar proyecto' : 'Send project'; }
  });
</script>

<script>
  import '../scripts/scope-estimator';
</script>
