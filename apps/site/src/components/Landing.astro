---
import type { Locale } from '@logic-estancia/config';
import { logic2bContact } from '@logic-estancia/config/contact';
import { content } from '../content';
import { getBusinesses } from '../businesses';
import HumanService from './HumanService.astro';
const { locale } = Astro.props as { locale: Locale };
const c = content[locale];
const prefix = locale === 'en' ? '/en' : '';
const wa = logic2bContact(locale, 'commercial');
const businesses = getBusinesses(locale);
const demos = locale === 'es' ? [
  { slug: 'nivora', level: 'Caso ficticio · Básico', name: 'Nivora One', text: 'Cuando una buena estancia necesita una web que esté a su altura y abra una conversación directa.', image: '/media/nivora/hero.webp' },
  { slug: 'terrava', level: 'Caso ficticio · Gestión', name: 'Terrava Collection', text: 'Cuando ocho casas comparten demanda, pero no deberían repetir ocho veces el mismo trabajo.', image: '/media/terrava/hero.webp' },
  { slug: 'aurem', level: 'Caso ficticio · Inteligente', name: 'Aurem Hotel', text: 'Cuando el huésped aún no ve el problema, pero el equipo necesita detectarlo y coordinarse.', image: '/media/aurem/hero.webp' },
] : [
  { slug: 'nivora', level: 'Fictional case · Basic', name: 'Nivora One', text: 'When a distinctive stay needs a website that does it justice and starts a direct conversation.', image: '/media/nivora/hero.webp' },
  { slug: 'terrava', level: 'Fictional case · Management', name: 'Terrava Collection', text: 'When eight homes share demand but should not repeat the same work eight times.', image: '/media/terrava/hero.webp' },
  { slug: 'aurem', level: 'Fictional case · Intelligent', name: 'Aurem Hotel', text: 'When the guest cannot see the problem yet, but the team needs to spot it and coordinate.', image: '/media/aurem/hero.webp' },
];
const levels = locale === 'es' ? [
  ['00', 'Básico', 'Deja de parecer uno más cuando te comparan y convierte el interés en consultas por email.', 'basico'],
  ['01', 'Gestión', 'Da continuidad a cada consulta y reserva sin reconstruir su historia en varias herramientas.', 'gestion'],
  ['02', 'Inteligente', 'Haz visible lo que necesita atención antes de que se convierta en una urgencia para el equipo.', 'inteligente'],
] : [
  ['00', 'Basic', 'Stop looking interchangeable when guests compare and turn interest into email enquiries.', 'basico'],
  ['01', 'Management', 'Give every enquiry and booking continuity without rebuilding its story across several tools.', 'gestion'],
  ['02', 'Intelligent', 'Make what needs attention visible before it turns into an urgent problem for the team.', 'inteligente'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const leadRequestTimeoutMs = 15_000;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://estancia.logic2b.com/#service',
  name: 'Logic Estancia',
  serviceType: locale === 'es' ? 'Web, gestión de reservas y operación para alojamientos' : 'Website, booking management and operations for accommodation businesses',
  provider: { '@id': 'https://estancia.logic2b.com/#organization' },
  areaServed: { '@type': 'Country', name: 'Spain' },
  audience: { '@type': 'BusinessAudience', audienceType: locale === 'es' ? 'Casas rurales, apartamentos turísticos y hoteles' : 'Rural stays, holiday apartments and hotels' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: locale === 'es' ? 'Planes de Logic Estancia' : 'Logic Estancia plans',
    itemListElement: levels.map(([, name, description]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, description } })),
  },
};
---
<section class="hero">
  <div class="hero-layout shell">
    <div class="hero-copy">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 class="display">{c.hero.title} <em>{c.hero.accent}</em></h1>
      <p>{c.hero.body}</p>
      <div class="hero-actions"><a class="pill" href="#negocio" data-track="cta_click" data-section="hero">{c.hero.primary}</a><a class="pill ghost" href="#demos">{c.hero.secondary}</a></div>
      <ul class="hero-assurances" aria-label={locale === 'es' ? 'Principios del servicio' : 'Service principles'}><li>{locale === 'es' ? 'Adaptado a tu negocio' : 'Adapted to your business'}</li><li>{locale === 'es' ? 'Configurado por Logic2B' : 'Configured by Logic2B'}</li><li>{locale === 'es' ? 'Acompañamiento humano' : 'Human support'}</li></ul>
    </div>
    <div class="hero-businesses" aria-label={locale === 'es' ? 'Soluciones por tipo de alojamiento' : 'Solutions by accommodation type'}>
      {businesses.map((business, index) => <a class={`hero-business ${index === 0 ? 'featured' : ''}`} href={business.href}><img src={business.image} alt="" width="2016" height="1344" /><span><small>{locale === 'es' ? 'Solución para' : 'Solution for'}</small><strong>{business.plural}</strong></span><b aria-hidden="true">↗</b></a>)}
    </div>
  </div>
</section>

<section class="section tension-section">
  <div class="shell commercial-columns"><div class="section-head"><p class="eyebrow">{locale === 'es' ? 'El coste de seguir igual' : 'The cost of standing still'}</p><h2 class="heading">{locale === 'es' ? 'No te falta otra herramienta. Te falta que el recorrido completo tenga sentido.' : 'You do not need another tool. You need the whole journey to make sense.'}</h2><p>{locale === 'es' ? 'La fricción rara vez está en un único lugar. Se acumula entre la búsqueda del huésped, la respuesta, la reserva y el trabajo que nadie ve.' : 'Friction rarely sits in one place. It builds between guest search, response, booking and the work no one sees.'}</p></div><ol class="problem-list"><li><span>01</span><p>{locale === 'es' ? 'Te encuentran, pero tu web no termina de explicar por qué elegirte.' : 'Guests find you, but your website does not quite explain why they should choose you.'}</p></li><li><span>02</span><p>{locale === 'es' ? 'Responder una consulta obliga a comprobar canales, calendarios y conversaciones.' : 'Answering an enquiry means checking channels, calendars and conversations.'}</p></li><li><span>03</span><p>{locale === 'es' ? 'El equipo resuelve hoy lo que podía haber visto ayer.' : 'The team solves today what it could have seen yesterday.'}</p></li></ol></div>
</section>

<section id="negocio" class="section segment-section shell" aria-labelledby="segment-title">
  <div class="section-head"><p class="eyebrow">{locale === 'es' ? 'Empieza por tu realidad' : 'Start with your reality'}</p><h2 id="segment-title" class="heading">{locale === 'es' ? 'No todos los alojamientos venden igual. Tampoco deberían gestionarse igual.' : 'Not every stay sells the same way. It should not be managed the same way either.'}</h2><p>{locale === 'es' ? 'Elige el negocio que más se parece al tuyo. Cada recorrido parte de sus fricciones, su ritmo y el tipo de relación que necesita construir con el huésped.' : 'Choose the business closest to yours. Each journey begins with its friction, pace and the kind of guest relationship it needs to build.'}</p></div>
  <div class="segment-grid">{businesses.map((business, index) => <a class="card" href={business.href}><span>0{index + 1}</span><h3>{business.homeTitle}</h3><p>{business.homeText}</p><b>{locale === 'es' ? `Ver solución para ${business.plural.toLowerCase()}` : `View solution for ${business.plural.toLowerCase()}`} →</b></a>)}</div>
</section>

<section id="producto" class="section shell">
  <div class="section-head"><p class="eyebrow">{c.proof.eyebrow}</p><h2 class="heading">{c.proof.title}</h2><p>{c.proof.body}</p></div>
  <div class="product-stage">
    <ul class="feature-list">
      <li><strong>{locale === 'es' ? 'Más oportunidades bajo tu marca' : 'More opportunities under your brand'}</strong><span class="muted">{locale === 'es' ? 'Una web pensada para ser encontrada, entendida y contactada.' : 'A website designed to be found, understood and contacted.'}</span></li>
      <li><strong>{locale === 'es' ? 'Menos persecución interna' : 'Less internal chasing'}</strong><span class="muted">{locale === 'es' ? 'La reserva conserva el contexto que necesita el siguiente paso.' : 'The booking keeps the context the next step needs.'}</span></li>
      <li><strong>{locale === 'es' ? 'Automatizar sin perder el criterio' : 'Automate without losing judgement'}</strong><span class="muted">{locale === 'es' ? 'Precios, cobros, canales y mensajes requieren validación antes de actuar.' : 'Pricing, payments, channels and messages require validation before action.'}</span></li>
    </ul>
    <div class="product-window artifact" aria-label={locale === 'es' ? 'Vista simulada del gestor' : 'Simulated workspace view'}>
      <div class="window-bar"><span>Aurem Hotel · {locale === 'es' ? 'Escenario ficticio' : 'Fictional scenario'}</span><span>{locale === 'es' ? 'Vista local' : 'Local view'} · Demo</span></div>
      <div class="window-grid"><article><span>{locale === 'es' ? 'Riesgos para las entradas' : 'Arrival risks'}</span><b>3</b><small class="muted">{locale === 'es' ? 'Limpieza · pago · asignación' : 'Cleaning · payment · assignment'}</small></article><article><span>{locale === 'es' ? 'Ocupación' : 'Occupancy'}</span><b>87%</b></article><article><span>{locale === 'es' ? 'Preparación' : 'Preparation'}</span><b>14/18</b></article><article><span>Canales</span><b>4</b><small class="muted">{locale === 'es' ? 'Demo · no conectados' : 'Demo · not connected'}</small></article></div>
    </div>
  </div>
</section>

<section class="section modes">
  <div class="shell"><div class="section-head"><p class="eyebrow">{c.modes.eyebrow}</p><h2 class="heading">{c.modes.title}</h2></div><div class="mode-grid"><article class="card"><span>01</span><h3>{c.modes.mono[0]}</h3><p>{c.modes.mono[1]}</p></article><article class="card"><span>02</span><h3>{c.modes.multi[0]}</h3><p>{c.modes.multi[1]}</p></article></div></div>
</section>

<section id="demos" class="section shell">
  <div class="section-head"><p class="eyebrow">{c.demos.eyebrow}</p><h2 class="heading">{c.demos.title}</h2><p>{locale === 'es' ? 'Puedes recorrer cada caso sin registrarte. Todo lo que ocurre dentro es local, ficticio y está etiquetado para que la evidencia no se confunda con una promesa.' : 'Explore every case without registering. Everything inside is local, fictional and labelled so evidence is never confused with a promise.'}</p></div>
  <div class="demo-grid">{demos.map((demo) => <a class="demo-card card" href={`${prefix}/demos/${demo.slug}/`}><picture><source type="image/avif" srcset={`/media/${demo.slug}/hero-640.avif 640w, /media/${demo.slug}/hero-960.avif 960w`} sizes="(max-width: 760px) 100vw, 33vw" /><img src={demo.image} alt="" loading="lazy" width="2016" height="1344" /></picture><div><span class="eyebrow">{demo.level}</span><h3>{demo.name}</h3><p>{demo.text}</p><span>{c.demos.open} →</span></div></a>)}</div>
</section>

<section id="niveles" class="section levels">
  <div class="shell"><div class="section-head"><p class="eyebrow">{c.levels.eyebrow}</p><h2 class="heading">{c.levels.title}</h2></div><div class="level-grid">{levels.map(([n, name, text, value]) => <article><span>{n}</span><h3>{name}</h3><p>{text}</p><a href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/?plan=${value}`} data-plan={value} data-track="plan_select" data-section="homepage_plans">{locale === 'es' ? 'Ver si encaja' : 'See if it fits'} <span aria-hidden="true">→</span></a></article>)}</div><p class="level-note">{c.levels.note}</p><a class="text-link" href={`${prefix}/${locale === 'es' ? 'planes' : 'plans'}/`}>{locale === 'es' ? 'Comparar los tres planes y sus límites' : 'Compare all three plans and their boundaries'} <span aria-hidden="true">→</span></a></div>
</section>

<section id="alcance" class="section scope-section">
  <div class="shell">
    <div class="section-head"><p class="eyebrow">{c.scope.eyebrow}</p><h2 class="heading">{c.scope.title}</h2><p>{c.scope.body}</p></div>
    <div class="scope-builder artifact" data-scope-estimator data-copy={JSON.stringify(c.scope)}>
      <form class="scope-controls" data-scope-controls>
        <div class="scope-counts">
          <label>{c.scope.properties}<input name="scopeProperties" type="number" inputmode="numeric" min="1" max="10000" value="1" required /></label>
          <label>{c.scope.units}<input name="scopeUnits" type="number" inputmode="numeric" min="1" max="100000" value="1" required /></label>
        </div>
        <fieldset><legend>{c.scope.needs}</legend>
          <label><input name="scopeBookings" type="checkbox" /><span>{c.scope.booking}</span></label>
          <label><input name="scopeAutomation" type="checkbox" /><span>{c.scope.automation}</span></label>
          <label><input name="scopeOperations" type="checkbox" /><span>{c.scope.operations}</span></label>
        </fieldset>
      </form>
      <article class="scope-result" data-scope-result>
        <div aria-live="polite" aria-atomic="true">
          <span>{c.scope.result}</span>
          <p class="scope-plan-code" data-scope-code>00</p>
          <h3 data-scope-name>{c.scope.plans.basico[0]}</h3>
          <p data-scope-description>{c.scope.plans.basico[1]}</p>
          <ul data-scope-reasons><li>{c.scope.reasons.single}</li></ul>
        </div>
        <a class="pill" href={`${prefix}/${locale === 'es' ? 'diagnostico' : 'assessment'}/`} data-use-scope>{c.scope.use}<span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<HumanService locale={locale} ctaHref="#contacto" />

<section class="section shell faq">
  <div class="section-head"><p class="eyebrow">{c.faq.eyebrow}</p><h2 class="heading">{c.faq.title}</h2></div>
  <div class="faq-list">{c.faq.items.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>

<section id="contacto" class="section shell">
  <div class="contact-wrap"><div class="section-head"><p class="eyebrow">{c.contact.eyebrow}</p><h2 class="heading">{c.contact.title}</h2><p>{c.contact.body}</p><ul class="contact-promises"><li>{locale === 'es' ? 'Revisamos el cuello de botella, no solo el número de habitaciones.' : 'We review the bottleneck, not only the number of rooms.'}</li><li>{locale === 'es' ? 'Separamos lo que ya puede demostrarse de lo que requiere integración.' : 'We separate what can be demonstrated now from what needs integration.'}</li><li>{locale === 'es' ? 'Tus datos se usan únicamente para responder y, si lo autorizas, hacer seguimiento.' : 'Your details are used only to reply and, if authorised, follow up.'}</li></ul><p><a href={wa.href} target="_blank" rel="noopener noreferrer">WhatsApp · {wa.phone} →</a></p></div>
  <form class="lead-form" data-lead novalidate>
    <p class="sr-only" role="status" aria-live="polite" data-assessment-context-status></p>
    <section class="assessment-handoff wide" data-assessment-handoff hidden aria-labelledby="assessment-handoff-title">
      <div><p class="eyebrow">{locale === 'es' ? 'Diagnóstico recuperado' : 'Assessment recovered'}</p><h3 id="assessment-handoff-title">{locale === 'es' ? 'No tienes que empezar de nuevo.' : 'You do not have to start again.'}</h3><p>{locale === 'es' ? 'Hemos precargado la recomendación y la escala. Puedes corregirlas abajo; las demás respuestas solo se adjuntarán cuando envíes este formulario.' : 'We prefilled the recommendation and scale. You can edit them below; the remaining answers are attached only when you submit this form.'}</p></div>
      <details><summary>{locale === 'es' ? 'Revisar el contexto que se adjuntará' : 'Review the context that will be attached'}<span aria-hidden="true">+</span></summary><dl data-assessment-summary></dl></details>
      <button class="text-link" type="button" data-assessment-discard>{locale === 'es' ? 'No adjuntar estas respuestas' : 'Do not attach these answers'}</button>
    </section>
    <p class="form-expectation wide">{c.contact.expectation}</p>
    <label>{locale === 'es' ? 'Nombre' : 'Name'}<input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>{locale === 'es' ? 'Empresa o alojamiento' : 'Business or stay'}<input name="businessName" required maxlength="160" autocomplete="organization" /></label>
    <label>Email<input name="email" required type="email" maxlength="200" autocomplete="email" /></label>
    <label>{locale === 'es' ? 'Teléfono (opcional)' : 'Phone (optional)'}<input name="phone" maxlength="60" autocomplete="tel" /></label>
    <label>{locale === 'es' ? 'Tipo' : 'Type'}<select name="accommodationType" required><option value="apartment">{locale === 'es' ? 'Piso turístico' : 'Holiday apartment'}</option><option value="rural">{locale === 'es' ? 'Casas rurales' : 'Rural stays'}</option><option value="hotel">Hotel</option></select></label>
    <label>{locale === 'es' ? 'Plan de interés' : 'Plan of interest'}<select name="plan"><option value="">—</option><option value="basico">{locale === 'es' ? 'Básico' : 'Basic'}</option><option value="gestion">{locale === 'es' ? 'Gestión' : 'Management'}</option><option value="inteligente">{locale === 'es' ? 'Inteligente' : 'Intelligent'}</option></select></label>
    <label>{locale === 'es' ? 'Propiedades' : 'Properties'}<input name="propertyCount" type="number" min="1" max="10000" value="1" required /></label>
    <label>{locale === 'es' ? 'Unidades' : 'Units'}<input name="unitCount" type="number" min="1" max="100000" value="1" required /></label>
    <label class="wide">{locale === 'es' ? 'Qué quieres poner en marcha' : 'What do you want to launch'}<textarea name="message" rows="5" maxlength="2000" placeholder={locale === 'es' ? 'Cuéntanos qué gestionas hoy, qué te frena y qué te gustaría conectar.' : 'Tell us what you manage today, what gets in the way and what you would like to connect.'}></textarea></label>
    <label class="honeypot" inert aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /></label>
    <label class="check wide"><input name="accept" type="checkbox" required /><span>{locale === 'es' ? <>He leído la <a href="/privacidad/" target="_blank" rel="noopener noreferrer">política de privacidad</a> y acepto que Logic2B use estos datos para responder.</> : <>I have read the <a href="/en/privacidad/" target="_blank" rel="noopener noreferrer">privacy policy</a> and accept that Logic2B uses these details to reply.</>}</span></label>
    <label class="check wide"><input name="marketingConsent" type="checkbox" /><span>{locale === 'es' ? 'También quiero recibir seguimiento comercial relevante (opcional).' : 'I would also like to receive relevant commercial follow-up (optional).'}</span></label>
    <div class="wide"><button class="pill" type="submit"><span>{c.contact.submit}</span><span aria-hidden="true">→</span></button></div>
    <p class="form-status wide" role="status" aria-live="polite"></p>
    <section class="lead-receipt wide" data-lead-receipt hidden tabindex="-1" role="status" aria-live="polite" aria-atomic="true" aria-labelledby="lead-receipt-title">
      <span class="receipt-mark" aria-hidden="true">✓</span>
      <div><p class="eyebrow">{locale === 'es' ? 'Solicitud recibida' : 'Request received'}</p><h3 id="lead-receipt-title">{c.contact.receiptTitle}</h3><p>{c.contact.receiptBody}</p><p class="receipt-reference" data-lead-reference hidden><span>{c.contact.reference}</span><code data-lead-reference-value></code></p><p data-meeting-copy>{c.contact.meetingFallback}</p><a class="text-link" data-meeting-link hidden target="_blank" rel="noopener noreferrer" data-track="meeting_click" data-section="homepage_contact">{c.contact.meetingCta} <span aria-hidden="true">→</span></a></div>
    </section>
  </form></div>
</section>

<script is:inline define:vars={{ locale, sending: c.contact.sending, ok: c.contact.ok, error: c.contact.error, timeout: c.contact.timeout, rateLimited: c.contact.rateLimited, retrying: c.contact.retrying, submit: c.contact.submit, meetingAvailable: c.contact.meetingAvailable, meetingFallback: c.contact.meetingFallback, leadRequestTimeoutMs }}>
  const form = document.querySelector('[data-lead]');
  const status = form?.querySelector('.form-status');
  const receipt = form?.querySelector('[data-lead-receipt]');
  document.querySelectorAll('[data-plan]').forEach((link) => link.addEventListener('click', () => {
    const plan = form?.querySelector('[name=plan]');
    if (plan && link.dataset.plan) plan.value = link.dataset.plan;
  }));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const button = form.querySelector('button[type=submit]'); const label = button?.querySelector('span');
    if (button) button.disabled = true; if (label) label.textContent = sending; if (status) status.textContent = '';
    const d = Object.fromEntries(new FormData(form));
    const assessmentFields = window.estanciaAssessment?.leadFields() || {};
    const payload = { ...d, ...assessmentFields, propertyCount: Number(d.propertyCount), unitCount: Number(d.unitCount), accept: d.accept === 'on', marketingConsent: d.marketingConsent === 'on', lang: locale, sourcePath: assessmentFields.sourcePath || location.pathname };
    const controller = new AbortController();
    const requestTimeout = setTimeout(() => controller.abort(), leadRequestTimeoutMs);
    let retryAfter = 0;
    try {
      const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload), signal: controller.signal });
      const result = await response.json().catch(() => ({}));
      if (response.status === 429) {
        const delay = Number(result.retryAfter ?? response.headers.get('retry-after'));
        retryAfter = Number.isFinite(delay) ? Math.min(60, Math.max(1, Math.ceil(delay))) : 60;
        throw new Error('rate_limited');
      }
      if (!response.ok || !['delivered', 'delivered_degraded'].includes(result.outcome)) throw new Error('delivery');
      const reference = typeof result.ref === 'string' && /^[a-zA-Z0-9-]{1,100}$/.test(result.ref) ? result.ref : null;
      let meetingUrl = null;
      try { const candidate = new URL(result.meetingUrl); if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) meetingUrl = candidate.href; } catch {}
      const referenceRow = receipt?.querySelector('[data-lead-reference]');
      const referenceValue = receipt?.querySelector('[data-lead-reference-value]');
      const meetingCopy = receipt?.querySelector('[data-meeting-copy]');
      const meetingLink = receipt?.querySelector('[data-meeting-link]');
      if (referenceRow) referenceRow.hidden = !reference;
      if (referenceValue) referenceValue.textContent = reference || '';
      if (meetingCopy) meetingCopy.textContent = meetingUrl ? meetingAvailable : meetingFallback;
      if (meetingLink) { meetingLink.hidden = !meetingUrl; if (meetingUrl) meetingLink.href = meetingUrl; else meetingLink.removeAttribute('href'); }
      form.reset(); window.estanciaAssessment?.clear();
      form.dataset.submitted = 'true';
      if (status) status.textContent = ok;
      if (receipt) { receipt.hidden = false; receipt.focus(); }
      window.estanciaTrack?.('lead_submit', { locale, plan: payload.plan || 'none', source_section: 'homepage_contact' });
    }
    catch (failure) {
      if (status) status.textContent = controller.signal.aborted ? timeout : failure instanceof Error && failure.message === 'rate_limited' ? rateLimited.replace('{seconds}', String(retryAfter)) : error;
    }
    finally {
      clearTimeout(requestTimeout);
      if (button && !form.dataset.submitted && retryAfter > 0) {
        let remaining = retryAfter;
        const updateRetry = () => { if (label) label.textContent = retrying.replace('{seconds}', String(remaining)); };
        updateRetry();
        const retryTimer = setInterval(() => {
          remaining -= 1;
          if (remaining > 0) updateRetry();
          else { clearInterval(retryTimer); button.disabled = false; if (label) label.textContent = submit; }
        }, 1_000);
      }
      else { if (button && !form.dataset.submitted) button.disabled = false; if (label) label.textContent = submit; }
    }
  });
</script>

<script>
  import '../scripts/assessment-context';
  import '../scripts/scope-estimator';
</script>
