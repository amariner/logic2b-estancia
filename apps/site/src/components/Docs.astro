---
import type { Locale } from '@logic-estancia/config';
import { getGuidePortfolio, getPublishedGuides } from '../guide-portfolio';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const guides = getGuidePortfolio(locale);
const publishedCount = getPublishedGuides(locale).length;
const implementation = en ? [
  ['01', 'Inputs', 'Goals, current process, accountable people and candidate sources. No credential is requested until the scope needs it.'],
  ['02', 'Decisions', 'Capability, source of truth, permissions and acceptance owner are agreed before implementation.'],
  ['03', 'Tests', 'Fixtures, expected journeys, security, accessibility and failure states turn the promise into checkable evidence.'],
  ['04', 'Supervised publication', 'A person accepts the result, the change window and rollback before anything moves to a live environment.'],
  ['05', 'Support', 'Ownership, escalation, observation and review cadence remain visible after publication.'],
  ['06', 'Outside the scope', 'Legal advice, payments, guest reporting, live integrations and forecasting require separate validation.'],
] : [
  ['01', 'Entradas', 'Objetivos, proceso actual, responsables y fuentes candidatas. No se pide una credencial hasta que el alcance la necesite.'],
  ['02', 'Decisiones', 'Capacidad, fuente de verdad, permisos y responsable de aceptación se acuerdan antes de implementar.'],
  ['03', 'Pruebas', 'Fixtures, recorridos esperados, seguridad, accesibilidad y fallos convierten la promesa en evidencia comprobable.'],
  ['04', 'Publicación supervisada', 'Una persona acepta el resultado, la ventana de cambio y la reversión antes de pasar a un entorno real.'],
  ['05', 'Soporte', 'Responsabilidad, escalado, observación y ritmo de revisión siguen visibles después de publicar.'],
  ['06', 'Fuera de alcance', 'Asesoría legal, pagos, registro de viajeros, integraciones reales y previsión requieren validación separada.'],
];
---

<div data-guide-portfolio>
  <section class="guide-hero section">
    <div class="shell guide-hero-grid">
      <div><p class="eyebrow">{en ? 'Guides by responsibility' : 'Guías por responsabilidad'}</p><h1 class="display">{en ? 'Decide who owns the outcome before choosing what to connect.' : 'Decide quién responde del resultado antes de elegir qué conectar.'}</h1></div>
      <div><p>{en ? 'Five Logic2B Estancias role-based guides turn a commercial promise into decisions, evidence and human handoffs. Only guides with complete content and verifiable routes count as published.' : 'Cinco guías por rol de Logic2B Estancias convierten una promesa comercial en decisiones, evidencia y relevos humanos. Solo cuentan como publicadas las guías con contenido completo y recorridos comprobables.'}</p><dl><div><dt>{en ? 'Published now' : 'Publicadas ahora'}</dt><dd>{publishedCount}/5</dd></div><div><dt>{en ? 'Live operations' : 'Operaciones reales'}</dt><dd>{en ? 'None' : 'Ninguna'}</dd></div></dl></div>
    </div>
  </section>

  <section class="section guide-catalog" aria-labelledby="guide-catalog-title">
    <div class="shell">
      <div class="guide-section-heading"><div><p class="eyebrow">{en ? 'A shared operating language' : 'Un lenguaje operativo compartido'}</p><h2 id="guide-catalog-title" class="heading">{en ? 'Start with the people who must make and review the decision.' : 'Empieza por las personas que deben decidir y revisar.'}</h2></div><p>{en ? 'Ownership and direction, reservations and reception, operations, and marketing and revenue are ready to explore. Technical and privacy remains visibly in preparation.' : 'Propiedad y dirección, reservas y recepción, operaciones, y marketing e ingresos ya se pueden explorar. Técnica y privacidad permanece visiblemente en preparación.'}</p></div>
      <div class="guide-grid">
        {guides.map((guide) => (
          <article class:list={['guide-card', { 'is-published': guide.status === 'published' }]} data-guide-card={guide.id} data-guide-status={guide.status}>
            <header><span>{guide.number}</span><small>{guide.statusLabel}</small></header>
            <div class="guide-card-role"><span aria-hidden="true">{guide.status === 'published' ? '↗' : '·'}</span><p>{guide.role}</p></div>
            <h2>{guide.title}</h2><p>{guide.summary}</p>
            <div class="guide-card-question"><strong>{en ? 'Question it resolves' : 'Pregunta que resuelve'}</strong><p>{guide.question}</p></div>
            <footer>{guide.detailHref ? <a class="text-link" href={guide.detailHref} data-guide-open={guide.id}>{en ? 'Open guide' : 'Abrir guía'} <span aria-hidden="true">→</span></a> : <span>{en ? 'Not navigable yet' : 'Todavía no es navegable'}</span>}</footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section guide-implementation" aria-labelledby="implementation-title" data-guide-implementation>
    <div class="shell"><div class="guide-section-heading"><div><p class="eyebrow">{en ? 'Implementation contract' : 'Contrato de implantación'}</p><h2 id="implementation-title" class="heading">{en ? 'Six questions every activation must answer.' : 'Seis preguntas que toda activación debe responder.'}</h2></div><p>{en ? 'This sequence separates a local demonstration from a live service. It is a review framework, not proof that any external system is already connected.' : 'Esta secuencia separa una demostración local de un servicio real. Es un marco de revisión, no la prueba de que ya exista una conexión externa.'}</p></div><ol class="implementation-grid">{implementation.map(([number, title, text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div>
  </section>

  <section class="section shell guide-index-cta" data-commercial-actions><div><p class="eyebrow">{en ? 'Choose by capability' : 'Elige por capacidad'}</p><h2 class="heading">{en ? 'Bring the first decision, not a finished specification.' : 'Trae la primera decisión, no una especificación cerrada.'}</h2><p>{en ? 'The assessment organises needs, responsibilities and the most credible starting plan without collecting personal data.' : 'El diagnóstico ordena necesidades, responsabilidades y el punto de partida más creíble sin recoger datos personales.'}</p></div><a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-guide-assess>{en ? 'Find my starting point' : 'Ver mi punto de partida'} <span aria-hidden="true">→</span></a></section>
</div>
