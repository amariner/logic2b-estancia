---
import type { Locale } from '@logic-estancia/config';
import type { WebPortfolioConcept } from '../web-portfolio';
import WebMiniature from './WebMiniature.astro';
import ThemePreviewDialog from './ThemePreviewDialog.astro';
const { locale, concept, sourcePath } = Astro.props as { locale: Locale; concept: WebPortfolioConcept; sourcePath: '/webs/' | '/en/webs/' };
const en = locale === 'en';
const detailHref = (en ? '/en' : '') + '/temas/' + concept.slug + '/';
const dialogId = 'theme-preview-' + concept.slug;
const headingId = 'portfolio-' + concept.slug + '-title';
---
<article class="portfolio-card card theme-catalog-card" data-portfolio-card={concept.slug} data-portfolio-vertical={concept.vertical} data-portfolio-plan={concept.plan} data-portfolio-search-text={[concept.brand, concept.summary, concept.visualIntent, concept.businessProblem].join(' ')} aria-labelledby={headingId}>
  <button class="catalog-preview-trigger" type="button" data-theme-preview-open={dialogId} aria-controls={dialogId} aria-haspopup="dialog" aria-label={(en ? 'Preview: ' : 'Vista previa: ') + concept.brand}><WebMiniature concept={concept} /><span class="catalog-preview-hint">{en ? 'Preview' : 'Vista previa'} ↗</span></button>
  <div class="catalog-card-caption"><div><p>{concept.verticalLabel} · {concept.planLabel}</p><h2 id={headingId}>{concept.brand}</h2></div><a href={detailHref} data-portfolio-open={concept.slug} data-portfolio-detail={concept.slug} aria-label={(en ? 'More information: ' : 'Más información: ') + concept.brand}>↗</a></div>
</article>
<ThemePreviewDialog locale={locale} concept={concept} sourcePath={sourcePath} />
