---
import type { Locale } from '@logic-estancia/config';
import { getPlanCards, planHandoffHref } from '../plan-contract';
import type { PortfolioVertical, WebPortfolioConcept } from '../web-portfolio';

const { locale, concept, sourcePath } = Astro.props as { locale: Locale; concept: WebPortfolioConcept; sourcePath: '/webs/' | '/en/webs/' };
const plan = getPlanCards(locale).find((candidate) => candidate.id === concept.plan);
if (!plan) throw new Error(`missing_plan_for_portfolio:${concept.slug}`);
const panelHref = plan.panelSlug === 'none' ? null : `${locale === 'en' ? '/en' : ''}/demos/${plan.panelSlug}/gestion/?vista=home`;
const assessmentHref = planHandoffHref(locale, plan, sourcePath, concept.vertical as PortfolioVertical);
const headingId = `portfolio-${concept.slug}-title`;
---
<article class="portfolio-card card" data-portfolio-card={concept.slug} data-portfolio-vertical={concept.vertical} data-portfolio-plan={concept.plan} aria-labelledby={headingId}>
  <div class="portfolio-card-top"><span class="portfolio-number">{concept.number}</span><span class="portfolio-status">{concept.statusLabel}</span></div>
  <div class="portfolio-card-heading"><div><p class="eyebrow">{concept.verticalLabel} · {concept.planLabel}</p><h2 id={headingId}>{concept.brand}</h2></div><span class="portfolio-arrow" aria-hidden="true">↗</span></div>
  <p class="portfolio-card-summary">{concept.summary}</p>
  <a class="portfolio-card-media" href={concept.demoHref} aria-label={`${concept.demoCta}: ${concept.brand}`} data-portfolio-demo={concept.slug}>
    <img src={concept.image} alt={concept.imageAlt} width="2016" height="1344" loading="lazy" decoding="async" />
  </a>
  <div class="portfolio-card-detail"><div><p class="eyebrow">{locale === 'en' ? 'Visual intent' : 'Intención visual'}</p><p>{concept.visualIntent}</p></div><div><p class="eyebrow">{locale === 'en' ? 'Business problem' : 'Problema de negocio'}</p><p>{concept.businessProblem}</p></div></div>
  <div class="portfolio-card-detail"><p class="eyebrow">{concept.visibleLabel}</p><ul>{concept.visiblePages.map((page) => <li>{page}</li>)}</ul></div>
  <p class="portfolio-card-boundary"><strong>{concept.boundaryLabel}:</strong> {concept.boundary}</p>
  <div class="portfolio-card-links"><div><a class="text-link" href={concept.demoHref} data-portfolio-open={concept.slug}>{concept.demoCta} <span aria-hidden="true">→</span></a>{panelHref && <a class="text-link" href={panelHref} data-portfolio-panel={concept.slug}>{locale === 'en' ? 'View workspace' : 'Ver gestor'} <span aria-hidden="true">→</span></a>}</div><a class="pill" href={assessmentHref} data-portfolio-assess={concept.slug}>{concept.assessmentCta} <span aria-hidden="true">→</span></a></div>
</article>

