---
import type { Locale } from '@logic-estancia/config';
import { getCommercialTour } from '../commercial-tour';
import PanelPreview from './PanelPreview.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const steps = getCommercialTour(locale);
const labels = en ? {
  eyebrow: 'Three-minute product journey',
  title: 'Follow one stay from its website to the decisions behind it.',
  intro: 'Five verified moments connect Basic, Management and Intelligent without turning the demonstration into a live booking, message, payment or integration.',
  duration: 'About 3 minutes',
  start: 'Start the guided journey',
  overview: 'What you will inspect',
  boundary: 'Commercial walkthrough · fictitious evidence · no external product effects',
  progress: 'Journey progress',
  step: 'Step',
  of: 'of',
  decision: 'Decision in view',
  outcome: 'What the evidence proves',
  boundaryLabel: 'Where the evidence stops',
  detail: 'Review commercial context',
  exact: 'Open exact local evidence',
  newTab: 'opens in a new tab',
  evidenceNote: 'Opening evidence does not complete the journey. Return to this tab to continue.',
  previous: 'Previous step',
  next: 'Next step',
  complete: 'Complete the journey',
  completeEyebrow: 'Journey completed',
  completeTitle: 'You have seen the product boundary from presence to operations.',
  completeBody: 'The next useful step is to compare the three layers or assess which capabilities your business needs first. Contact remains the only route that can submit a real commercial request.',
  review: 'Review the journey again',
  plans: 'Compare plans',
  assessment: 'Start the assessment',
  contact: 'Talk to Logic2B',
  noScript: 'The five moments remain readable below. Interactive progress and measurement require JavaScript; all evidence links still work.',
} : {
  eyebrow: 'Recorrido de producto en tres minutos',
  title: 'Sigue una estancia desde su web hasta las decisiones que la preparan.',
  intro: 'Cinco momentos verificados conectan Básico, Gestión e Inteligente sin convertir la demostración en reserva, mensaje, pago o integración real.',
  duration: 'Unos 3 minutos',
  start: 'Empezar el recorrido guiado',
  overview: 'Qué vas a inspeccionar',
  boundary: 'Recorrido comercial · evidencia ficticia · sin efectos externos de producto',
  progress: 'Progreso del recorrido',
  step: 'Paso',
  of: 'de',
  decision: 'Decisión a la vista',
  outcome: 'Qué demuestra la evidencia',
  boundaryLabel: 'Dónde termina la evidencia',
  detail: 'Revisar contexto comercial',
  exact: 'Abrir evidencia local exacta',
  newTab: 'se abre en otra pestaña',
  evidenceNote: 'Abrir evidencia no completa el recorrido. Vuelve a esta pestaña para continuar.',
  previous: 'Paso anterior',
  next: 'Siguiente paso',
  complete: 'Completar el recorrido',
  completeEyebrow: 'Recorrido completado',
  completeTitle: 'Has visto el límite del producto desde la presencia hasta la operación.',
  completeBody: 'El siguiente paso útil es comparar las tres capas o evaluar qué capacidades necesita primero tu negocio. Contacto sigue siendo la única ruta capaz de enviar una solicitud comercial real.',
  review: 'Revisar el recorrido de nuevo',
  plans: 'Comparar planes',
  assessment: 'Empezar el diagnóstico',
  contact: 'Hablar con Logic2B',
  noScript: 'Los cinco momentos siguen siendo legibles a continuación. El progreso interactivo y la medición requieren JavaScript; todos los enlaces de evidencia siguen funcionando.',
};
---

<article class="commercial-tour" data-commercial-tour data-state="ready">
  <header class="commercial-tour-hero section shell">
    <div>
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1 class="display">{labels.title}</h1>
      <p>{labels.intro}</p>
      <div class="commercial-tour-start">
        <button class="pill" type="button" data-tour-start data-track="tour_start" data-flow="guided" data-section="guided_tour">{labels.start} <span aria-hidden="true">→</span></button>
        <span>{labels.duration}</span>
      </div>
      <p class="commercial-tour-boundary" role="note">{labels.boundary}</p>
    </div>
    <aside aria-labelledby="commercial-tour-overview-title">
      <p id="commercial-tour-overview-title">{labels.overview}</p>
      <ol>{steps.map((step) => <li><span>{step.number}</span><div><strong>{step.phase}</strong><small>{step.title} · {step.planLabel}</small></div></li>)}</ol>
    </aside>
  </header>

  <noscript><style>.commercial-tour-start{display:none!important}</style><p class="shell commercial-tour-noscript">{labels.noScript}</p></noscript>

  <section class="commercial-tour-workspace section" data-tour-workspace aria-live="polite">
    <div class="shell">
      <header class="commercial-tour-progress">
        <div>
          <p>{labels.progress}</p>
          <strong data-tour-progress-text>{labels.step} 1 {labels.of} {steps.length}</strong>
        </div>
        <div class="commercial-tour-progress-track" role="progressbar" aria-label={labels.progress} aria-valuemin="1" aria-valuemax={steps.length} aria-valuenow="1" data-tour-progress><i></i></div>
      </header>

      <div class="commercial-tour-step-list">
        {steps.map((step, index) => (
          <section class="commercial-tour-step" data-tour-step={step.id} data-step-index={index} aria-labelledby={`commercial-tour-step-${step.id}`}>
            <div class="commercial-tour-step-copy">
              <p class="eyebrow">{step.number} · {step.phase}</p>
              <h2 id={`commercial-tour-step-${step.id}`} class="heading" tabindex="-1">{step.title}</h2>
              <p class="commercial-tour-summary">{step.summary}</p>
              <dl>
                <div><dt>{labels.decision}</dt><dd>{step.decision}</dd></div>
                <div><dt>{labels.outcome}</dt><dd>{step.outcome}</dd></div>
                <div><dt>{labels.boundaryLabel}</dt><dd>{step.boundary}</dd></div>
              </dl>
              <div class="commercial-tour-evidence">
                <a class="text-link" href={step.detailHref} target="_blank" rel="noopener noreferrer">{labels.detail} <span class="sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span></a>
                <a class="text-link" href={step.evidenceHref} target="_blank" rel="noopener noreferrer">{labels.exact} <span class="sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span></a>
              </div>
              <p class="commercial-tour-evidence-note">{labels.evidenceNote}</p>
            </div>
            <div class="commercial-tour-step-visual">
              <p><span>{step.planLabel}</span><small>{step.kind === 'web' ? (en ? 'Website evidence' : 'Evidencia web') : (en ? 'Workspace evidence' : 'Evidencia de gestor')}</small></p>
              {step.kind === 'web'
                ? <picture><source type="image/avif" srcset="/media/nivora/hero-640.avif 640w, /media/nivora/hero-960.avif 960w" sizes="(max-width: 800px) calc(100vw - 48px), 48vw" /><img src={step.image} alt={step.imageAlt} width="2016" height="1344" loading="eager" decoding="async" /></picture>
                : <PanelPreview locale={locale} kind={step.preview} compact />}
            </div>
          </section>
        ))}
      </div>

      <nav class="commercial-tour-controls" aria-label={labels.progress}>
        <button type="button" data-tour-previous>{labels.previous}</button>
        <button class="pill" type="button" data-tour-next>{labels.next} <span aria-hidden="true">→</span></button>
        <button class="pill" type="button" data-tour-complete data-track="tour_complete" data-flow="guided" data-section="guided_tour">{labels.complete} <span aria-hidden="true">✓</span></button>
      </nav>
    </div>
  </section>

  <section class="commercial-tour-complete section shell" data-tour-completion aria-labelledby="commercial-tour-complete-title" data-commercial-actions>
    <div>
      <p class="eyebrow">{labels.completeEyebrow}</p>
      <h2 id="commercial-tour-complete-title" class="heading" tabindex="-1">{labels.completeTitle}</h2>
      <p>{labels.completeBody}</p>
    </div>
    <div class="commercial-tour-complete-actions">
      <a class="text-link" href={`${prefix}/${en ? 'plans' : 'planes'}/`} data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.plans} <span aria-hidden="true">→</span></a>
      <a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.assessment} <span aria-hidden="true">→</span></a>
      <a class="text-link" href={`${prefix}/#contacto`} data-contact-trigger data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.contact} <span aria-hidden="true">→</span></a>
      <button type="button" data-tour-review>{labels.review}</button>
    </div>
  </section>
</article>

<script>
  const tour = document.querySelector<HTMLElement>('[data-commercial-tour]');
  const workspace = tour?.querySelector<HTMLElement>('[data-tour-workspace]');
  const completion = tour?.querySelector<HTMLElement>('[data-tour-completion]');
  const start = tour?.querySelector<HTMLButtonElement>('[data-tour-start]');
  const previous = tour?.querySelector<HTMLButtonElement>('[data-tour-previous]');
  const next = tour?.querySelector<HTMLButtonElement>('[data-tour-next]');
  const complete = tour?.querySelector<HTMLButtonElement>('[data-tour-complete]');
  const review = tour?.querySelector<HTMLButtonElement>('[data-tour-review]');
  const progress = tour?.querySelector<HTMLElement>('[data-tour-progress]');
  const progressText = tour?.querySelector<HTMLElement>('[data-tour-progress-text]');
  const stepPanels = [...(tour?.querySelectorAll<HTMLElement>('[data-tour-step]') ?? [])];
  let currentStep = 0;

  function showStep(index: number, moveFocus = true) {
    if (!tour || !workspace || !completion || !previous || !next || !complete || !progress || !progressText || stepPanels.length === 0) return;
    currentStep = Math.max(0, Math.min(stepPanels.length - 1, index));
    tour.dataset.state = 'active';
    workspace.hidden = false;
    completion.hidden = true;
    if (start) start.hidden = true;
    stepPanels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== currentStep; });
    previous.hidden = currentStep === 0;
    next.hidden = currentStep === stepPanels.length - 1;
    complete.hidden = currentStep !== stepPanels.length - 1;
    progress.setAttribute('aria-valuenow', String(currentStep + 1));
    progress.style.setProperty('--tour-progress', `${((currentStep + 1) / stepPanels.length) * 100}%`);
    progressText.textContent = `${tour.dataset.stepLabel} ${currentStep + 1} ${tour.dataset.ofLabel} ${stepPanels.length}`;
    if (moveFocus) stepPanels[currentStep]?.querySelector<HTMLElement>('h2')?.focus();
  }

  if (tour && workspace && completion) {
    tour.dataset.enhanced = 'true';
    tour.dataset.stepLabel = tour.querySelector('[data-tour-progress-text]')?.textContent?.split(' ')[0] ?? '';
    tour.dataset.ofLabel = tour.querySelector('[data-tour-progress-text]')?.textContent?.split(' ')[2] ?? '';
    workspace.hidden = true;
    completion.hidden = true;
    stepPanels.forEach((panel) => { panel.hidden = true; });
  }

  start?.addEventListener('click', () => {
    showStep(0);
    setTimeout(() => start.removeAttribute('data-track'), 0);
  });
  previous?.addEventListener('click', () => showStep(currentStep - 1));
  next?.addEventListener('click', () => showStep(currentStep + 1));
  complete?.addEventListener('click', () => {
    if (!tour || !workspace || !completion) return;
    tour.dataset.state = 'complete';
    workspace.hidden = true;
    completion.hidden = false;
    completion.querySelector<HTMLElement>('h2')?.focus();
    setTimeout(() => complete.removeAttribute('data-track'), 0);
  });
  review?.addEventListener('click', () => showStep(0));
</script>
