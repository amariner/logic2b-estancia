---
import type { Locale } from '@logic-estancia/config';
import { getCommercialTour, type CommercialTourStepId } from '../commercial-tour';
import { tourAssessmentHref } from '../tour-entry';
import PanelPreview from './PanelPreview.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const steps = getCommercialTour(locale);
const questions: Record<CommercialTourStepId, string> = en ? {
  'brand-web': 'How would my stay look online?',
  enquiries: 'What does this enquiry need?',
  planning: 'Which dates could I offer?',
  preparation: 'What is left before the arrival?',
  operations: 'How is my accommodation doing?',
} : {
  'brand-web': '¿Cómo se vería mi alojamiento?',
  enquiries: '¿Qué necesita esta consulta?',
  planning: '¿Qué fechas puedo ofrecer?',
  preparation: '¿Qué falta antes de la llegada?',
  operations: '¿Cómo va mi alojamiento?',
};
const labels = en ? {
  eyebrow: 'A look in three minutes',
  title: 'From your website to the day ahead.',
  intro: 'Explore a website, an enquiry and the work behind them. Three separate fictional examples; start with what matters to you.',
  duration: 'About 3 minutes',
  start: 'Start the guided journey',
  overview: 'What you will see',
  boundary: 'Fictional demo · no live bookings or messages',
  progress: 'Journey progress',
  step: 'Step',
  of: 'of',
  decision: 'What it helps with',
  outcome: 'What this shows',
  more: 'What you can explore',
  detail: 'Explore this feature',
  exact: 'Try the demo',
  newTab: 'opens in a new tab',
  evidenceNote: 'The demo opens in another tab. You can return here at any time.',
  previous: 'Previous step',
  next: 'Next step',
  complete: 'Complete the journey',
  completeEyebrow: 'Journey completed',
  completeTitle: 'Where would you like to start?',
  completeBody: 'Compare the plans or get a recommendation for your accommodation. If you already have a question, we can talk it through.',
  review: 'Review the journey again',
  plans: 'Compare plans',
  assessment: 'Start the assessment',
  contact: 'Talk to Logic2B',
  noScript: 'Explore the five stages below. You can open each demo directly.',
} : {
  eyebrow: 'Un vistazo en tres minutos',
  title: 'De tu web al día a día.',
  intro: 'Explora una web, una consulta y el trabajo que hay detrás. Tres ejemplos ficticios e independientes; empieza por lo que te interesa.',
  duration: 'Unos 3 minutos',
  start: 'Empezar el recorrido guiado',
  overview: 'Qué vas a ver',
  boundary: 'Demo ficticia · sin reservas ni mensajes reales',
  progress: 'Progreso del recorrido',
  step: 'Paso',
  of: 'de',
  decision: 'Para qué sirve',
  outcome: 'Qué te muestra',
  more: 'Qué puedes comprobar',
  detail: 'Conocer esta función',
  exact: 'Probar la demo',
  newTab: 'se abre en otra pestaña',
  evidenceNote: 'La demo se abre en otra pestaña. Puedes volver aquí cuando quieras.',
  previous: 'Paso anterior',
  next: 'Siguiente paso',
  complete: 'Completar el recorrido',
  completeEyebrow: 'Recorrido completado',
  completeTitle: '¿Por dónde quieres empezar?',
  completeBody: 'Compara los planes o recibe una recomendación para tu alojamiento. Si ya tienes una pregunta, podemos hablarla contigo.',
  review: 'Revisar el recorrido de nuevo',
  plans: 'Comparar planes',
  assessment: 'Empezar el diagnóstico',
  contact: 'Hablar con Logic2B',
  noScript: 'Explora las cinco etapas a continuación. Puedes abrir cada demo directamente.',
};
---

<article class="commercial-tour" data-commercial-tour data-state="ready" data-locale={locale}>
  <header class="commercial-tour-hero section shell">
    <div>
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1 class="display">{labels.title}</h1>
      <p>{labels.intro}</p>
      <label class="tour-entry-label">{en ? 'Which question would you like to explore first?' : '¿Qué pregunta quieres explorar primero?'}
        <select data-tour-entry>{steps.map(step => <option value={step.id}>{questions[step.id]}</option>)}</select>
      </label>
      <div class="commercial-tour-start">
        <button class="pill" type="button" data-tour-start data-track="tour_start" data-flow="guided" data-section="guided_tour">{labels.start} <span aria-hidden="true">→</span></button>
        <span>{labels.duration}</span>
      </div>
      <p class="commercial-tour-boundary" role="note">{labels.boundary}</p>
    </div>
    <aside aria-labelledby="commercial-tour-overview-title">
      <p id="commercial-tour-overview-title">{labels.overview}</p>
      <ol>{steps.map((step) => <li><span>{step.number}</span><div><strong>{step.phase}</strong><small>{step.title} · {step.planLabel}</small></div></li>)}</ol>
    </aside>
  </header>

  <noscript><style>.commercial-tour-start,.tour-entry-label{display:none!important}</style><p class="shell commercial-tour-noscript">{labels.noScript}</p></noscript>

  <section class="commercial-tour-workspace section" data-tour-workspace aria-live="polite">
    <div class="shell">
      <header class="commercial-tour-progress">
        <div>
          <p>{labels.progress}</p>
          <strong data-tour-progress-text>{labels.step} 1 {labels.of} {steps.length}</strong>
          <p data-tour-seen data-seen-label={en ? "stages explored" : "etapas vistas"}>0 / 5</p>
        </div>
        <div class="commercial-tour-progress-track" role="progressbar" aria-label={labels.progress} aria-valuemin="0" aria-valuemax={steps.length} aria-valuenow="0" data-tour-progress><i></i></div>
      </header>

      <div class="commercial-tour-step-list">
        {steps.map((step, index) => (
          <section class="commercial-tour-step" data-tour-step={step.id} data-step-index={index} aria-labelledby={`commercial-tour-step-${step.id}`}>
            <div class="commercial-tour-step-copy">
              <p class="eyebrow">{step.number} · {step.phase}</p>
              <h2 id={`commercial-tour-step-${step.id}`} class="heading" tabindex="-1">{step.title}</h2>
              <p class="commercial-tour-summary">{step.summary}</p>
              <p class="tour-step-boundary" role="note">{step.boundary}</p>
              <details class="tour-step-details">
                <summary>{labels.more}</summary>
                <dl>
                  <div><dt>{labels.decision}</dt><dd>{step.decision}</dd></div>
                  <div><dt>{labels.outcome}</dt><dd>{step.outcome}</dd></div>
                </dl>
              </details>
              <div class="commercial-tour-evidence">
                <a class="text-link" href={step.detailHref} target="_blank" rel="noopener noreferrer">{labels.detail} <span class="sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span></a>
                <a class="text-link" href={step.evidenceHref} target="_blank" rel="noopener noreferrer">{labels.exact} <span class="sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span></a>
              </div>
              <p class="commercial-tour-evidence-note">{labels.evidenceNote}</p>
              <a class="pill" href={tourAssessmentHref(locale, step.id, en ? '/en/journey/' : '/recorrido/')} data-tour-assess={step.id}>{en ? 'Assess this need · no sign-up' : 'Evaluar esta necesidad · sin registro'} →</a>
            </div>
            <div class="commercial-tour-step-visual">
              <p><span>{step.planLabel}</span><small>{step.kind === 'web' ? (en ? 'Website demo' : 'Web de muestra') : (en ? 'Workspace demo' : 'Gestor de muestra')}</small></p>
              {step.kind === 'web'
                ? <picture><source type="image/avif" srcset="/media/nivora/hero-morning-640.avif 640w, /media/nivora/hero-morning-960.avif 960w" sizes="(max-width: 800px) calc(100vw - 48px), 48vw" /><img src={step.image} alt={step.imageAlt} width="2016" height="1344" loading="eager" decoding="async" /></picture>
                : <PanelPreview locale={locale} kind={step.preview} compact />}
            </div>
          </section>
        ))}
      </div>

      <nav class="commercial-tour-controls" aria-label={labels.progress}>
        <button type="button" data-tour-previous>{labels.previous}</button>
        <button class="pill" type="button" data-tour-next>{labels.next} <span aria-hidden="true">→</span></button>
        <button class="pill" type="button" data-tour-complete data-track="tour_complete" data-flow="guided" data-section="guided_tour">{labels.complete} <span aria-hidden="true">✓</span></button>
      </nav>
    </div>
  </section>

  <section class="commercial-tour-complete section shell" data-tour-completion aria-labelledby="commercial-tour-complete-title" data-commercial-actions>
    <div>
      <p class="eyebrow">{labels.completeEyebrow}</p>
      <h2 id="commercial-tour-complete-title" class="heading" tabindex="-1">{labels.completeTitle}</h2>
      <p>{labels.completeBody}</p>
    </div>
    <div class="commercial-tour-complete-actions">
      <a class="text-link" href={`${prefix}/${en ? 'plans' : 'planes'}/`} data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.plans} <span aria-hidden="true">→</span></a>
      <a class="pill" href={`${prefix}/${en ? 'assessment' : 'diagnostico'}/`} data-tour-complete-assess data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.assessment} <span aria-hidden="true">→</span></a>
      <a class="text-link" href={`${prefix}/#contacto`} data-contact-trigger data-track="cta_click" data-flow="guided" data-section="guided_tour">{labels.contact} <span aria-hidden="true">→</span></a>
      <button type="button" data-tour-review>{labels.review}</button>
    </div>
  </section>
</article>

<script>
  import { COMMERCIAL_TOUR_STEP_IDS } from '../commercial-tour';
  import { parseTourEntry, tourAssessmentHref } from '../tour-entry';
  const tour = document.querySelector<HTMLElement>('[data-commercial-tour]');
  const workspace = tour?.querySelector<HTMLElement>('[data-tour-workspace]');
  const completion = tour?.querySelector<HTMLElement>('[data-tour-completion]');
  const start = tour?.querySelector<HTMLButtonElement>('[data-tour-start]');
  const previous = tour?.querySelector<HTMLButtonElement>('[data-tour-previous]');
  const next = tour?.querySelector<HTMLButtonElement>('[data-tour-next]');
  const complete = tour?.querySelector<HTMLButtonElement>('[data-tour-complete]');
  const review = tour?.querySelector<HTMLButtonElement>('[data-tour-review]');
  const progress = tour?.querySelector<HTMLElement>('[data-tour-progress]');
  const progressText = tour?.querySelector<HTMLElement>('[data-tour-progress-text]');
  const stepPanels = [...(tour?.querySelectorAll<HTMLElement>('[data-tour-step]') ?? [])];
  const locale = tour?.dataset.locale === 'en' ? 'en' : 'es';
  const entry = parseTourEntry(new URLSearchParams(location.search), locale);
  const entrySelect = tour?.querySelector<HTMLSelectElement>('[data-tour-entry]');
  if (entrySelect) entrySelect.value = entry.step;
  const seenSteps = new Set<number>();
  let currentStep = 0;
  tour?.querySelectorAll<HTMLAnchorElement>('[data-tour-assess]').forEach(link => {
    const step = COMMERCIAL_TOUR_STEP_IDS.find(id => id === link.dataset.tourAssess);
    if (step) link.href = tourAssessmentHref(locale, step, entry.sourcePath, entry.segment);
  });
  const updateEntry = () => {
    const step = COMMERCIAL_TOUR_STEP_IDS.find(id => id === entrySelect?.value) ?? entry.step;
    const link = tour?.querySelector<HTMLAnchorElement>('[data-tour-complete-assess]');
    if (link) link.href = tourAssessmentHref(locale, step, entry.sourcePath, entry.segment);
  };
  entrySelect?.addEventListener('change', updateEntry);
  updateEntry();

  function showStep(index: number, moveFocus = true) {
    if (!tour || !workspace || !completion || !previous || !next || !complete || !progress || !progressText || stepPanels.length === 0) return;
    currentStep = Math.max(0, Math.min(stepPanels.length - 1, index));
    seenSteps.add(currentStep);
    tour.dataset.state = 'active';
    workspace.hidden = false;
    completion.hidden = true;
    if (start) start.hidden = true;
    stepPanels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== currentStep; });
    previous.hidden = currentStep === 0;
    next.hidden = currentStep === stepPanels.length - 1 && seenSteps.size === stepPanels.length;
    complete.hidden = seenSteps.size !== stepPanels.length;
    progress.setAttribute('aria-valuenow', String(seenSteps.size));
    const seen = tour.querySelector<HTMLElement>('[data-tour-seen]');
    if (seen) seen.textContent = `${seenSteps.size} / ${stepPanels.length} ${seen.dataset.seenLabel}`;
    progress.style.setProperty('--tour-progress', `${(seenSteps.size / stepPanels.length) * 100}%`);
    progressText.textContent = `${tour.dataset.stepLabel} ${currentStep + 1} ${tour.dataset.ofLabel} ${stepPanels.length}`;
    if (moveFocus) stepPanels[currentStep]?.querySelector<HTMLElement>('h2')?.focus();
  }

  if (tour && workspace && completion) {
    tour.dataset.enhanced = 'true';
    tour.dataset.stepLabel = tour.querySelector('[data-tour-progress-text]')?.textContent?.split(' ')[0] ?? '';
    tour.dataset.ofLabel = tour.querySelector('[data-tour-progress-text]')?.textContent?.split(' ')[2] ?? '';
    workspace.hidden = true;
    completion.hidden = true;
    stepPanels.forEach((panel) => { panel.hidden = true; });
  }

  start?.addEventListener('click', () => {
    const index = COMMERCIAL_TOUR_STEP_IDS.findIndex(id => id === entrySelect?.value);
    showStep(Math.max(0, index));
    if (entrySelect) entrySelect.disabled = true;
    setTimeout(() => start.removeAttribute('data-track'), 0);
  });
  previous?.addEventListener('click', () => showStep(currentStep - 1));
  next?.addEventListener('click', () => showStep((currentStep + 1) % stepPanels.length));
  complete?.addEventListener('click', () => {
    if (!tour || !workspace || !completion || seenSteps.size !== stepPanels.length) return;
    tour.dataset.state = 'complete';
    workspace.hidden = true;
    completion.hidden = false;
    completion.querySelector<HTMLElement>('h2')?.focus();
    setTimeout(() => complete.removeAttribute('data-track'), 0);
  });
  review?.addEventListener('click', () => { seenSteps.clear(); showStep(0); });
</script>
<style>
  .tour-entry-label { display:grid; gap:10px; margin-top:24px; font-weight:600; }
  .tour-entry-label select { width:100%; min-width:0; max-width:520px; padding:14px; font:inherit; border:1px solid var(--line); border-radius:12px; background:var(--paper); color:var(--ink); }
  .commercial-tour-step-copy > .pill { margin-top:16px; white-space:normal; }
  .tour-step-boundary { margin:18px 0; padding-left:12px; border-left:2px solid #527458; color:var(--slate); font-size:.75rem; line-height:1.6; }
  .tour-step-details { margin-top:18px; }
  .tour-step-details summary { width:fit-content; min-height:44px; align-content:center; color:var(--ink); font-size:.78rem; font-weight:600; cursor:pointer; }
  .tour-step-details summary:focus-visible { outline:3px solid #be775d; outline-offset:4px; border-radius:3px; }
  .commercial-tour-step .tour-step-details dl { margin-top:8px; }
</style>
