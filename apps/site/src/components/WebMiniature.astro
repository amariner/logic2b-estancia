---
import type { WebPortfolioConcept } from '../web-portfolio';
import { getWebThemeVisual } from '../web-theme-visuals';
const { concept, eager = false } = Astro.props as { concept: WebPortfolioConcept; eager?: boolean };
const visual = getWebThemeVisual(concept.slug);
const heroSource = concept.image.replace(/\.webp$/, '');
---
<div class:list={['web-miniature', `web-miniature-${concept.vertical}`, `miniature-${visual.composition}`]} style={visual.style} data-theme-visual={concept.slug} aria-hidden="true">
  <picture><source type="image/avif" srcset={`${heroSource}-640.avif 640w, ${heroSource}-960.avif 960w`} sizes="(max-width: 760px) 42vw, 280px" /><img src={concept.image} alt="" width="2016" height="1344" loading={eager ? 'eager' : 'lazy'} decoding="async" /></picture>
  <div class="miniature-nav"><span>{concept.brand}</span><i></i><i></i></div>
  <div class="miniature-copy"><small>{concept.verticalLabel}</small><p>{concept.showcase.title}</p></div>
  <div class="miniature-footer"><span>{concept.visiblePages[1]}</span><span>↗</span></div>
</div>

<style>
  .web-miniature { position: relative; isolation: isolate; container-type: inline-size; display: flex; flex-direction: column; min-width: 0; min-height: 230px; height: 100%; overflow: hidden; color: #fff; background: var(--theme-ink); font-family: var(--serif); text-align: left; }
  .web-miniature picture, .web-miniature img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--theme-image-position); z-index: -2; }
  .web-miniature::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #101810d9, #1018105c 75%), linear-gradient(180deg, #10181055, transparent 40%); }
  .miniature-nav { display: flex; gap: 6px; align-items: center; padding: 16px; }
  .miniature-nav > span { flex: 1; min-width: 0; font-size: clamp(9px, 4cqw, 13px); line-height: 1.3; }
  .miniature-nav i { flex-shrink: 0; width: 10px; height: 1px; background: currentColor; }
  .miniature-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; padding: 14px 20px 22px; }
  .miniature-copy small { display: block; font: 500 clamp(8px, 3cqw, 10px)/1.4 var(--sans); text-transform: uppercase; letter-spacing: .09em; }
  .miniature-copy p { max-width: 92%; margin: 10px 0 0; font: 400 clamp(19px, 9cqw, 35px)/1.05 var(--serif); letter-spacing: -.035em; text-wrap: balance; overflow-wrap: anywhere; }
  .miniature-footer { display: flex; justify-content: space-between; gap: 8px; margin: 0 20px 18px; border-top: 1px solid #ffffff7a; padding-top: 10px; font: 500 clamp(8px, 3cqw, 10px)/1.4 var(--sans); }
  .miniature-split { color: var(--theme-ink); background: var(--theme-paper); }
  .miniature-split picture { inset: 44px 0 0 auto; width: 47%; height: calc(100% - 44px); }
  .miniature-split::after { content: none; }
  .miniature-split .miniature-nav { border-bottom: 1px solid color-mix(in srgb, var(--theme-ink) 15%, transparent); }
  .miniature-split .miniature-copy { width: 56%; padding: 18px 14px; }
  .miniature-split .miniature-copy small { color: var(--theme-accent); }
  .miniature-split .miniature-copy p { max-width: 100%; font-size: clamp(16px, 7.6cqw, 29px); }
  .miniature-split .miniature-footer { width: calc(53% - 28px); margin-inline: 14px; border-color: color-mix(in srgb, var(--theme-ink) 35%, transparent); }
  .miniature-framed .miniature-nav { justify-content: center; padding-bottom: 12px; }
  .miniature-framed .miniature-nav > span { flex: initial; text-align: center; }
  .miniature-framed .miniature-nav i { display: none; }
  .miniature-framed .miniature-copy { align-items: center; margin: 0 16px 14px; border: 1px solid #ffffff6b; padding: 18px 12px; text-align: center; }
  .miniature-framed .miniature-copy p { font-size: clamp(18px, 8.2cqw, 31px); }
  .miniature-framed .miniature-footer { margin-inline: 16px; }
  @container (max-width: 210px) {
    .miniature-nav { padding: 12px; }
    .miniature-nav i { display: none; }
    .miniature-copy { padding: 10px 12px 18px; }
    .miniature-copy small { display: none; }
    .miniature-copy p { font-size: 19px; }
    .miniature-footer { margin-inline: 12px; }
    .miniature-split picture { inset: 37px 0 0 auto; height: calc(100% - 37px); width: 41%; }
    .miniature-split .miniature-copy { width: 64%; padding: 12px 9px; }
    .miniature-split .miniature-copy p { font-size: 17px; }
    .miniature-split .miniature-footer { width: calc(59% - 18px); margin-inline: 9px; }
    .miniature-framed .miniature-copy { margin-inline: 10px; padding: 12px 8px; }
  }
  @media (max-width: 760px) { .web-miniature { min-height: 190px; } }
</style>
