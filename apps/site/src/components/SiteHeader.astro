---
import type { Locale } from '@logic-estancia/config';
import { getSiteShell } from '../site-shell';
import BrandLockup from './BrandLockup.astro';

interface Props {
  locale: Locale;
  translated: boolean;
  localeHref: string;
  isHome: boolean;
}

const { locale, translated, localeHref, isHome } = Astro.props;
const en = locale === 'en';
const shell = getSiteShell(locale, isHome);
---

<header class="site-header parity-header" data-site-header>
  <div class="header-bar shell">
    <BrandLockup locale={locale} />

    <nav class="header-primary" aria-label={en ? 'Main' : 'Principal'}>
      {shell.product.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        class="header-contact"
        href={shell.contact.href}
        data-contact-trigger
        data-track="cta_click"
        data-section="header"
        aria-haspopup={isHome ? 'dialog' : undefined}
      >{shell.contact.label}</a>
      <a
        class="header-tour"
        href={shell.journey.href}
        data-estancia-tour-trigger={isHome ? '' : undefined}
        aria-haspopup={isHome ? 'dialog' : undefined}
      >{shell.journey.label}<span aria-hidden="true">↗</span></a>
      {translated && <a class="header-locale" href={localeHref} lang={en ? 'es' : 'en'} hreflang={en ? 'es' : 'en'}>{en ? 'ES' : 'EN'}</a>}
      <button class="menu" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span>{en ? 'Menu' : 'Menú'}</span>
        <i aria-hidden="true"><b></b><b></b></i>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={en ? 'Mobile main' : 'Principal móvil'} hidden>
    <div class="mobile-nav-shell shell">
      <section class="mobile-nav-product" aria-labelledby="mobile-product-label">
        <p id="mobile-product-label">{en ? 'Product' : 'Producto'}</p>
        {shell.product.map((item, index) => (
          <a href={item.href}><span>0{index + 1}</span><strong>{item.label}</strong><b aria-hidden="true">↗</b></a>
        ))}
      </section>

      <section class="mobile-nav-secondary" aria-labelledby="mobile-explore-label">
        <p id="mobile-explore-label">{en ? 'Explore by accommodation' : 'Explora por alojamiento'}</p>
        <div>{shell.solutions.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}</div>
        <a class="mobile-guides" href={shell.guides.href}>{shell.guides.label}<span aria-hidden="true">→</span></a>
      </section>

      <div class="mobile-nav-actions">
        <a
          class="mobile-nav-contact"
          href={shell.contact.href}
          data-contact-trigger
          data-track="cta_click"
          data-section="header"
          aria-haspopup={isHome ? 'dialog' : undefined}
        >{shell.contact.label}<span aria-hidden="true">→</span></a>
        <a
          class="mobile-nav-tour"
          href={shell.journey.href}
          data-estancia-tour-trigger={isHome ? '' : undefined}
          aria-haspopup={isHome ? 'dialog' : undefined}
        >{shell.journey.label}<span aria-hidden="true">↗</span></a>
        {translated && <a class="mobile-nav-locale" href={localeHref} lang={en ? 'es' : 'en'} hreflang={en ? 'es' : 'en'}>{en ? 'Versión en español' : 'English version'}<span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </nav>
</header>

<style>
  :global(body.site-menu-open) {
    overflow: hidden;
  }

  .parity-header {
    isolation: isolate;
    z-index: 70;
    border-bottom-color: rgb(23 25 28 / .1);
    background: rgb(255 255 255 / .94);
    backdrop-filter: none;
    box-shadow: 0 8px 30px rgb(23 25 28 / .025);
  }

  .header-bar {
    display: grid;
    min-height: 76px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 58px);
    align-items: center;
  }

  .header-primary {
    display: flex;
    justify-content: center;
    gap: clamp(22px, 3vw, 42px);
  }

  .header-primary a,
  .header-contact,
  .header-tour,
  .header-locale {
    color: var(--ink);
    font-size: .72rem;
    font-weight: 650;
    text-decoration: none;
  }

  .header-primary a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .header-primary a::after {
    position: absolute;
    right: 0;
    bottom: 7px;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    background: currentcolor;
    content: '';
    transition: transform 180ms ease;
  }

  .header-primary a:hover::after,
  .header-primary a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .header-contact,
  .header-tour {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 17px;
  }

  .header-contact {
    color: white;
    background: var(--ink);
  }

  .header-contact:hover {
    background: #31543f;
  }

  .header-tour {
    gap: 9px;
    border: 1px solid var(--line);
    background: white;
  }

  .header-tour:hover {
    border-color: #8ba18f;
    background: #f2f6f2;
  }

  .header-locale {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .menu,
  .mobile-nav {
    display: none;
  }

  .menu {
    min-width: 76px;
    min-height: 44px;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    border: 0;
    padding: 0;
    color: var(--ink);
    background: transparent;
    font: 650 .72rem/1 var(--sans);
  }

  .menu i {
    display: grid;
    width: 24px;
    gap: 6px;
  }

  .menu b {
    display: block;
    width: 100%;
    height: 1px;
    background: currentcolor;
    transition: transform 180ms ease;
  }

  .menu[aria-expanded='true'] b:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu[aria-expanded='true'] b:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .header-primary a:focus-visible,
  .header-actions a:focus-visible,
  .menu:focus-visible,
  .mobile-nav a:focus-visible {
    outline: 3px solid var(--sienna);
    outline-offset: 3px;
  }

  @media (max-width: 1279px) {
    .header-bar {
      min-height: 70px;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px;
    }

    .header-primary {
      display: none;
    }

    .menu {
      display: inline-flex;
    }

    .mobile-nav {
      position: fixed;
      z-index: 69;
      top: 70px;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      max-height: none;
      overflow-y: auto;
      border: 0;
      border-radius: 0;
      padding: 0;
      color: white;
      background: rgb(23 25 28 / .98);
      box-shadow: none;
      overscroll-behavior: contain;
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav-shell {
      display: grid;
      min-height: 100%;
      align-content: start;
      grid-template-columns: minmax(0, 1.15fr) minmax(210px, .85fr);
      gap: clamp(34px, 7vw, 84px);
      padding-top: 40px;
      padding-bottom: 118px;
    }

    .mobile-nav section > p {
      margin: 0 0 16px;
      color: rgb(255 255 255 / .5);
      font-size: .58rem;
      font-weight: 650;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .mobile-nav-product {
      display: grid;
      align-content: start;
    }

    .mobile-nav-product > a {
      display: grid;
      min-height: 64px;
      grid-template-columns: 38px minmax(0, 1fr) auto;
      gap: 12px;
      align-items: center;
      border-top: 1px solid rgb(255 255 255 / .14);
      color: white;
      text-decoration: none;
    }

    .mobile-nav-product > a:last-child {
      border-bottom: 1px solid rgb(255 255 255 / .14);
    }

    .mobile-nav-product > a > span {
      color: rgb(255 255 255 / .42);
      font-size: .58rem;
    }

    .mobile-nav-product strong {
      font-family: var(--serif);
      font-size: clamp(1.55rem, 4vw, 2.1rem);
      font-weight: 400;
    }

    .mobile-nav-product b {
      font-size: .78rem;
      font-weight: 400;
    }

    .mobile-nav-secondary > div {
      display: grid;
    }

    .mobile-nav-secondary a {
      display: flex;
      min-height: 45px;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border-bottom: 1px solid rgb(255 255 255 / .1);
      color: rgb(255 255 255 / .82);
      font-size: .72rem;
      text-decoration: none;
    }

    .mobile-nav-secondary .mobile-guides {
      margin-top: 18px;
      color: white;
      font-weight: 700;
    }

    .mobile-nav-actions {
      position: sticky;
      bottom: 0;
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 18px;
      border-top: 1px solid rgb(255 255 255 / .14);
      padding: 12px 0 14px;
      background: linear-gradient(180deg, transparent 0, rgb(23 25 28 / .98) 18px);
    }

    .mobile-nav-actions a {
      display: flex;
      min-height: 54px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border: 1px solid rgb(255 255 255 / .18);
      border-radius: 12px;
      padding: 10px 13px;
      color: white;
      font-size: .67rem;
      font-weight: 650;
      text-decoration: none;
    }

    .mobile-nav-actions .mobile-nav-contact {
      position: static;
      margin: 0;
      color: var(--ink);
      background: var(--peach);
    }

    .mobile-nav-actions .mobile-nav-locale {
      color: rgb(255 255 255 / .72);
    }
  }

  @media (max-width: 620px) {
    .header-contact,
    .header-tour,
    .header-locale {
      display: none;
    }

    .menu {
      min-width: 44px;
    }

    .menu > span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .mobile-nav-shell {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 24px;
      padding-bottom: 104px;
    }

    .mobile-nav-product > a {
      min-height: 58px;
    }

    .mobile-nav-actions {
      grid-template-columns: 1fr 1fr;
    }

    .mobile-nav-actions .mobile-nav-locale {
      grid-column: 1 / -1;
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-primary a::after,
    .menu b {
      transition: none;
    }
  }
</style>
