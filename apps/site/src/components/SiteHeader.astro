---
import type { Locale } from '@logic-estancia/config';
import { getSiteShell } from '../site-shell';
import BrandLockup from './BrandLockup.astro';
import InterfaceIcon from './InterfaceIcon.astro';
interface Props { locale: Locale; translated: boolean; localeHref: string; isHome: boolean }
const { locale, isHome } = Astro.props;
const en = locale === 'en';
const shell = getSiteShell(locale, isHome);
const icons = ['web', 'grid', 'tag'] as const;
---
<header class="site-header parity-header" data-site-header>
  <div class="header-bar shell">
    <BrandLockup locale={locale} />
    <nav class="header-primary" aria-label={en ? 'Main' : 'Principal'}>{shell.product.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    <div class="header-actions">
      <button class="menu" type="button" aria-label={en ? 'Open menu' : 'Abrir menú'} data-open-label={en ? 'Open menu' : 'Abrir menú'} data-close-label={en ? 'Close menu' : 'Cerrar menú'} aria-expanded="false" aria-controls="mobile-nav"><InterfaceIcon name="menu" /></button>
      <a class="header-contact" href={shell.contact.href} data-contact-trigger data-track="cta_click" data-section="header" aria-haspopup={isHome ? 'dialog' : undefined}>{shell.contact.label}<InterfaceIcon name="message" /></a>
      <a class="header-tour" href={shell.journey.href} data-estancia-tour-trigger={isHome ? '' : undefined} aria-haspopup={isHome ? 'dialog' : undefined}>{shell.journey.label}<InterfaceIcon name="arrow" /></a>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label={en ? 'Mobile main' : 'Principal móvil'} hidden>
      <div class="mobile-nav-product">{shell.product.map((item, index) => <a href={item.href}><InterfaceIcon name={icons[index]} /><span>{item.label}</span></a>)}</div>
      <div class="mobile-nav-actions">
        <a href={shell.contact.href} data-contact-trigger data-track="cta_click" data-section="header" aria-haspopup={isHome ? 'dialog' : undefined}><InterfaceIcon name="message" /><span>{shell.contact.label}</span></a>
        <a href={shell.journey.href} data-estancia-tour-trigger={isHome ? '' : undefined} aria-haspopup={isHome ? 'dialog' : undefined}><InterfaceIcon name="arrow" /><span>{shell.journey.label}</span></a>
      </div>
    </nav>
  </div>
</header>
<style>
  .parity-header { isolation: isolate; z-index: 70; backdrop-filter: none; }
  .header-bar { position: relative; display: flex; align-items: center; gap: 34px; }
  .header-primary { display: flex; align-items: center; gap: 26px; margin-left: auto; }
  .header-primary a, .header-actions a { display: inline-flex; min-height: 44px; align-items: center; color: var(--slate); font-size: .875rem; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .header-primary a:hover { color: var(--ink); }
  .header-actions { display: flex; align-items: center; gap: 12px; }
  .header-actions a { justify-content: center; gap: 10px; padding: 0 20px; border: 1px solid var(--line); border-radius: 999px; }
  .header-actions .header-tour { color: white; background: #213f23; border-color: #213f23; }
  .header-contact:hover { background: #eef3e8; }
  .header-actions .header-tour:hover { background: #355b39; }
  .menu { display: none; width: 44px; height: 44px; padding: 11px; border: 1px solid var(--line); border-radius: 13px; color: var(--ink); background: transparent; cursor: pointer; }
  .menu[aria-expanded='true'] { background: #e7f1e2; border-color: #a5b9a3; }
  .mobile-nav { display: none; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--sienna); outline-offset: 3px; }
  @media(max-width:1279px) {
    .header-primary { display: none; }
    .header-actions { margin-left: auto; }
    .menu { display: inline-grid; place-items: center; }
    .mobile-nav:not([hidden]) { display: block; position: absolute; top: calc(100% + 12px); right: 0; width: min(330px, 100%); max-height: calc(100dvh - 108px); overflow-y: auto; padding: 8px; border: 1px solid var(--line); border-radius: 18px; background: #fffefa; box-shadow: 0 18px 48px #233c2626; }
    .mobile-nav a { display: flex; align-items: center; gap: 14px; min-height: 48px; padding: 12px; border-radius: 10px; color: var(--ink); font-size: .875rem; text-decoration: none; }
    .mobile-nav a:hover { background: #eef3e8; }
    .mobile-nav-actions { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 6px; }
  }
  @media(max-width:620px) { .header-bar { gap: 12px; } .header-actions .header-contact, .header-actions .header-tour { display:none; } }
</style>
