---
import type { Locale } from '@logic-estancia/config';
import type { BusinessSegment } from '../businesses';

const { locale, segment } = Astro.props as { locale: Locale; segment: BusinessSegment };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const accommodationType = segment === 'hotels' ? 'hotel' : segment === 'rural' ? 'rural' : 'apartment';
const plan = segment === 'hotels' ? 'inteligente' : segment === 'rural' ? 'gestion' : 'basico';
const copy = en ? {
  eyebrow: 'Commercial enquiry', title: 'Tell us about your stay.', body: 'This form reaches the Logic Estancia team. A demo never sends it; delivery is enabled only through the explicit commercial allowlist.',
  demo: 'Safe demo mode. Your details stay in this page and are not sent.', live: 'Commercial leads are enabled for this deployment. Logic2B will use these details only to reply.', simulation: 'Simulation complete. No details were sent or stored.',
  name: 'Name', business: 'Business or stay', phone: 'Phone (optional)', message: 'What would you like to improve?', accept: 'I have read the privacy policy and accept that Logic2B uses these details to reply.', marketing: 'I would also like relevant commercial follow-up (optional).', submit: 'Request a conversation', sending: 'Sending…', success: 'Request delivered. We will reply within one business day.', error: 'We could not confirm delivery. Please try again or use WhatsApp.',
} : {
  eyebrow: 'Solicitud comercial', title: 'Cuéntanos sobre tu alojamiento.', body: 'Este formulario llega al equipo de Logic Estancia. Una demo nunca lo envía: la entrega solo se habilita mediante la allowlist comercial explícita.',
  demo: 'Modo demo seguro. Tus datos permanecen en esta página y no se envían.', live: 'Los leads comerciales están habilitados para este despliegue. Logic2B usará estos datos solo para responder.', simulation: 'Simulación completada. No se ha enviado ni almacenado ningún dato.',
  name: 'Nombre', business: 'Empresa o alojamiento', phone: 'Teléfono (opcional)', message: '¿Qué te gustaría mejorar?', accept: 'He leído la política de privacidad y acepto que Logic2B use estos datos para responder.', marketing: 'También quiero recibir seguimiento comercial relevante (opcional).', submit: 'Pedir una conversación', sending: 'Enviando…', success: 'Solicitud entregada. Te responderemos en un día laborable.', error: 'No hemos podido confirmar la entrega. Vuelve a intentarlo o usa WhatsApp.',
};
---
<section id="contacto" class="section shell" data-commercial-contact>
  <div class="contact-wrap">
    <div class="section-head"><p class="eyebrow">{copy.eyebrow}</p><h2 class="heading">{copy.title}</h2><p>{copy.body}</p></div>
    <form class="lead-form" data-commercial-lead method="dialog" novalidate>
      <p class="runtime-lead-note wide" data-runtime-lead-note role="note"><strong data-runtime-lead-label>{en ? 'Safe demo mode.' : 'Modo demo seguro.'}</strong> <span data-runtime-lead-copy>{copy.demo}</span></p>
      <label>{copy.name}<input name="name" required maxlength="120" autocomplete="name" /></label>
      <label>{copy.business}<input name="businessName" required maxlength="160" autocomplete="organization" /></label>
      <label>Email<input name="email" required type="email" maxlength="200" autocomplete="email" /></label>
      <label>{copy.phone}<input name="phone" maxlength="60" autocomplete="tel" /></label>
      <label>{en ? 'Properties' : 'Propiedades'}<input name="propertyCount" type="number" min="1" max="10000" value="1" required /></label>
      <label>{en ? 'Units' : 'Unidades'}<input name="unitCount" type="number" min="1" max="100000" value="1" required /></label>
      <label class="wide">{copy.message}<textarea name="message" rows="5" maxlength="2000"></textarea></label>
      <label class="honeypot" inert aria-hidden="true"><span>Website</span><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /></label>
      <label class="check wide"><input name="accept" type="checkbox" required /><span>{copy.accept.replace('privacy policy', '')}<a href={`${prefix}/privacidad/`} target="_blank" rel="noopener noreferrer">{en ? 'privacy policy' : 'política de privacidad'}</a>{en ? ' and accept that Logic2B uses these details to reply.' : ' y acepto que Logic2B use estos datos para responder.'}</span></label>
      <label class="check wide"><input name="marketingConsent" type="checkbox" /><span>{copy.marketing}</span></label>
      <div class="wide"><button class="pill" type="button" data-commercial-lead-submit><span>{copy.submit}</span><span aria-hidden="true">→</span></button></div>
      <p class="form-status wide" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script is:inline define:vars={{ locale, accommodationType, plan, copy }}>
  const form = document.querySelector('[data-commercial-lead]');
  const status = form?.querySelector('.form-status');
  const button = form?.querySelector('[data-commercial-lead-submit]');
  const label = button?.querySelector('span');
  const note = form?.querySelector('[data-runtime-lead-note]');
  const noteLabel = note?.querySelector('[data-runtime-lead-label]');
  const noteCopy = note?.querySelector('[data-runtime-lead-copy]');
  const commercialRuntime = () => window.estanciaRuntimeReady ?? Promise.resolve(null);
  commercialRuntime().then((runtime) => {
    const active = runtime?.operations?.commercialLead === 'active' && runtime?.providers?.email === 'live';
    if (noteLabel) noteLabel.textContent = active ? (locale === 'en' ? 'Commercial lead delivery.' : 'Entrega comercial activa.') : (locale === 'en' ? 'Safe demo mode.' : 'Modo demo seguro.');
    if (noteCopy) noteCopy.textContent = active ? copy.live : copy.demo;
    if (note) note.dataset.mode = active ? 'real' : 'demo';
  });
  button?.addEventListener('click', () => form?.requestSubmit());
  form?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLButtonElement) return;
    event.preventDefault(); form.requestSubmit();
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (button) button.disabled = true;
    if (label) label.textContent = copy.sending;
    if (status) status.textContent = '';
    const runtime = await commercialRuntime();
    if (runtime?.operations?.commercialLead !== 'active' || runtime?.providers?.email !== 'live') {
      if (status) status.textContent = copy.simulation;
      if (button) button.disabled = false;
      if (label) label.textContent = copy.submit;
      return;
    }
    const data = Object.fromEntries(new FormData(form));
    const payload = { ...data, accommodationType, plan, propertyCount: Number(data.propertyCount), unitCount: Number(data.unitCount), accept: data.accept === 'on', marketingConsent: data.marketingConsent === 'on', lang: locale, sourcePath: location.pathname };
    try {
      const response = await fetch('/api/leads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !['delivered', 'delivered_degraded'].includes(result.outcome)) throw new Error('delivery');
      form.reset();
      if (status) status.textContent = copy.success;
      window.estanciaTrack?.('lead_submit', { locale, plan, source_section: 'solution_contact' });
    } catch {
      if (status) status.textContent = copy.error;
    } finally {
      if (button) button.disabled = false;
      if (label) label.textContent = copy.submit;
    }
  });
</script>
