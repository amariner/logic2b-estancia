---
import type { Locale } from '@logic-estancia/config';
import ConnectionVisual from './ConnectionVisual.astro';
import ConnectionRequirements from './ConnectionRequirements.astro';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
---
<section id="conexiones" class="section capability-band" aria-labelledby="capability-band-title" data-capability-band>
  <div class="shell">
    <div class="section-head capability-band-heading">
      <p class="eyebrow">{en ? 'Your tools, your way of working' : 'Tus herramientas, tu forma de trabajar'}</p>
      <h2 id="capability-band-title" class="heading">{en ? 'A project built around the tools you use.' : 'Un proyecto pensado para las herramientas que usas.'}</h2>
      <p>{en ? 'Tell us what you use. We design the flow between your website, channels, payments and team with you.' : 'Cuéntanos qué utilizas. Diseñamos contigo el flujo entre tu web, canales, cobros y equipo.'}</p>
    </div>
    <p class="connection-note" role="note">{en
      ? 'Reference brands to evaluate: no confirmed integration or partnership. No accommodation provider has been validated or activated. Demos have no live connections; any integration requires separate scope, validation and authorisation.'
      : 'Marcas de referencia a evaluar: ninguna integración ni colaboración confirmada. No hay proveedores del alojamiento validados ni activados. Las demos no tienen conexiones reales; cualquier integración requiere alcance, validación y autorización separados.'}</p>
    <div class="connection-overview">
      <article><ConnectionVisual group="channels" en={en} /><h3>{en ? 'Channels and calendars' : 'Canales y calendarios'}</h3><p>{en ? 'We review how your booking channels and availability could share information.' : 'Estudiamos cómo podrían compartir información tus canales y la disponibilidad.'}</p></article>
      <article><ConnectionVisual group="payments" en={en} /><h3>{en ? 'Payments in context' : 'Cobros con contexto'}</h3><p>{en ? 'We define the payment flow, confirmations and reconciliation your project needs.' : 'Definimos el flujo de cobro, confirmación y conciliación que necesita tu proyecto.'}</p></article>
      <article><ConnectionVisual group="tools" en={en} /><h3>{en ? 'Tools for your team' : 'Herramientas para tu equipo'}</h3><p>{en ? 'We plan how email, messaging and location fit into your daily work.' : 'Planificamos cómo encajar correo, mensajería y ubicación en tu trabajo diario.'}</p></article>
    </div>
    <ConnectionRequirements locale={locale} />
  </div>
</section>
