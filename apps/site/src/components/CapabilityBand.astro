---
import type { Locale } from '@logic-estancia/config';
import { CAPABILITIES, PAYMENT_READINESS, PAYMENT_READINESS_FIELDS, type Capability, type PlanLevel } from '@logic-estancia/domain';
import {
  capabilityEvidenceHref,
  capabilityEvidenceLabel,
  capabilityStatusDetail,
  capabilityStatusLabel,
} from '../capability-evidence';
import { getHomeContract } from '../home-contract';

const { locale } = Astro.props as { locale: Locale };
const home = getHomeContract(locale);
const en = locale === 'en';
const planNames: Record<PlanLevel, string> = en
  ? { basico: 'Basic', gestion: 'Management', inteligente: 'Intelligent' }
  : { basico: 'Básico', gestion: 'Gestión', inteligente: 'Inteligente' };
const capabilities = new Map(CAPABILITIES.map((capability) => [capability.id, capability]));

function getCapability(id: string): Capability | undefined {
  return capabilities.get(id);
}
---

<section id="conexiones" class="section capability-band" aria-labelledby="capability-band-title" data-capability-band>
  <div class="shell">
    <div class="section-head capability-band-heading">
      <p class="eyebrow">{home.capabilityStatusCopy.eyebrow}</p>
      <h2 id="capability-band-title" class="heading">{home.capabilityStatusCopy.title}</h2>
      <p>{home.capabilityStatusCopy.body}</p>
    </div>
    <div class="capability-band-grid">
      {home.capabilityGroups.map((group) => (
        <article class="capability-band-card" data-capability-group={group.id}>
          <div class="capability-band-card-heading"><span>{group.number}</span><small>{group.title}</small></div>
          <p>{group.text}</p>
          <ul>
            {group.capabilityIds.map((id) => {
              const capability = getCapability(id);
              if (!capability) return null;
              const href = capabilityEvidenceHref(capability, locale);
              return (
                <li data-capability={capability.id} data-capability-status={capability.status}>
                  <div class="capability-band-label"><strong>{capability.label[locale]}</strong><span class={`capability-status ${capability.status}`}>{capabilityStatusLabel(capability.status, locale)}</span></div>
                  <small>{capabilityStatusDetail(capability.status, locale)} · {en ? 'From' : 'Desde'} {planNames[capability.minimumPlan]}</small>
                  <p><b>{home.capabilityStatusCopy.evidence}:</b> {capability.evidence.proof[locale]}</p>
                  <p class="capability-band-boundary"><b>{home.capabilityStatusCopy.boundary}:</b> {capability.evidence.boundary[locale]}</p>
                  {href ? <a href={href} data-capability-evidence={capability.id}>{capabilityEvidenceLabel(capability, locale)} <span aria-hidden="true">→</span></a> : <span class="capability-no-evidence" data-capability-evidence-unavailable={capability.id}>{capabilityEvidenceLabel(capability, locale)}</span>}
                </li>
              );
            })}
          </ul>
        </article>
      ))}
    </div>
    <section id="payment-readiness" class="payment-readiness" aria-labelledby="payment-readiness-title" data-payment-readiness>
      <header class="payment-readiness-heading">
        <div>
          <p class="eyebrow">{en ? 'Separate integration scope' : 'Alcance de integración separado'}</p>
          <h3 id="payment-readiness-title">{PAYMENT_READINESS.title[locale]}</h3>
          <p>{PAYMENT_READINESS.summary[locale]}</p>
        </div>
        <div class="payment-readiness-zero" aria-label={en ? 'Zero of fifteen payment conditions validated' : 'Cero de quince condiciones de pago validadas'}>
          <span>{en ? 'Readiness' : 'Preparación'}</span>
          <strong>0 / {PAYMENT_READINESS_FIELDS.length}</strong>
          <small>{en ? 'Not validated · charging unavailable' : 'Sin validar · cobro no disponible'}</small>
        </div>
      </header>
      <details data-payment-readiness-details>
        <summary>
          <span>{en ? 'Review the fifteen conditions' : 'Revisar las quince condiciones'}</span>
          <span aria-hidden="true">+</span>
        </summary>
        <ol>
          {PAYMENT_READINESS_FIELDS.map((field, index) => (
            <li data-payment-readiness-field={field}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{PAYMENT_READINESS.labels[field][locale]}</strong>
                <p>{PAYMENT_READINESS.requirements[field][locale]}</p>
                <small>{en ? 'Not validated' : 'Sin validar'}</small>
              </div>
            </li>
          ))}
        </ol>
      </details>
      <p class="payment-readiness-boundary" role="note">{en
        ? 'This file creates no checkout, card field, session, authorisation, capture, refund, provider call, webhook, persistence or external write.'
        : 'Este expediente no crea checkout, campo de tarjeta, sesión, autorización, captura, devolución, llamada a proveedor, webhook, persistencia ni escritura externa.'}</p>
    </section>
    <p class="capability-band-footnote" role="note">{en ? 'Demo status is not production activation. Connections require a validated project, provider and agreed scope.' : 'El estado de demo no equivale a activación en producción. Las conexiones requieren proyecto, proveedor y alcance validados.'}</p>
  </div>
</section>
