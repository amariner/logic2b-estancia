---
import type { Locale } from '@logic-estancia/config';
import { getCommercialTour } from '../commercial-tour';
import { tourAssessmentHref } from '../tour-entry';
import PanelPreview from './PanelPreview.astro';
import WebsitePreview from './WebsitePreview.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const steps = getCommercialTour(locale);
if (steps.length !== 5) throw new Error(`home_tour_expected_five:${locale}:${steps.length}`);

const labels = en ? {
  eyebrow: 'A look in three minutes',
  title: 'From your website to the day ahead.',
  intro: 'A website, an enquiry and the work behind them. Five stages across three separate demo cases.',
  boundary: 'Fictional examples. No live bookings, payments or messages; no connected services.',
  close: 'Close guided journey',
  progress: 'Journey progress',
  step: 'Step',
  of: 'of',
  decision: 'What it helps with',
  outcome: 'What this shows',
  more: 'What you can explore',
  detail: 'Explore this feature',
  evidence: 'Try the demo',
  newTab: 'opens in a new tab',
  evidenceNote: 'The demo opens in another tab.',
  websiteEvidence: 'Website demo',
  workspaceEvidence: 'Workspace demo',
  seen: 'stages explored',
  previous: 'Previous step',
  next: 'Next step',
  complete: 'Complete journey',
  free: 'View the full journey',
} : {
  eyebrow: 'Un vistazo en tres minutos',
  title: 'De tu web al día a día.',
  intro: 'Una web, una consulta y el trabajo que hay detrás. Cinco etapas en tres casos demo independientes.',
  boundary: 'Ejemplos ficticios. Sin reservas, pagos ni mensajes reales; sin servicios conectados.',
  close: 'Cerrar recorrido guiado',
  progress: 'Progreso del recorrido',
  step: 'Paso',
  of: 'de',
  decision: 'Para qué sirve',
  outcome: 'Qué te muestra',
  more: 'Qué puedes comprobar',
  detail: 'Conocer esta función',
  evidence: 'Probar la demo',
  newTab: 'se abre en otra pestaña',
  evidenceNote: 'La demo se abre en otra pestaña.',
  websiteEvidence: 'Web de muestra',
  workspaceEvidence: 'Gestor de muestra',
  seen: 'etapas vistas',
  previous: 'Paso anterior',
  next: 'Siguiente paso',
  complete: 'Completar recorrido',
  free: 'Ver el recorrido completo',
};
---

<dialog
  id="home-tour-dialog"
  class="home-tour-dialog"
  aria-labelledby="home-tour-dialog-title"
  aria-describedby="home-tour-dialog-intro home-tour-dialog-boundary"
  data-home-tour-dialog
  data-home-tour-step-label={labels.step}
  data-home-tour-of-label={labels.of}
  data-home-tour-storage-key={`logic-estancia:home-tour:${locale}`}
>
  <article class="home-tour-frame">
    <header class="home-tour-header">
      <div class="home-tour-heading">
        <p class="home-tour-eyebrow eyebrow">{labels.eyebrow}</p>
        <h2 id="home-tour-dialog-title" class="home-tour-title">{labels.title}</h2>
        <p id="home-tour-dialog-intro" class="home-tour-intro">{labels.intro}</p>
        <p id="home-tour-dialog-boundary" class="home-tour-boundary" role="note">{labels.boundary}</p>
      </div>
      <button class="home-tour-close" type="button" data-home-tour-close aria-label={labels.close}>
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="home-tour-progress">
      <div class="home-tour-progress-copy">
        <span data-home-tour-seen data-seen-label={labels.seen}>1 / {steps.length} {labels.seen}</span>
        <strong data-home-tour-progress-text aria-live="polite">{labels.step} 1 {labels.of} {steps.length}</strong>
      </div>
      <progress
        class="home-tour-progress-bar"
        max={steps.length}
        value="1"
        aria-label={labels.progress}
        data-home-tour-progress
      >1 / {steps.length}</progress>
    </div>

    <div class="home-tour-step-list">
      {steps.map((step, index) => (
        <section
          class="home-tour-step"
          data-home-tour-step={step.id}
          data-home-tour-step-index={index}
          aria-labelledby={`home-tour-step-title-${step.id}`}
          hidden={index !== 0}
        >
          <div class="home-tour-step-copy">
            <p class="home-tour-step-meta">{step.number} · {step.phase} · {step.planLabel}</p>
            <h3 id={`home-tour-step-title-${step.id}`} class="home-tour-step-title" tabindex="-1" data-home-tour-step-title>{step.title}</h3>
            <p class="home-tour-step-summary">{step.summary}</p>
            <p class="home-tour-step-boundary" role="note">{step.boundary}</p>
            <div class="home-tour-step-links">
              <a class="home-tour-evidence-link" href={step.evidenceHref} target="_blank" rel="noopener noreferrer">
                {labels.evidence} <span class="home-tour-new-tab sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href={tourAssessmentHref(locale, step.id, en ? '/en/' : '/')} data-home-tour-assess>{en ? 'Assess this need' : 'Evaluar esta necesidad'} →</a>
            </div>
            <p class="home-tour-evidence-note">{labels.evidenceNote}</p>
            <details class="home-tour-step-details">
              <summary>{labels.more}</summary>
              <dl class="home-tour-step-facts">
              <div class="home-tour-step-fact">
                <dt>{labels.decision}</dt>
                <dd>{step.decision}</dd>
              </div>
              <div class="home-tour-step-fact">
                <dt>{labels.outcome}</dt>
                <dd>{step.outcome}</dd>
              </div>
              </dl>
              <a class="home-tour-detail-link" href={step.detailHref} target="_blank" rel="noopener noreferrer">
                {labels.detail} <span class="home-tour-new-tab sr-only">({labels.newTab})</span><span aria-hidden="true">↗</span>
              </a>
            </details>
          </div>

          <div class="home-tour-step-visual">
            <p class="home-tour-step-visual-label">
              <span>{step.planLabel}</span>
              <small>{step.kind === 'web' ? labels.websiteEvidence : labels.workspaceEvidence}</small>
            </p>
            {step.kind === 'web' ? (
              <div class="home-tour-website-preview"><WebsitePreview locale={locale} slug="nivora" /></div>
            ) : (
              <div class="home-tour-panel-preview"><PanelPreview locale={locale} kind={step.preview} /></div>
            )}
          </div>
        </section>
      ))}
    </div>

    <nav class="home-tour-controls" aria-label={labels.progress}>
      <a class="home-tour-free" href={en ? '/en/journey/' : '/recorrido/'}>{labels.free} <span aria-hidden="true">↗</span></a>
      <button class="home-tour-previous" type="button" data-home-tour-previous disabled>{labels.previous}</button>
      <button class="home-tour-next" type="button" data-home-tour-next>{labels.next} <span aria-hidden="true">→</span></button>
      <button class="home-tour-complete" type="button" data-home-tour-complete hidden>{labels.complete} <span aria-hidden="true">✓</span></button>
    </nav>
  </article>
</dialog>

<script>
  const homeTourDialog = document.querySelector<HTMLDialogElement>('[data-home-tour-dialog]');
  const homeTourSteps = [...(homeTourDialog?.querySelectorAll<HTMLElement>('[data-home-tour-step]') ?? [])];
  const homeTourPrevious = homeTourDialog?.querySelector<HTMLButtonElement>('[data-home-tour-previous]');
  const homeTourNext = homeTourDialog?.querySelector<HTMLButtonElement>('[data-home-tour-next]');
  const homeTourComplete = homeTourDialog?.querySelector<HTMLButtonElement>('[data-home-tour-complete]');
  const homeTourProgress = homeTourDialog?.querySelector<HTMLProgressElement>('[data-home-tour-progress]');
  const homeTourProgressText = homeTourDialog?.querySelector<HTMLElement>('[data-home-tour-progress-text]');
  let homeTourCurrentStep = 0;
  const homeTourSeenSteps = new Set<number>();
  let homeTourReturnTarget: HTMLElement | null = null;
  const homeTourStorageKey = homeTourDialog?.dataset.homeTourStorageKey;

  const readHomeTourStep = () => {
    homeTourSeenSteps.clear();
    if (!homeTourStorageKey) return 0;
    try {
      const stored: unknown = JSON.parse(sessionStorage.getItem(homeTourStorageKey) ?? 'null');
      const validIndex = (index: unknown): index is number => Number.isInteger(index) && typeof index === 'number' && index >= 0 && index < homeTourSteps.length;
      // Previous visits stored only the current stage; do not count other stages as seen.
      if (validIndex(stored)) return stored;
      if (!stored || typeof stored !== 'object') return 0;
      const { current, seen } = stored as { current?: unknown; seen?: unknown };
      if (!validIndex(current) || !Array.isArray(seen) || seen.length > homeTourSteps.length || !seen.every(validIndex)) return 0;
      seen.forEach(index => homeTourSeenSteps.add(index));
      return current;
    } catch {
      return 0;
    }
  };

  const showHomeTourStep = (requestedIndex: number, moveFocus = true) => {
    if (!homeTourDialog || !homeTourPrevious || !homeTourNext || !homeTourComplete || !homeTourProgress || !homeTourProgressText || homeTourSteps.length === 0) return;
    homeTourCurrentStep = Math.max(0, Math.min(homeTourSteps.length - 1, requestedIndex));
    homeTourSeenSteps.add(homeTourCurrentStep);
    homeTourSteps.forEach((step, index) => { step.hidden = index !== homeTourCurrentStep; });
    homeTourPrevious.disabled = homeTourCurrentStep === 0;
    const allSeen = homeTourSeenSteps.size === homeTourSteps.length;
    homeTourNext.hidden = homeTourCurrentStep === homeTourSteps.length - 1 && allSeen;
    homeTourComplete.hidden = !allSeen;
    homeTourProgress.value = homeTourSeenSteps.size;
    const seen = homeTourDialog.querySelector<HTMLElement>('[data-home-tour-seen]');
    if (seen) seen.textContent = `${homeTourSeenSteps.size} / ${homeTourSteps.length} ${seen.dataset.seenLabel}`;
    const stepLabel = homeTourDialog.dataset.homeTourStepLabel ?? '';
    const ofLabel = homeTourDialog.dataset.homeTourOfLabel ?? '';
    homeTourProgressText.textContent = `${stepLabel} ${homeTourCurrentStep + 1} ${ofLabel} ${homeTourSteps.length}`;
    if (homeTourStorageKey) {
      try { sessionStorage.setItem(homeTourStorageKey, JSON.stringify({ current: homeTourCurrentStep, seen: [...homeTourSeenSteps] })); } catch { /* local progress is optional */ }
    }
    if (moveFocus) homeTourSteps[homeTourCurrentStep]?.querySelector<HTMLElement>('[data-home-tour-step-title]')?.focus();
  };

  document.addEventListener('click', (event) => {
    if (event instanceof MouseEvent && (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) return;
    const eventTarget = event.target instanceof Element ? event.target : null;
    const trigger = eventTarget?.closest<HTMLElement>('[data-estancia-tour-trigger]');
    if (!trigger || !homeTourDialog || typeof homeTourDialog.showModal !== 'function') return;
    if (homeTourDialog.open) return;
    homeTourReturnTarget = trigger;
    const restoredIndex = readHomeTourStep();
    const entryIndex = homeTourSteps.findIndex(step => step.dataset.homeTourStep === trigger.dataset.tourEntryStep);
    try {
      homeTourDialog.showModal();
      event.preventDefault();
      showHomeTourStep(entryIndex >= 0 ? entryIndex : restoredIndex, false);
      queueMicrotask(() => homeTourSteps[homeTourCurrentStep]?.querySelector<HTMLElement>('[data-home-tour-step-title]')?.focus());
    } catch {
      homeTourReturnTarget = null;
    }
  });

  homeTourPrevious?.addEventListener('click', () => showHomeTourStep(homeTourCurrentStep - 1));
  homeTourNext?.addEventListener('click', () => showHomeTourStep((homeTourCurrentStep + 1) % homeTourSteps.length));
  homeTourComplete?.addEventListener('click', () => {
    if (homeTourSeenSteps.size !== homeTourSteps.length) return;
    if (homeTourStorageKey) {
      try { sessionStorage.removeItem(homeTourStorageKey); } catch { /* local progress is optional */ }
    }
    homeTourSeenSteps.clear();
    homeTourDialog?.close('complete');
  });
  homeTourDialog?.querySelector<HTMLButtonElement>('[data-home-tour-close]')?.addEventListener('click', () => homeTourDialog.close('button'));
  homeTourDialog?.addEventListener('click', (event) => {
    if (event.target === homeTourDialog) homeTourDialog.close('backdrop');
  });
  homeTourDialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    homeTourDialog.close('escape');
  });
  homeTourDialog?.addEventListener('close', () => {
    const target = homeTourReturnTarget;
    homeTourReturnTarget = null;
    if (target?.isConnected) target.focus();
  });
</script>

<style>
  .home-tour-frame { display:grid; height:min(900px,calc(100dvh - 36px)); grid-template-rows:auto auto minmax(220px,1fr) auto; overflow-y:auto; }
  .home-tour-header { padding-block:24px 20px; }
  .home-tour-title { max-width:760px; font-size:clamp(2.1rem,3.4vw,3.4rem); line-height:1.05; }
  .home-tour-intro { max-width:720px; margin-top:12px; }
  .home-tour-boundary { color:var(--slate); }
  .home-tour-close { flex-shrink:0; }
  .home-tour-progress { grid-template-columns:minmax(245px,.6fr) minmax(0,1fr); padding-block:14px; }
  .home-tour-step-list { min-height:0; overflow-y:auto; overscroll-behavior-y:contain; padding:clamp(20px,3vw,36px); }
  .home-tour-step { grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr); gap:34px; }
  .home-tour-step-title { margin-top:18px; font-size:clamp(2rem,3vw,3rem); line-height:1.08; }
  .home-tour-step-boundary { margin:16px 0; border-left:2px solid #527458; padding-left:12px; color:var(--slate); font-size:.72rem; line-height:1.6; }
  .home-tour-step-details summary { width:fit-content; min-height:44px; align-content:center; color:var(--ink); font-size:.75rem; font-weight:600; cursor:pointer; }
  .home-tour-step-details summary:focus-visible { outline:3px solid #be775d; outline-offset:4px; border-radius:3px; }
  .home-tour-step-facts { margin-top:8px; }
  .home-tour-step-fact { grid-template-columns:minmax(0,1fr); gap:6px; }
  .home-tour-step-fact dt { font-size:.65rem; }
  .home-tour-step-fact dd { font-size:.74rem; line-height:1.6; }
  .home-tour-step-links { margin-top:12px; gap:6px 18px; }
  .home-tour-step-links a, .home-tour-detail-link { display:inline-flex; min-height:44px; align-items:center; gap:6px; margin:0; font-size:.75rem; }
  .home-tour-evidence-note { margin:5px 0; font-size:.65rem; }
  .home-tour-controls { position:static; }
  .home-tour-step-visual { background:#e8ece5; }
  .home-tour-website-preview { max-height:420px; overflow:hidden; border-radius:14px; }
  @media(max-width:900px) {
    .home-tour-step { grid-template-columns:minmax(0,1fr); gap:22px; }
    .home-tour-step-visual { grid-row:1; }
    .home-tour-website-preview { max-height:300px; }
  }
  @media(max-width:640px) {
    .home-tour-frame { height:calc(100dvh - 16px); }
    .home-tour-header { padding:20px 18px 16px; gap:12px; }
    .home-tour-title { font-size:clamp(2rem,10vw,2.6rem); }
    .home-tour-progress { grid-template-columns:minmax(0,1fr); gap:10px; }
    .home-tour-step-list { padding:18px; }
    .home-tour-step-visual { padding:10px; }
    .home-tour-website-preview { max-height:260px; }
    .home-tour-controls button { min-height:44px; }
  }
  @media(max-height:640px) {
    .home-tour-frame { display:block; height:auto; overflow-y:auto; }
    .home-tour-step-list { overflow:visible; }
  }
</style>
