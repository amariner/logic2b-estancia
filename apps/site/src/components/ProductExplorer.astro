---
import type { Locale } from '@logic-estancia/config';
import { getHomeContract } from '../home-contract';
import { getPublishedPanels } from '../panel-portfolio';
import PanelPreview from './PanelPreview.astro';
import WebsitePreview from './WebsitePreview.astro';
import InterfaceIcon from './InterfaceIcon.astro';

const { locale } = Astro.props as { locale: Locale };
const home = getHomeContract(locale);
const en = locale === 'en';
const panelCount = getPublishedPanels(locale).length;
const icons = ['web', 'mail', 'calendar', 'users', 'check'] as const;
const titles = en
  ? ['A website that feels like you.', 'Every enquiry, in context.', 'Your stays at a glance.', 'Guest information, together.', 'A coordinated working day.']
  : ['Una web que habla de ti.', 'Cada consulta, con contexto.', 'Tus estancias, de un vistazo.', 'La información del huésped, reunida.', 'Un día a día coordinado.'];
const previewByArea = {
  solicitudes: 'enquiries',
  planning: 'planning',
  huespedes: 'guests-arrivals',
  operacion: 'preparation',
} as const;
---

<section id="producto" class="section product-explorer" aria-labelledby="product-explorer-title" data-product-explorer data-commercial-actions>
  <span id="gestor" class="anchor-target" aria-hidden="true"></span>
  <div class="shell">
    <div class="section-head product-explorer-heading">
      <p class="eyebrow">{en ? 'Explore the product' : 'Explora el producto'}</p>
      <h2 id="product-explorer-title" class="heading">{en ? 'Your accommodation, organised from start to finish.' : 'Tu alojamiento, organizado de principio a fin.'}</h2>
      <p>{en ? 'A website to attract guests, a workspace to coordinate and a clear view of daily work.' : 'Una web para atraer, un gestor para coordinar y una visión clara del trabajo diario.'}</p>
      <a class="text-link" href={en ? '/en/panels/' : '/paneles/'}>{en ? `Explore ${panelCount} workspace views` : `Explorar ${panelCount} vistas del gestor`} <span aria-hidden="true">→</span></a>
    </div>
    <div class="product-explorer-tabs" role="tablist" aria-label={en ? 'Logic2B Stays product areas' : 'Áreas del producto Logic2B Estancias'}>
      {home.productAreas.map((area, index) => (
        <button
          id={`product-tab-${area.id}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`product-panel-${area.id}`}
          tabindex={index === 0 ? 0 : -1}
          data-product-tab={area.id}
        ><InterfaceIcon name={icons[index]} />{area.title}</button>
      ))}
    </div>
    <div class="product-explorer-list">
      {home.productAreas.map((area, index) => (
        <article
          id={`product-panel-${area.id}`}
          class="product-explorer-item"
          data-product-area={area.id}
          role="tabpanel"
          aria-labelledby={`product-tab-${area.id}`}
          hidden={index !== 0}
        >
          <div class="product-explorer-detail">
            <span class="product-explorer-index">{en ? 'From' : 'Desde'} {area.plan}</span>
            <h3>{titles[index]}</h3>
            <p>{area.text}</p>
            <a class="text-link" href={area.href}>{area.cta} <span aria-hidden="true">→</span></a>
          </div>
          <figure class="product-explorer-visual">
            {area.id === 'web' ? (
              <WebsitePreview locale={locale} />
            ) : (
              <PanelPreview locale={locale} kind={previewByArea[area.id]} />
            )}
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-explorer]').forEach((explorer) => {
    const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[data-product-tab]')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('[data-product-area]')];
    const select = (index: number, moveFocus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      tabs[index]?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const target = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(target, true);
      });
    });
  });
</script>
