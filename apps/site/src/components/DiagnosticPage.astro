---
import type { Locale } from '@logic-estancia/config';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en'; const prefix = en ? '/en' : '';
const labels = en ? {
  eyebrow: 'Six useful questions · no sign-up', title: 'Find the next improvement your business can actually use.', body: 'You will see the recommendation before sharing any details. Capabilities determine the plan; scale only helps size implementation.', back: 'Back', next: 'Next', result: 'See recommendation', step: 'Step',
  plans: { basico: ['Basic', 'A managed brand website with SEO and no dashboard; email enquiries are scoped separately.'], gestion: ['Management', 'A read-only visual workspace for enquiries, planning and reports; live activation is scoped separately.'], inteligente: ['Intelligent', 'A visual operations centre for teams and incidents; channels, automation and AI require separate validation.'] },
} : {
  eyebrow: 'Seis preguntas útiles · sin registro', title: 'Descubre la siguiente mejora que tu negocio sí puede aprovechar.', body: 'Verás la recomendación antes de compartir ningún dato. Las capacidades deciden el plan; la escala solo ayuda a dimensionar la implantación.', back: 'Atrás', next: 'Siguiente', result: 'Ver recomendación', step: 'Paso',
  plans: { basico: ['Básico', 'Una web de marca gestionada con SEO y sin dashboard; las solicitudes por email se acotan aparte.'], gestion: ['Gestión', 'Un espacio visual de solo lectura para solicitudes, planning e informes; la activación real se acota aparte.'], inteligente: ['Inteligente', 'Un centro operativo visual para equipos e incidencias; canales, automatización e IA requieren validación independiente.'] },
};
---
<section class="commercial-hero diagnostic-hero shell"><p class="eyebrow">{labels.eyebrow}</p><h1 class="display">{labels.title}</h1><p>{labels.body}</p></section>
<section class="diagnostic-shell shell" data-diagnostic data-locale={locale} data-copy={JSON.stringify(labels)}>
  <aside aria-label={en ? 'Assessment progress' : 'Progreso del diagnóstico'}><span data-progress-text>{labels.step} 1/6</span><div class="progress"><i data-progress></i></div><ol>{(en ? ['Profile','Scale','Current setup','Bookings','Operations','Timing'] : ['Perfil','Escala','Situación actual','Reservas','Operación','Momento']).map((name, index) => <li data-step-label={index + 1} class={index === 0 ? 'active' : ''}><span>{index + 1}</span>{name}</li>)}</ol></aside>
  <div class="diagnostic-card artifact">
    <form data-assessment novalidate>
      <fieldset data-step="1"><legend>{en ? 'What kind of accommodation do you operate?' : '¿Qué tipo de alojamiento gestionas?'}</legend><p>{en ? 'This personalises examples and the recommended demo.' : 'Esto personaliza los ejemplos y la demo recomendada.'}</p><div class="choice-grid"><label><input type="radio" name="accommodationType" value="apartment" required/><span>{en ? 'Apartments' : 'Apartamentos'}</span></label><label><input type="radio" name="accommodationType" value="rural"/><span>{en ? 'Rural stays' : 'Alojamiento rural'}</span></label><label><input type="radio" name="accommodationType" value="hotel"/><span>Hotel</span></label></div><div class="inline-fields"><label>{en ? 'Operating model' : 'Modelo de operación'}<select name="businessMode" required><option value="mono">{en ? 'One property' : 'Una propiedad'}</option><option value="multi">{en ? 'Portfolio / multi-property' : 'Portfolio / multipropiedad'}</option></select></label></div></fieldset>
      <fieldset data-step="2" hidden><legend>{en ? 'What scale should the implementation support?' : '¿Qué escala debe soportar la implantación?'}</legend><p>{en ? 'Scale changes configuration and support, not the plan by itself.' : 'La escala cambia configuración y soporte, no el plan por sí sola.'}</p><div class="inline-fields"><label>{en ? 'Properties' : 'Propiedades'}<input type="number" name="propertyCount" min="1" max="10000" value="1" required/></label><label>{en ? 'Units or rooms' : 'Unidades o habitaciones'}<input type="number" name="unitCount" min="1" max="100000" value="1" required/></label></div></fieldset>
      <fieldset data-step="3" hidden><legend>{en ? 'What do you use today?' : '¿Qué utilizas actualmente?'}</legend><p>{en ? 'Choose every system or process involved.' : 'Selecciona todos los sistemas o procesos implicados.'}</p><div class="choice-grid checks">{[['website',en?'Website':'Web'],['email',en?'Email and spreadsheets':'Email y hojas de cálculo'],['booking-engine',en?'Booking engine':'Motor de reservas'],['calendar',en?'Shared calendar':'Calendario compartido'],['channels',en?'OTA / channels':'OTA / canales'],['pms','PMS']].map(([value,name]) => <label><input type="checkbox" name="currentStack" value={value}/><span>{name}</span></label>)}</div></fieldset>
      <fieldset data-step="4" hidden><legend>{en ? 'Which booking capabilities matter now?' : '¿Qué capacidades de reservas necesitas ahora?'}</legend><p>{en ? 'Selecting any of these introduces the Management workspace.' : 'Seleccionar cualquiera de ellas incorpora el dashboard Gestión.'}</p><div class="choice-grid checks">{[['enquiries',en?'Enquiries and alternatives':'Solicitudes y alternativas'],['bookings',en?'Bookings':'Reservas'],['planning','Planning'],['guests',en?'Guest profiles':'Perfiles de huéspedes'],['rates',en?'Rates':'Tarifas'],['web-editor',en?'Website editor':'Editor web']].map(([value,name]) => <label><input type="checkbox" name="bookingNeeds" value={value}/><span>{name}</span></label>)}</div></fieldset>
      <fieldset data-step="5" hidden><legend>{en ? 'Do you need an operations centre?' : '¿Necesitas un centro operativo?'}</legend><p>{en ? 'These capabilities point to Intelligent and are always scoped before real implementation.' : 'Estas capacidades orientan a Inteligente y siempre se validan antes de una implantación real.'}</p><div class="choice-grid checks">{[['cleaning',en?'Cleaning':'Limpieza'],['teams',en?'Teams and roles':'Equipos y roles'],['maintenance',en?'Maintenance':'Mantenimiento'],['channels',en?'Channels':'Canales'],['automation',en?'Automation':'Automatización'],['ai',en?'Supervised AI':'IA supervisada'],['metrics',en?'Advanced metrics':'Métricas avanzadas']].map(([value,name]) => <label><input type="checkbox" name="operationNeeds" value={value}/><span>{name}</span></label>)}</div></fieldset>
      <fieldset data-step="6" hidden><legend>{en ? 'When do you want to move and what range is realistic?' : '¿Cuándo quieres avanzar y qué rango es realista?'}</legend><p>{en ? 'This qualifies delivery, not the on-screen recommendation.' : 'Esto cualifica la entrega, no condiciona la recomendación visible.'}</p><div class="inline-fields"><label>{en ? 'Timeline' : 'Plazo'}<select name="timeline" required><option value="0-3">{en ? '0–3 months' : '0–3 meses'}</option><option value="3-6">{en ? '3–6 months' : '3–6 meses'}</option><option value="6-12">{en ? '6–12 months' : '6–12 meses'}</option><option value="exploring">{en ? 'Exploring' : 'Explorando'}</option></select></label><label>{en ? 'Implementation investment' : 'Inversión de implantación'}<select name="investmentRange" required><option value="under-3k">{en ? 'Under €3,000' : 'Menos de 3.000 €'}</option><option value="3k-8k">3.000–8.000 €</option><option value="8k-20k">8.000–20.000 €</option><option value="20k-plus">{en ? 'More than €20,000' : 'Más de 20.000 €'}</option><option value="unknown">{en ? 'To be defined' : 'Por definir'}</option></select></label></div></fieldset>
      <div class="diagnostic-actions"><button type="button" class="pill ghost" data-back hidden>{labels.back}</button><button type="button" class="pill" data-next>{labels.next} →</button></div>
    </form>
    <section class="diagnostic-result" data-result hidden aria-live="polite"><p class="eyebrow">{en ? 'Your starting point' : 'Tu punto de partida'}</p><span class="result-code" data-result-code>00</span><h2 data-result-name></h2><p data-result-description></p><ul data-result-reasons></ul><div class="result-links"><a class="pill" data-demo-link href="/demos/nivora/">{en ? 'Open recommended demo' : 'Abrir demo recomendada'} →</a><button class="pill ghost" type="button" data-edit>{en ? 'Review answers' : 'Revisar respuestas'}</button></div><div class="optional-contact"><p class="eyebrow">{en ? 'Optional next step' : 'Siguiente paso opcional'}</p><h3>{en ? 'Talk to us about this recommendation.' : 'Hablemos sobre esta recomendación.'}</h3><p data-handoff-copy>{en ? 'The sales form on the main page is the only form that sends a real enquiry. If you continue, this context is kept temporarily in this tab so you can review it before sending.' : 'El formulario comercial de la portada es el único que envía una solicitud real. Si continúas, este contexto se conserva temporalmente en esta pestaña para que puedas revisarlo antes de enviarlo.'}</p><a class="pill" data-sales-link href={en ? '/en/#contacto' : '/#contacto'}>{en ? 'Continue with this context' : 'Continuar con este contexto'} →</a></div></section>
  </div>
</section>
<script is:inline define:vars={{ locale, labels, prefix }}>
  const root = document.querySelector('[data-diagnostic]'); const assessment = root?.querySelector('[data-assessment]');
  const steps = [...(assessment?.querySelectorAll('[data-step]') || [])]; let current = 0; let recommendedPlan = 'basico';
  steps.forEach((step) => step.querySelector('legend')?.setAttribute('tabindex', '-1')); root?.querySelector('[data-result-name]')?.setAttribute('tabindex', '-1');
  const focusCurrentStep = () => steps[current]?.querySelector('legend')?.focus();
  const showStep = (index, trackStep = true) => { current = Math.max(0, Math.min(steps.length - 1, index)); root.dataset.currentStep = String(current + 1); steps.forEach((step, i) => step.hidden = i !== current); root.querySelector('[data-back]').hidden = current === 0; root.querySelector('[data-next]').textContent = current === steps.length - 1 ? `${labels.result} →` : `${labels.next} →`; root.querySelector('[data-progress]').style.width = `${((current + 1) / steps.length) * 100}%`; root.querySelector('[data-progress-text]').textContent = `${labels.step} ${current + 1}/${steps.length}`; root.querySelectorAll('[data-step-label]').forEach((item, i) => item.classList.toggle('active', i === current)); if (trackStep && root.dataset.analyticsEntry === 'active') window.estanciaTrack?.('assessment_step', { locale, step_index: current + 1, source_section: 'assessment' }); };
  const values = (name) => [...assessment.querySelectorAll(`[name="${name}"]:checked`)].map((input) => input.value);
  const finish = () => { const data = Object.fromEntries(new FormData(assessment)); const bookingNeeds = values('bookingNeeds'); const operationNeeds = values('operationNeeds'); recommendedPlan = operationNeeds.length ? 'inteligente' : bookingNeeds.length ? 'gestion' : 'basico'; window.estanciaTrack?.('assessment_submit', { locale, segment, plan: recommendedPlan, source_section: 'assessment' }); const contextSaved = window.estanciaAssessment?.save({ ...data, currentStack: values('currentStack'), requestedCapabilities: [...bookingNeeds, ...operationNeeds], propertyCount: Number(data.propertyCount), unitCount: Number(data.unitCount), plan: recommendedPlan, locale, web: handoffWeb, panel: handoffPanel, segment: handoffSegment, sourcePath: handoffSourcePath }) ?? false; const salesLink = root.querySelector('[data-sales-link]'); salesLink.href = contextSaved ? `${prefix}/?assessment=1#contacto` : `${prefix}/#contacto`; if (!contextSaved) root.querySelector('[data-handoff-copy]').textContent = locale === 'es' ? 'Tu navegador no permitió conservar el contexto. Puedes continuar al formulario comercial y completar allí los datos necesarios.' : 'Your browser could not keep this context. You can continue to the sales form and complete the required details there.';
    const plan = labels.plans[recommendedPlan]; const result = root.querySelector('[data-result]'); assessment.hidden = true; result.hidden = false; root.querySelector('[data-result-code]').textContent = recommendedPlan === 'basico' ? '00' : recommendedPlan === 'gestion' ? '01' : '02'; root.querySelector('[data-result-name]').textContent = plan[0]; root.querySelector('[data-result-description]').textContent = plan[1]; const reasons = [recommendedPlan === 'basico' ? (locale === 'es' ? 'Has priorizado la venta web sin operación de reservas.' : 'You prioritised web sales without booking operations.') : recommendedPlan === 'gestion' ? (locale === 'es' ? 'Necesitas operar reservas y contexto compartido.' : 'You need bookings and shared context.') : (locale === 'es' ? 'Has incluido coordinación operativa, automatización o IA.' : 'You included operations coordination, automation or AI.'), Number(data.unitCount) >= 12 ? (locale === 'es' ? 'El volumen requerirá dimensionar implantación y soporte.' : 'Scale will require sizing implementation and support.') : null].filter(Boolean); root.querySelector('[data-result-reasons]').replaceChildren(...reasons.map((text) => { const li = document.createElement('li'); li.textContent = text; return li; })); const demo = recommendedPlan === 'basico' ? 'nivora' : recommendedPlan === 'gestion' ? 'terrava' : 'aurem'; root.querySelector('[data-demo-link]').href = `${prefix}/demos/${demo}/`; window.estanciaTrack?.('assessment_complete', { locale, plan: recommendedPlan, source_section: 'assessment' }); result.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  root?.querySelector('[data-next]')?.addEventListener('click', () => { const controls = [...steps[current].querySelectorAll('input,select')]; if (!controls.every((control) => control.reportValidity())) return; if (current === steps.length - 1) { finish(); root.querySelector('[data-result-name]')?.focus(); } else { showStep(current + 1); focusCurrentStep(); } });
  root?.querySelector('[data-back]')?.addEventListener('click', () => { showStep(current - 1); focusCurrentStep(); }); root?.querySelector('[data-edit]')?.addEventListener('click', () => { root.querySelector('[data-result]').hidden = true; assessment.hidden = false; showStep(0); focusCurrentStep(); });
  const params = new URLSearchParams(location.search); const requestedSegment = params.get('segment'); const segment = ['hotels', 'rural', 'apartments', 'managers'].includes(requestedSegment) ? requestedSegment : 'unknown'; const handoffWeb = ['nivora', 'terrava', 'aurem'].includes(params.get('web') ?? '') ? params.get('web') : undefined; const handoffPanel = ['none', 'terrava', 'aurem'].includes(params.get('panel') ?? '') ? params.get('panel') : undefined; const handoffSourcePath = ['/', '/planes/', '/en/', '/en/plans/', '/webs/', '/en/webs/'].includes(params.get('sourcePath') ?? '') ? params.get('sourcePath') : undefined; const handoffSegment = ['rural', 'apartments', 'hotels'].includes(segment) ? segment : 'unknown'; root.dataset.segment = segment; const segmentType = { hotels: 'hotel', rural: 'rural', apartments: 'apartment', managers: 'rural' }[segment] || ''; const type = assessment?.querySelector(`[name="accommodationType"][value="${segmentType}"]`); if (type) type.checked = true; const properties = Number(params.get('properties')); const units = Number(params.get('units')); if (properties > 0) assessment.querySelector('[name="propertyCount"]').value = String(properties); if (units > 0) assessment.querySelector('[name="unitCount"]').value = String(units); const requestedPlan = params.get('plan'); if (requestedPlan === 'gestion') assessment.querySelector('[name="bookingNeeds"][value="bookings"]').checked = true; if (requestedPlan === 'inteligente') assessment.querySelector('[name="operationNeeds"][value="automation"]').checked = true; showStep(0, false);
</script>
<script>
  import { getConsent } from '../scripts/analytics-consent';
  import '../scripts/assessment-context';

  const diagnostic = document.querySelector<HTMLElement>('[data-diagnostic]');
  const allowedLocales = new Set(['es', 'en']);
  const allowedSegments = new Set(['rural', 'apartments', 'hotels', 'managers', 'unknown']);
  let assessmentEntryEmitted = false;
  let assessmentEntryPending: Promise<void> | null = null;

  function emitAssessmentEntry(): void {
    if (assessmentEntryEmitted || assessmentEntryPending || !diagnostic) return;
    if (!getConsent()?.analytics || !window.estanciaTrack) return;
    assessmentEntryPending = (async () => {
      const runtime = await window.estanciaRuntimeReady;
      if (assessmentEntryEmitted || runtime?.providers.analytics !== 'live' || !getConsent()?.analytics || !window.estanciaTrack) return;

      const { locale, segment, currentStep } = diagnostic.dataset;
      const stepIndex = Number(currentStep);
      if (!locale || !segment || !allowedLocales.has(locale) || !allowedSegments.has(segment) || !Number.isInteger(stepIndex) || stepIndex < 1 || stepIndex > 6) return;

      assessmentEntryEmitted = true;
      diagnostic.dataset.analyticsEntry = 'active';
      window.estanciaTrack('assessment_start', { locale, segment, source_section: 'assessment' });
      window.estanciaTrack('assessment_step', { locale, step_index: stepIndex, source_section: 'assessment' });
    })().finally(() => { assessmentEntryPending = null; });
  }

  window.addEventListener('estancia:consent-updated', emitAssessmentEntry);
  if (document.readyState === 'loading') window.addEventListener('DOMContentLoaded', emitAssessmentEntry, { once: true });
  else emitAssessmentEntry();
</script>
