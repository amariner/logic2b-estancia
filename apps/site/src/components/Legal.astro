---
import type { Locale } from '@logic-estancia/config';
const { locale, kind } = Astro.props as { locale: Locale; kind: 'legal' | 'privacy' | 'cookies' };
const es = {
  legal: ['Aviso legal', 'Este sitio presenta Logic Estancia, un producto de Logic2B. Las marcas Nivora One, Terrava Collection y Aurem Hotel son demostraciones ficticias. Contacto: hola@logic2b.com.'],
  privacy: ['Privacidad', 'El diagnóstico puede recoger nombre, empresa o alojamiento, email, teléfono opcional, tipo y dimensión del negocio, situación actual, capacidades, plan recomendado, plazo, inversión y origen para responder a una solicitud comercial. La base jurídica es tu consentimiento. El seguimiento comercial es opcional y separado. No vendemos los datos. Cloudflare aloja el servicio, Resend entrega el correo y HubSpot gestiona el contacto comercial cuando está configurado. Puedes ejercer tus derechos escribiendo a hola@logic2b.com.'],
  cookies: ['Cookies', 'El almacenamiento esencial conserva tu decisión de consentimiento y el estado local de las demos. Google Tag Manager y GA4 solo se cargan después de aceptar analítica. Las demos pueden medir hitos anónimos tras ese consentimiento, pero nunca envían nombres, textos, fechas, importes ni el estado introducido.'],
};
const en = {
  legal: ['Legal notice', 'This site presents Logic Estancia, a Logic2B product. Nivora One, Terrava Collection and Aurem Hotel are fictitious demonstrations. Contact: hola@logic2b.com.'],
  privacy: ['Privacy', 'The assessment may collect name, business or stay, email, optional phone, business type and size, current setup, requested capabilities, recommended plan, timeline, investment and source to answer a commercial request. The legal basis is your consent. Commercial follow-up is optional and separate. We do not sell data. Cloudflare hosts the service, Resend delivers email and HubSpot manages the commercial contact when configured. Contact hola@logic2b.com to exercise your rights.'],
  cookies: ['Cookies', 'Essential storage keeps your consent choice and local demo state. Google Tag Manager and GA4 load only after analytics consent. Demos may measure anonymous milestones after that consent, but never send names, text, dates, amounts or entered demo state.'],
};
const [title, body] = (locale === 'es' ? es : en)[kind];
---
<div class="prose shell"><p class="eyebrow">Logic Estancia · by Logic2B</p><h1>{title}</h1><p>{body}</p><h2>{locale === 'es' ? 'Última revisión' : 'Last reviewed'}</h2><p>17·08·2026</p></div>
