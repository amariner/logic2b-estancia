---
import type { Locale } from '@logic-estancia/config';
import { getPlanCards, planHandoffHref } from '../plan-contract';
import { getWebPortfolio, type WebPortfolioConcept } from '../web-portfolio';
import ContextualGuides from './ContextualGuides.astro';
import PortfolioViewAnalytics from './PortfolioViewAnalytics.astro';

const { locale, concept } = Astro.props as { locale: Locale; concept: WebPortfolioConcept };
const en = locale === 'en';
const plan = getPlanCards(locale).find((candidate) => candidate.id === concept.plan);
if (!plan) throw new Error(`missing_plan_for_concept:${concept.slug}`);
const assessmentHref = planHandoffHref(locale, plan, en ? '/en/webs/' : '/webs/', concept.vertical);
const portfolioHref = en ? '/en/webs/' : '/webs/';
const portfolioCount = getWebPortfolio(locale).length;
const sourceSet = concept.status === 'canonical'
  ? `/media/${concept.slug}/hero-640.avif 640w, /media/${concept.slug}/hero-960.avif 960w, /media/${concept.slug}/hero-1600.avif 1600w`
  : `/media/${concept.slug}/hero-640.avif 640w, /media/${concept.slug}/hero-960.avif 960w, /media/${concept.slug}/hero-1280.avif 1280w`;
---
<PortfolioViewAnalytics event="web_view" locale={locale} web={concept.slug} plan={concept.plan} />
<article class={`web-concept web-concept-${concept.slug}`} data-web-concept={concept.slug}>
  <header class="web-concept-notice shell">
    <p><strong>{concept.status === 'canonical' ? (en ? 'Canonical fictional case' : 'Caso canónico ficticio') : (en ? 'Fictional website concept' : 'Concepto web ficticio')}</strong><span>{concept.status === 'canonical' ? (en ? 'Product evidence · no real property or customer' : 'Evidencia de producto · no representa un alojamiento o cliente real') : (en ? 'Original visual direction · no real property or customer' : 'Dirección visual original · no representa un alojamiento o cliente real')}</span></p>
    <a href={portfolioHref}>{en ? 'Back to all websites' : 'Volver a todas las webs'} <span aria-hidden="true">↗</span></a>
  </header>

  <section class="web-concept-hero" aria-labelledby="web-concept-title">
    <picture>
      <source type="image/avif" srcset={sourceSet} sizes="100vw" />
      <img src={concept.image} alt={concept.imageAlt} width="1600" height="1067" fetchpriority="high" decoding="async" />
    </picture>
    <div class="web-concept-shade"></div>
    <nav aria-label={en ? `${concept.brand} concept navigation` : `Navegación del concepto ${concept.brand}`}>
      <a class="web-concept-brand" href="#inicio">{concept.brand}</a>
      <div><a href="#estancia">{en ? 'The stay' : 'La estancia'}</a><a href="#recorrido">{en ? 'The journey' : 'El recorrido'}</a><a href="#alcance">{en ? 'Scope' : 'Alcance'}</a></div>
    </nav>
    <div id="inicio" class="web-concept-hero-copy">
      <p>{concept.showcase.eyebrow}</p>
      <h1 id="web-concept-title">{concept.showcase.title}</h1>
      <p>{concept.showcase.intro}</p>
      <a href="#estancia">{en ? 'Discover the concept' : 'Descubrir el concepto'} <span aria-hidden="true">↓</span></a>
    </div>
    <p class="web-concept-plan">{concept.verticalLabel}<span>{concept.planLabel}</span></p>
  </section>

  <section id="estancia" class="web-concept-intro shell" aria-labelledby="web-concept-intro-title">
    <div>
      <p class="eyebrow">{en ? 'Visual direction' : 'Dirección visual'}</p>
      <h2 id="web-concept-intro-title">{concept.visualIntent}</h2>
    </div>
    <div>
      <p class="eyebrow">{en ? 'Business starting point' : 'Punto de partida del negocio'}</p>
      <p>{concept.businessProblem}</p>
      <ul>{concept.visiblePages.map((page) => <li>{page}</li>)}</ul>
    </div>
  </section>

  <section id="recorrido" class="web-concept-moments" aria-labelledby="web-concept-moments-title">
    <div class="shell">
      <p class="eyebrow">{en ? 'A website with a reason for every section' : 'Una web con una razón para cada sección'}</p>
      <h2 id="web-concept-moments-title">{en ? 'The visual system supports a commercial journey.' : 'El sistema visual sostiene un recorrido comercial.'}</h2>
      <ol>{concept.showcase.moments.map((moment) => <li><span>{moment.number}</span><h3>{moment.title}</h3><p>{moment.text}</p></li>)}</ol>
    </div>
  </section>

  <section id="alcance" class="web-concept-boundary shell" aria-labelledby="web-concept-boundary-title">
    <div><p class="eyebrow">{concept.boundaryLabel}</p><h2 id="web-concept-boundary-title">{en ? 'A visual concept is evidence of direction, not live operations.' : 'Un concepto visual demuestra dirección, no operaciones reales.'}</h2></div>
    <div><p>{concept.boundary}</p><p>{en ? `The ${concept.planLabel} starting point is based on required capabilities. This route adds no provider, booking, message, payment or external write.` : `El punto de partida ${concept.planLabel} responde a las capacidades necesarias. Esta ruta no añade proveedor, reserva, mensaje, pago ni escritura externa.`}</p></div>
  </section>

  <ContextualGuides locale={locale} contextId="webs" />

  <footer class="web-concept-next shell">
    <div><p class="eyebrow">{en ? 'Continue with evidence' : 'Continúa con evidencia'}</p><h2>{en ? 'Compare this direction with the full portfolio.' : 'Compara esta dirección con el portfolio completo.'}</h2></div>
    <div>{concept.status === 'canonical' && <a class="text-link" href={concept.demoHref}>{concept.demoCta} <span aria-hidden="true">↗</span></a>}<a class="text-link" href={portfolioHref}>{en ? `See all ${portfolioCount} website directions` : `Ver las ${portfolioCount} direcciones web`} <span aria-hidden="true">→</span></a><a class="pill" href={assessmentHref}>{concept.assessmentCta} <span aria-hidden="true">→</span></a></div>
  </footer>
</article>
