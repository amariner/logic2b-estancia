---
import type { Locale } from '@logic-estancia/config';
import { getPanelPortfolio, type PanelPortfolioItem, type PanelPreviewKind } from '../panel-portfolio';
import PanelPreviewDialog from './PanelPreviewDialog.astro';
import PanelPreview from './PanelPreview.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const prefix = en ? '/en' : '';
type NavigablePanel = PanelPortfolioItem & {
  detailHref: string;
  evidenceHref: string;
  preview: PanelPreviewKind;
};
const panels = getPanelPortfolio(locale).filter((panel): panel is NavigablePanel => (
  panel.detailHref !== null && panel.evidenceHref !== null && panel.preview !== null
));
if (panels.length !== 6) throw new Error(`home_panel_showcase_expected_six:${locale}:${panels.length}`);

const labels = en ? {
  eyebrow: 'Inside the workspace',
  title: 'Every task in its place.',
  intro: 'Enquiries, planning, arrivals and teams. Six views to discover how you could work.',
  all: 'See all six workspaces',
  previous: 'Show previous workspaces',
  next: 'Show next workspaces',
  preview: 'Open preview',
  detail: 'Open workspace page',
  close: 'Close workspace preview',
  decision: 'Decision it supports',
  boundary: 'Where the evidence stops',
  exact: 'Open exact local evidence',
  newTab: 'opens in a new tab',
  note: 'Fictitious local evidence. It sends no message, booking, payment or external update.',
  carousel: 'Verified workspace carousel',
} : {
  eyebrow: 'El gestor, por dentro',
  title: 'Cada tarea, en su sitio.',
  intro: 'Solicitudes, planning, llegadas y equipo. Seis vistas para descubrir cómo trabajarías.',
  all: 'Ver los seis paneles',
  previous: 'Mostrar paneles anteriores',
  next: 'Mostrar paneles siguientes',
  preview: 'Abrir vista previa',
  detail: 'Abrir ficha del panel',
  close: 'Cerrar vista previa del panel',
  decision: 'Decisión que acompaña',
  boundary: 'Dónde termina la evidencia',
  exact: 'Abrir evidencia local exacta',
  newTab: 'se abre en otra pestaña',
  note: 'Evidencia local ficticia. No envía mensajes, reservas, pagos ni actualizaciones externas.',
  carousel: 'Carrusel de paneles verificados',
};
---

<section id="paneles" class="home-panel-showcase section" aria-labelledby="home-panel-showcase-title" data-home-panel-showcase>
  <div class="home-panel-shell shell">
    <header class="home-panel-heading">
      <div class="home-panel-heading-copy">
        <p class="home-panel-eyebrow eyebrow">{labels.eyebrow}</p>
        <h2 id="home-panel-showcase-title" class="home-panel-title heading">{labels.title}</h2>
      </div>
      <div class="home-panel-heading-intro">
        <p>{labels.intro}</p>
        <a class="home-panel-all-link text-link" href={`${prefix}/${en ? 'panels' : 'paneles'}/`}>{labels.all} <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <div class="home-panel-controls" aria-label={labels.carousel}>
      <button class="home-panel-control home-panel-control-previous" type="button" aria-label={labels.previous} data-home-panel-previous disabled>
        <span aria-hidden="true">←</span>
      </button>
      <button class="home-panel-control home-panel-control-next" type="button" aria-label={labels.next} data-home-panel-next>
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="home-panel-viewport" data-home-panel-viewport tabindex="0" role="region" aria-label={labels.carousel}>
      <div class="home-panel-track" data-home-panel-track>
        {panels.map((panel, index) => (
          <article
            class="home-panel-card"
            data-home-panel-card={panel.id}
            aria-label={`${index + 1} / ${panels.length}: ${panel.title}`}
          >
            <div class="home-panel-card-visual">
              <PanelPreview locale={locale} kind={panel.preview} compact />
              <span class="home-panel-card-plan">{panel.planLabel}</span>
            </div>
            <div class="home-panel-card-copy">
              <p class="home-panel-card-meta">{panel.number} · {panel.planLabel}</p>
              <h3 class="home-panel-card-title">{panel.title}</h3>
              <p class="home-panel-card-summary">{panel.summary}</p>
              <div class="home-panel-card-actions">
                <button
                  class="home-panel-preview-button"
                  type="button"
                  aria-haspopup="dialog"
                  aria-controls={`home-panel-dialog-${panel.id}`}
                  data-home-panel-dialog-open={`home-panel-dialog-${panel.id}`}
                >{labels.preview} <span aria-hidden="true">↗</span></button>
                <a class="home-panel-detail-link" href={panel.detailHref}>{labels.detail} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  {panels.map((panel) => <PanelPreviewDialog locale={locale} panel={panel} sourcePath={en ? '/en/' : '/'} />)}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-panel-showcase]').forEach((showcase) => {
    const viewport = showcase.querySelector<HTMLElement>('[data-home-panel-viewport]');
    const track = showcase.querySelector<HTMLElement>('[data-home-panel-track]');
    const previous = showcase.querySelector<HTMLButtonElement>('[data-home-panel-previous]');
    const next = showcase.querySelector<HTMLButtonElement>('[data-home-panel-next]');
    const firstCard = showcase.querySelector<HTMLElement>('[data-home-panel-card]');
    if (!viewport || !track || !previous || !next || !firstCard) return;

    const updateControls = () => {
      const maximum = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      previous.disabled = viewport.scrollLeft <= 2;
      next.disabled = maximum <= 2 || viewport.scrollLeft >= maximum - 2;
    };
    const move = (direction: number) => {
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
      viewport.scrollBy({
        left: direction * (firstCard.offsetWidth + gap),
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    viewport.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(viewport);
    window.addEventListener('resize', updateControls, { passive: true });
    updateControls();
  });

</script>
