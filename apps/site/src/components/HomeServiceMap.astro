---
import type { Locale } from '@logic-estancia/config';
import { getServiceMap } from '../service-map';
import InterfaceIcon from './InterfaceIcon.astro';

const { locale, plansHref = '#planes' } = Astro.props as { locale: Locale; plansHref?: string };
const en = locale === 'en';
const map = getServiceMap(locale);
const icons = { guest: 'users', web: 'web', enquiry: 'mail', workspace: 'calendar', operations: 'chart' } as const;
const record = en
  ? [['Dates', 'Aug 21–24'], ['Guests', '4'], ['Property', 'Casa Aira'], ['Alternative', 'Casa Bruma']]
  : [['Fechas', '21–24 ago'], ['Huéspedes', '4'], ['Alojamiento', 'Casa Aira'], ['Alternativa', 'Casa Bruma']];
const planLabel = { basico: en ? 'Basic' : 'Básico', gestion: en ? 'Management' : 'Gestión', inteligente: en ? 'Intelligent' : 'Inteligente' } as const;
---
<section class="service-map section" aria-labelledby="service-map-title" data-service-map>
  <div class="shell">
    <header class="service-map-head">
      <div>
        <p class="eyebrow">{map.eyebrow}</p>
        <h2 id="service-map-title" class="heading">{map.title}</h2>
      </div>
      <p>{map.lead}</p>
    </header>

    <figure class="service-map-figure">
      <div class="service-map-bar" aria-hidden="true"><span><i></i>{en ? 'Stay journey · illustrative' : 'Recorrido de una estancia · ilustrativo'}</span><span>{en ? '5 stages · 3 plans' : '5 etapas · 3 planes'}</span></div>

      <ol class="service-map-flow" aria-label={map.flowLabel}>
        {map.stages.map((stage, index) => (
          <li class="service-map-stage" data-service-stage={stage.id} data-from={stage.from ?? 'guest'}>
            <div class="service-map-stage-top">
              <span class="service-map-index">{stage.index}</span>
              <span class="service-map-icon"><InterfaceIcon name={icons[stage.id]} /></span>
            </div>
            <strong>{stage.name}</strong>
            <p>{stage.role}</p>
            {stage.id === 'enquiry' ? (
              <dl class="service-map-record" aria-label={en ? 'Fictional enquiry example' : 'Ejemplo de solicitud ficticia'}>
                {record.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
              </dl>
            ) : (
              <ul class="service-map-details">{stage.details.map(detail => <li>{detail}</li>)}</ul>
            )}
            <span class="service-map-from">{stage.from ? (en ? `From ${planLabel[stage.from]}` : `Desde ${planLabel[stage.from]}`) : (en ? 'Starting point' : 'Punto de partida')}</span>
            {index < map.handoffs.length && <span class="service-map-handoff" aria-hidden="true"><em>{map.handoffs[index]}</em></span>}
          </li>
        ))}
      </ol>

      <div class="service-map-coverage">
        <h3>{map.coverageTitle}</h3>
        <div class="service-map-ticks" aria-hidden="true">{map.stages.map(stage => <span>{stage.index}</span>)}</div>
        <ul aria-label={map.coverageLabel}>
          {map.coverage.map(row => (
            <li data-coverage-plan={row.plan} style={`--span:${row.span}`}>
              <span class="service-map-bar-track" aria-hidden="true">{map.stages.map(() => <i></i>)}</span>
              <span class="service-map-bar-fill"><b>{row.name}</b><span>{row.label}</span></span>
              <span class="sr-only">{en ? `covers ${row.span} of ${map.stages.length} stages` : `cubre ${row.span} de ${map.stages.length} etapas`}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="service-map-base">
        <strong><span aria-hidden="true">L2B</span>{map.serviceTitle}</strong>
        <ul>{map.service.map(item => <li>{item}</li>)}</ul>
      </div>
      <figcaption>{map.note} <a class="text-link" href={plansHref}>{map.plansCta}<span aria-hidden="true"> →</span></a></figcaption>
    </figure>
  </div>
</section>

<style>
  .service-map { background: var(--paper); }
  .service-map-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(28px, 6vw, 96px); align-items: end; }
  .service-map-head .heading { margin: 0; max-width: 640px; }
  .service-map-head > p { max-width: 520px; margin: 0; color: var(--slate); font-size: 1rem; line-height: 1.7; }
  .service-map-figure { margin: clamp(36px, 5vw, 56px) 0 0; border: 1px solid var(--l2b-line); border-radius: var(--l2b-radius-lg); padding: 0 clamp(16px, 2.4vw, 32px) clamp(20px, 2.4vw, 28px); background: var(--l2b-surface); background-image: var(--l2b-grid); background-size: 24px 24px; box-shadow: var(--l2b-shadow-md); }
  .service-map-bar { display: flex; justify-content: space-between; gap: 16px; margin: 0 calc(clamp(16px, 2.4vw, 32px) * -1); border-bottom: 1px solid var(--l2b-line); border-radius: var(--l2b-radius-lg) var(--l2b-radius-lg) 0 0; padding: 12px clamp(16px, 2.4vw, 32px); color: var(--l2b-muted); background: var(--l2b-mist); font: 500 .6875rem/1.4 var(--mono); letter-spacing: .04em; }
  .service-map-bar span { display: inline-flex; min-width: 0; align-items: center; gap: 8px; overflow-wrap: anywhere; }
  .service-map-bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--l2b-signal); box-shadow: 0 0 0 3px var(--l2b-signal-soft); }

  .service-map-flow { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 56px; margin: 28px 0 0; padding: 0; list-style: none; }
  .service-map-stage { position: relative; display: flex; min-width: 0; overflow-wrap: anywhere; flex-direction: column; border: 1px solid var(--l2b-line); border-radius: var(--l2b-radius-md); padding: 16px; background: var(--l2b-surface); }
  .service-map-stage[data-from='guest'] { border-style: dashed; background: var(--l2b-mist); }
  .service-map-stage[data-from='gestion'] { border-top: 3px solid var(--l2b-signal); }
  .service-map-stage[data-from='inteligente'] { border-top: 3px solid var(--l2b-forest); }
  .service-map-stage[data-from='basico'] { border-top: 3px solid #9fcdb2; }
  .service-map-stage-top { display: flex; align-items: center; justify-content: space-between; }
  .service-map-index { color: var(--l2b-muted); font: 500 .6875rem var(--mono); }
  .service-map-icon { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; color: var(--l2b-forest); background: var(--l2b-signal-soft); }
  .service-map-stage > strong { margin-top: 18px; font: 400 1.35rem/1.1 var(--serif); letter-spacing: -.01em; }
  .service-map-stage > p { margin: 8px 0 14px; color: var(--slate); font-size: .8125rem; line-height: 1.5; }
  .service-map-details { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 14px; padding: 0; list-style: none; }
  .service-map-details li { border: 1px solid var(--l2b-line); border-radius: 6px; padding: 3px 7px; color: var(--l2b-slate); background: var(--l2b-paper); font-size: .6875rem; }
  .service-map-record { display: grid; gap: 0; margin: 0 0 14px; border: 1px solid var(--l2b-line); border-radius: 8px; overflow: hidden; font-size: .6875rem; }
  .service-map-record div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; border-top: 1px solid var(--l2b-line); padding: 5px 8px; }
  .service-map-record div:first-child { border-top: 0; }
  .service-map-record div:last-child { background: var(--l2b-amber-soft); }
  .service-map-record dt { color: var(--l2b-muted); }
  .service-map-record dd { margin: 0; font-family: var(--mono); font-weight: 500; text-align: right; }
  .service-map-from { margin-top: auto; border-top: 1px solid var(--l2b-line); padding-top: 10px; color: var(--l2b-signal-text); font: 500 .6875rem var(--mono); letter-spacing: .02em; }
  .service-map-stage[data-from='guest'] .service-map-from { color: var(--l2b-muted); }
  .service-map-handoff { position: absolute; z-index: 1; top: 50%; right: -56px; display: grid; width: 56px; place-items: center; transform: translateY(-50%); }
  .service-map-handoff::before { position: absolute; top: 50%; left: 6px; right: 8px; height: 1px; background: var(--l2b-forest); content: ''; }
  .service-map-handoff::after { position: absolute; top: calc(50% - 4px); right: 8px; width: 7px; height: 7px; border-top: 1px solid var(--l2b-forest); border-right: 1px solid var(--l2b-forest); transform: rotate(45deg); content: ''; }
  .service-map-handoff em { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); color: var(--l2b-muted); font: normal 500 .5625rem var(--mono); white-space: nowrap; }

  .service-map-coverage { margin-top: 30px; border-top: 1px solid var(--l2b-line); padding-top: 22px; }
  .service-map-coverage h3 { margin: 0 0 14px; font: 500 .75rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--l2b-slate); }
  .service-map-ticks { display: none; }
  .service-map-coverage ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .service-map-coverage li { --gap: 56px; position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: var(--gap); min-height: 38px; }
  .service-map-bar-track { display: contents; }
  .service-map-bar-track i { grid-row: 1; border-radius: 8px; background: var(--l2b-mist); }
  .service-map-bar-track i:nth-child(1) { grid-column: 1; } .service-map-bar-track i:nth-child(2) { grid-column: 2; } .service-map-bar-track i:nth-child(3) { grid-column: 3; } .service-map-bar-track i:nth-child(4) { grid-column: 4; } .service-map-bar-track i:nth-child(5) { grid-column: 5; }
  .service-map-bar-fill { z-index: 1; display: flex; grid-row: 1; grid-column: 1 / span var(--span); min-width: 0; align-items: center; gap: 10px; border-radius: 8px; padding: 8px 12px; color: var(--l2b-ink); font-size: .75rem; line-height: 1.3; }
  .service-map-bar-fill b { flex: 0 1 auto; min-width: 0; font-weight: 700; overflow-wrap: anywhere; }
  .service-map-bar-fill b::after { margin-left: 10px; opacity: .45; content: '/'; }
  .service-map-bar-fill span { min-width: 0; font-weight: 500; overflow-wrap: anywhere; }
  [data-coverage-plan='basico'] .service-map-bar-fill { background: #cfe8d9; }
  [data-coverage-plan='gestion'] .service-map-bar-fill { color: white; background: var(--l2b-signal-text); }
  [data-coverage-plan='inteligente'] .service-map-bar-fill { color: white; background: var(--l2b-forest); }

  .service-map-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-top: 18px; border: 1px dashed var(--l2b-line-strong); border-radius: var(--l2b-radius-md); padding: 14px 16px; background: var(--l2b-paper); }
  .service-map-base strong { min-width: 0; overflow-wrap: anywhere; display: inline-flex; align-items: center; gap: 10px; font-size: .875rem; font-weight: 600; }
  .service-map-base strong span { display: grid; min-width: 36px; height: 24px; place-items: center; border-radius: 6px; color: white; background: var(--l2b-forest); font: 600 .625rem var(--mono); }
  .service-map-base ul { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; }
  .service-map-base li { display: inline-flex; align-items: center; gap: 7px; color: var(--slate); font-size: .8125rem; }
  .service-map-base li::before { width: 5px; height: 5px; border-radius: 50%; background: var(--l2b-signal); content: ''; }
  .service-map-figure figcaption { margin-top: 16px; color: var(--l2b-muted); font-size: .75rem; line-height: 1.55; }
  .service-map-figure figcaption a { margin-left: 4px; color: var(--ink); font-weight: 600; }

  @media (max-width: 1080px) {
    .service-map-flow { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .service-map-stage { display: grid; grid-template-columns: 42px minmax(0, 1fr); column-gap: 14px; }
    .service-map-stage-top { grid-row: span 5; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; }
    .service-map-stage > strong { margin-top: 0; }
    .service-map-stage > * { grid-column: 2; }
    .service-map-stage > .service-map-stage-top { grid-column: 1; }
    .service-map-handoff { top: auto; right: auto; bottom: -18px; left: 36px; width: 18px; height: 18px; transform: none; }
    .service-map-handoff::before { top: 2px; bottom: 5px; left: 50%; right: auto; width: 1px; height: auto; }
    .service-map-handoff::after { top: auto; bottom: 5px; left: calc(50% - 3.5px); right: auto; transform: rotate(135deg); }
    .service-map-handoff em { bottom: auto; top: 50%; left: 24px; transform: translateY(-50%); white-space: normal; }
    .service-map-ticks { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin: 0 0 6px; color: var(--l2b-muted); font: 500 .625rem var(--mono); }
    .service-map-coverage li { --gap: 4px; }
    .service-map-bar-fill { flex-direction: column; align-items: flex-start; gap: 2px; }
    .service-map-bar-fill b::after { content: none; }
  }
  @media (max-width: 760px) {
    .service-map-head { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .service-map-bar span:last-child { display: none; }
    .service-map-bar-fill { padding: 7px 8px; font-size: .6875rem; }
    .service-map-base { flex-direction: column; align-items: flex-start; }
  }
</style>
