---
import type { Locale } from '@logic-estancia/config';
import { getWebPortfolio } from '../web-portfolio';
import ContextualGuides from './ContextualGuides.astro';
import WebPortfolioCard from './WebPortfolioCard.astro';

const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const concepts = getWebPortfolio(locale);
const sourcePath = en ? '/en/webs/' : '/webs/';
const copy = en ? {
  eyebrow: 'Web portfolio', title: 'Find your accommodation’s style.', intro: 'Twelve website designs for rural stays, apartments and hotels. Explore the style that fits your accommodation. All examples are fictional; they represent no customers and make no live bookings, payments or communications.', collection: 'Find your style', collectionNote: 'Filter, preview and explore each design at your own pace.', searchLegend: 'Search', searchPlaceholder: 'Name, style or business need', verticalLegend: 'Accommodation type', planLegend: 'Starting plan', all: 'All', rural: 'Rural stays', apartments: 'Apartments', hotels: 'Hotel', basic: 'Basic', management: 'Management', intelligent: 'Intelligent', result: 'Showing 12 navigable concepts', empty: 'No concept matches this search and filter combination. Try another term or selection.', ctaEyebrow: 'A considered next step', ctaTitle: 'Not sure which plan you need?', ctaBody: 'Answer a few questions about how you work to find a starting plan.', cta: 'Start the assessment',
} : {
  eyebrow: 'Portfolio web', title: 'Encuentra el estilo de tu alojamiento.', intro: 'Doce diseños web para casas rurales, apartamentos y hoteles. Explora el estilo que encaja con tu alojamiento. Todos los ejemplos son ficticios; no representan clientes ni ejecutan reservas, pagos o comunicaciones reales.', collection: 'Encuentra tu estilo', collectionNote: 'Filtra, abre la vista previa y explora cada diseño a tu ritmo.', searchLegend: 'Buscar', searchPlaceholder: 'Nombre, estilo o necesidad de negocio', verticalLegend: 'Tipo de alojamiento', planLegend: 'Plan de partida', all: 'Todos', rural: 'Casa rural', apartments: 'Apartamentos', hotels: 'Hotel', basic: 'Básico', management: 'Gestión', intelligent: 'Inteligente', result: 'Mostrando 12 conceptos navegables', empty: 'Ningún concepto coincide con la búsqueda y los filtros. Prueba otro término o selección.', ctaEyebrow: 'Un siguiente paso con criterio', ctaTitle: '¿No sabes qué plan necesitas?', ctaBody: 'Responde unas preguntas sobre cómo trabajas y encuentra un plan de partida.', cta: 'Empezar diagnóstico',
};
---
<div data-web-portfolio>
<section class="portfolio-hero section"><div class="shell"><p class="eyebrow">{copy.eyebrow}</p><h1 class="display">{copy.title}</h1><p class="portfolio-intro">{copy.intro}</p></div></section>
<section class="section portfolio-catalog" aria-labelledby="portfolio-catalog-title">
  <div class="shell">
    <div class="portfolio-catalog-heading"><div><p class="eyebrow">{copy.collection}</p><h2 id="portfolio-catalog-title" class="heading">{en ? 'Choose how to welcome your guests.' : 'Elige cómo dar la bienvenida.'}</h2></div><p>{copy.collectionNote}</p></div>
    <div class="portfolio-filters" aria-label={en ? 'Filter portfolio concepts' : 'Filtrar conceptos del portfolio'}>
      <fieldset class="portfolio-search"><legend>{copy.searchLegend}</legend><label class="sr-only" for="portfolio-search-input">{copy.searchPlaceholder}</label><input id="portfolio-search-input" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" data-portfolio-search /></fieldset>
      <fieldset><legend>{copy.verticalLegend}</legend><div class="portfolio-filter-list">{[['all', copy.all], ['rural', copy.rural], ['apartments', copy.apartments], ['hotels', copy.hotels]].map(([value, label], index) => <button type="button" class={index === 0 ? 'is-active' : ''} aria-pressed={index === 0 ? 'true' : 'false'} data-portfolio-vertical-filter={value}>{label}</button>)}</div></fieldset>
      <fieldset><legend>{copy.planLegend}</legend><div class="portfolio-filter-list">{[['all', copy.all], ['basico', copy.basic], ['gestion', copy.management], ['inteligente', copy.intelligent]].map(([value, label], index) => <button type="button" class={index === 0 ? 'is-active' : ''} aria-pressed={index === 0 ? 'true' : 'false'} data-portfolio-plan-filter={value}>{label}</button>)}</div></fieldset>
    </div>
    <p class="portfolio-filter-status" data-portfolio-filter-status aria-live="polite">{copy.result}</p>
    <div class="portfolio-grid">{concepts.map((concept) => <WebPortfolioCard locale={locale} concept={concept} sourcePath={sourcePath} />)}</div>
    <p class="portfolio-filter-empty" data-portfolio-filter-empty hidden>{copy.empty}</p>
  </div>
</section>
<ContextualGuides locale={locale} contextId="webs" />
<section class="section shell final-cta portfolio-final"><p class="eyebrow">{copy.ctaEyebrow}</p><h2 class="heading">{copy.ctaTitle}</h2><p>{copy.ctaBody}</p><a class="pill" href={`${en ? '/en' : ''}/${en ? 'assessment' : 'diagnostico'}/`} data-track="cta_click" data-section="web_portfolio">{copy.cta} <span aria-hidden="true">→</span></a></section>
</div>

<script is:inline define:vars={{ locale, result: copy.result }}>
  const portfolio = document.querySelector('[data-web-portfolio]');
  const cards = portfolio ? [...portfolio.querySelectorAll('[data-portfolio-card]')] : [];
  const status = portfolio?.querySelector('[data-portfolio-filter-status]');
  const empty = portfolio?.querySelector('[data-portfolio-filter-empty]');
  let activeVertical = 'all';
  let activePlan = 'all';
  let activeSearch = '';
  const refresh = () => {
    let visible = 0;
    cards.forEach((card) => {
      const searchable = (card.dataset.portfolioSearchText ?? card.textContent ?? '').toLocaleLowerCase(locale);
      const matches = (activeVertical === 'all' || card.dataset.portfolioVertical === activeVertical)
        && (activePlan === 'all' || card.dataset.portfolioPlan === activePlan)
        && (!activeSearch || searchable.includes(activeSearch));
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (status) status.textContent = visible === cards.length ? result : `${visible} ${locale === 'en' ? 'navigable concepts shown' : 'conceptos navegables visibles'}`;
    if (empty) empty.hidden = visible !== 0;
  };
  const updateFilter = (kind, value) => {
    if (kind === 'vertical') activeVertical = value;
    else activePlan = value;
    portfolio?.querySelectorAll(kind === 'vertical' ? '[data-portfolio-vertical-filter]' : '[data-portfolio-plan-filter]').forEach((button) => {
      const selected = button.dataset[kind === 'vertical' ? 'portfolioVerticalFilter' : 'portfolioPlanFilter'] === (kind === 'vertical' ? activeVertical : activePlan);
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    refresh();
  };
  portfolio?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-portfolio-vertical-filter], [data-portfolio-plan-filter]') : null;
    if (!target) return;
    updateFilter(target.dataset.portfolioVerticalFilter ? 'vertical' : 'plan', target.dataset.portfolioVerticalFilter ?? target.dataset.portfolioPlanFilter ?? 'all');
  });
  portfolio?.querySelector('[data-portfolio-search]')?.addEventListener('input', (event) => {
    activeSearch = event.target instanceof HTMLInputElement ? event.target.value.trim().toLocaleLowerCase(locale) : '';
    refresh();
  });
</script>
