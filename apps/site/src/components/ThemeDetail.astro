---
import type { Locale } from '@logic-estancia/config';
import { getWebPortfolio, type WebPortfolioConcept } from '../web-portfolio';
import { themeAnatomy, themeBenefits, themeCompositionLabel, themeDetailHref, themeProcess, themeRequestHref } from '../theme-detail';
import { getWebThemeVisual } from '../web-theme-visuals';
import { getPlanCards } from '../plan-contract';
import { PLAN_PRICING, euro } from '../pricing';
import WebMiniature from './WebMiniature.astro';
import InterfaceIcon from './InterfaceIcon.astro';
import HomeClosing from './HomeClosing.astro';
import PortfolioViewAnalytics from './PortfolioViewAnalytics.astro';

const { locale, concept } = Astro.props as { locale: Locale; concept: WebPortfolioConcept };
const en = locale === 'en';
const prefix = en ? '/en' : '';
const portfolio = getWebPortfolio(locale);
const related = portfolio.filter(item => item.slug !== concept.slug).sort((a, b) => Number(b.vertical === concept.vertical) - Number(a.vertical === concept.vertical)).slice(0, 3);
const benefits = themeBenefits(locale, concept);
const requestHref = themeRequestHref(locale, concept);
const indexHref = en ? '/en/webs/' : '/webs/';
const previewLabel = `${en ? 'Website preview' : 'Vista previa de la web'} ${concept.brand}`;
const tags = [concept.planLabel, concept.verticalLabel, 'Responsive'];
const visual = getWebThemeVisual(concept.slug);
const anatomy = themeAnatomy(locale, concept, visual.composition);
const process = themeProcess(locale, concept);
const plans = getPlanCards(locale);
const plan = plans.find(item => item.id === concept.plan)!;
const pricing = PLAN_PRICING[concept.plan];
const palette = [[en ? 'Background' : 'Fondo', visual.paper], [en ? 'Text' : 'Texto', visual.ink], [en ? 'Accent' : 'Acento', visual.accent]] as const;
const specs = [
  [en ? 'Starting plan' : 'Plan de partida', concept.planLabel],
  [en ? 'Accommodation' : 'Alojamiento', concept.verticalLabel],
  [en ? 'Hero composition' : 'Composición de portada', themeCompositionLabel(locale, visual.composition)],
  [en ? 'Sections' : 'Secciones', String(concept.visiblePages.length).padStart(2, '0')],
  [en ? 'Delivery' : 'Entrega', en ? 'Your own domain' : 'Tu propio dominio'],
] as const;
const heroSource = concept.image.replace(/\.webp$/, '');
const wirePages = concept.visiblePages.slice(0, 4);
---
<PortfolioViewAnalytics event="web_view" locale={locale} web={concept.slug} plan={concept.plan} />
<article class="theme-detail-page" data-theme-detail={concept.slug} style={visual.style}>
  <header class="theme-detail-head shell">
    <nav aria-label={en ? 'Theme catalogue' : 'Catálogo de temas'}><a href={indexHref}><span aria-hidden="true">←</span>{en ? 'Back to all themes' : 'Volver a todos los temas'}</a></nav>
    <div class="theme-detail-heading">
      <div>
        <p class="eyebrow">{en ? `Website theme · ${concept.verticalLabel}` : `Tema web · ${concept.verticalLabel}`}</p>
        <h1>{concept.brand}<span class="theme-detail-subtitle">{en ? 'Website design for your accommodation' : 'Diseño web para tu alojamiento'}</span></h1>
        <p class="theme-detail-summary">{concept.summary}</p>
      </div>
      <aside class="theme-spec" aria-labelledby="theme-spec-title">
        <h2 id="theme-spec-title"><span>{en ? 'Theme sheet' : 'Ficha técnica'}</span><code>{concept.slug}</code></h2>
        <dl>{specs.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
        <div class="theme-palette">
          <span>{en ? 'Palette' : 'Paleta'}</span>
          <ul>{palette.map(([name, hex]) => <li><i style={`background:${hex}`} aria-hidden="true"></i><span>{name}</span><code>{hex}</code></li>)}</ul>
        </div>
      </aside>
    </div>
    <p class="theme-detail-boundary" role="note">{en ? 'Fictional design · no real property or customer. ' : 'Diseño ficticio · no representa un alojamiento ni un cliente real. '}{concept.boundary}</p>
  </header>
  <section class="theme-detail-preview shell" aria-label={previewLabel}>
    <dialog open class="theme-detail-stage" data-theme-detail-stage aria-label={previewLabel}>
      <div class="theme-detail-browser">
        <div class="theme-detail-bar">
          <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{concept.slug}.{en ? 'yourdomain.com' : 'tudominio.com'}</span>
          <button type="button" data-theme-detail-expand aria-expanded="false" aria-label={en ? 'Expand preview' : 'Ampliar vista previa'} data-open-label={en ? 'Expand preview' : 'Ampliar vista previa'} data-close-label={en ? 'Close expanded preview' : 'Cerrar vista ampliada'}><span class="expand-icon"><InterfaceIcon name="external" /></span><span class="collapse-icon"><InterfaceIcon name="close" /></span></button>
        </div>
        <div class="theme-detail-screen"><iframe src={`${concept.demoHref}?embed=theme`} sandbox="allow-scripts" title={previewLabel} data-theme-detail-frame loading="lazy"></iframe></div>
      </div>
      <aside class="theme-detail-side">
        <p class="eyebrow">{en ? 'Your next website' : 'Tu próxima web'}</p><h2>{concept.brand}</h2><p>{concept.visualIntent}</p>
        <div class="theme-detail-tags">{tags.map(tag => <span>{tag}</span>)}</div>
        <ul>{benefits.map(point => <li><InterfaceIcon name="check" /><span>{point}</span></li>)}</ul>
        <div class="theme-detail-side-actions" data-commercial-actions>
          <a class="pill" href={concept.demoHref} target="_blank" rel="noopener noreferrer" data-theme-open={concept.slug}>{en ? 'Explore the website' : 'Explorar la web'}<InterfaceIcon name="external" /></a>
          <a class="pill ghost" href={requestHref} data-theme-request={concept.slug}>{en ? 'I want this website' : 'Quiero esta web'}<InterfaceIcon name="arrow" /></a>
        </div>
        <p class="theme-detail-boundary" role="note">{concept.boundary}</p>
        <small>{en ? 'We adapt it to your brand, your spaces and the way you welcome guests.' : 'La adaptamos a tu marca, tus espacios y tu forma de recibir a los huéspedes.'}</small>
      </aside>
    </dialog>
  </section>

  <section class="theme-anatomy shell" aria-labelledby="theme-anatomy-title" data-theme-anatomy>
    <header>
      <p class="eyebrow">{en ? 'Theme anatomy' : 'Anatomía del tema'}</p>
      <h2 id="theme-anatomy-title">{en ? 'How the page is built, block by block.' : 'Cómo está construida la página, bloque a bloque.'}</h2>
      <p>{concept.businessProblem}</p>
    </header>
    <div class="theme-anatomy-grid">
      <figure class:list={['theme-wire', `theme-wire-${visual.composition}`]} aria-hidden="true">
        <div class="theme-wire-chrome"><i></i><i></i><i></i><span>{concept.slug}.{en ? 'yourdomain.com' : 'tudominio.com'}</span></div>
        <div class="theme-wire-page">
          <div class="theme-wire-nav" data-part="01"><b>{concept.brand}</b><span>{wirePages.map(page => <em>{page}</em>)}</span></div>
          <div class="theme-wire-hero" data-part="02">
            <picture><source type="image/avif" srcset={`${heroSource}-640.avif 640w, ${heroSource}-960.avif 960w`} sizes="(max-width: 760px) 90vw, 560px" /><img src={concept.image} alt="" width="2016" height="1344" loading="lazy" decoding="async" /></picture>
            <div><small>{concept.verticalLabel}</small><strong>{concept.showcase.title}</strong><span></span></div>
          </div>
          <div class="theme-wire-pages" data-part="03">{wirePages.map((page, index) => <div><small>{String(index + 1).padStart(2, '0')} / {page}</small><i></i><i></i></div>)}</div>
          <div class="theme-wire-cta" data-part="04"><span></span><b>{en ? 'Contact' : 'Contacto'}</b></div>
          <div class="theme-wire-footer" data-part="05"><span>{concept.brand}</span><i></i><i></i></div>
        </div>
      </figure>
      <ol class="theme-anatomy-legend">
        {anatomy.map(part => <li data-anatomy-part={part.region}><span>{part.index}</span><div><h3>{part.title}</h3><p>{part.text}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="theme-detail-info shell" aria-labelledby="theme-process-title">
    <div class="theme-detail-story">
      <p class="eyebrow">{en ? 'From theme to your website' : 'Del tema a tu web'}</p>
      <h2 id="theme-process-title">{en ? 'An identity that makes your accommodation stand out.' : 'Una identidad que pone en valor tu alojamiento.'}</h2>
      <p>{en ? 'We tailor the imagery, content and calls to action around your property.' : 'Adaptamos las imágenes, el contenido y las llamadas a la acción alrededor de tu alojamiento.'}</p>
      <ol class="theme-process">{process.map(([title, text], index) => <li><b>{String(index + 1).padStart(2, '0')}</b><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
    </div>
    <aside class="theme-detail-facts" aria-labelledby="theme-plan-title">
      <p class="theme-plan-kicker">{en ? 'Suggested starting plan' : 'Plan de partida sugerido'}</p>
      <h3 id="theme-plan-title">{plan.name}</h3>
      <p class="theme-plan-price"><strong>{en ? 'From' : 'Desde'} {euro(pricing.monthly, locale)}</strong><span>{en ? '/month' : '/mes'}</span></p>
      <p class="theme-plan-setup">{en ? `Setup from ${euro(pricing.setup, locale)} · excl. VAT` : `Implantación desde ${euro(pricing.setup, locale)} · sin IVA`}</p>
      <ol class="theme-plan-ladder" aria-label={en ? 'The three plans' : 'Los tres planes'}>{plans.map(item => <li aria-current={item.id === concept.plan ? 'true' : undefined}><span>{item.name}</span></li>)}</ol>
      <ul>{plan.visible.map(item => <li><InterfaceIcon name="check" /><span>{item}</span></li>)}</ul>
      <p class="theme-plan-note">{en ? 'Indicative prices. Scope, timing and conditions are confirmed in the proposal.' : 'Precios orientativos. Alcance, plazos y condiciones se confirman en la propuesta.'} <a href={`${prefix}/${en ? 'plans' : 'planes'}/`}>{en ? 'Compare plans' : 'Comparar planes'}</a></p>
      <a class="pill" href={requestHref} data-commercial-actions>{en ? 'I want this website' : 'Quiero esta web'}<InterfaceIcon name="arrow" /></a>
    </aside>
  </section>
  <section class="theme-detail-related shell" aria-labelledby="theme-related-title">
    <header><h2 id="theme-related-title">{en ? 'Related themes' : 'Temas relacionados'}</h2><a class="text-link" href={indexHref}>{en ? 'See all themes' : 'Ver todos los temas'}<InterfaceIcon name="arrow" /></a></header>
    <div>{related.map(item => <a class="theme-related-card" href={themeDetailHref(locale, item.slug)}><WebMiniature concept={item} /><span><b>{item.brand}</b><small>{item.planLabel} · {item.verticalLabel}</small><i aria-hidden="true">→</i></span></a>)}</div>
  </section>
</article>
<HomeClosing locale={locale} />

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-theme-detail-stage]').forEach(stage => {
    const trigger = stage.querySelector<HTMLButtonElement>('[data-theme-detail-expand]');
    const restore = () => {
      if (stage.matches(':modal')) return;
      stage.classList.remove('is-expanded');
      document.documentElement.classList.remove('theme-detail-locked');
      if (!stage.open) stage.show();
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.setAttribute('aria-label', trigger.dataset.openLabel ?? '');
      trigger?.focus({ preventScroll: true });
    };
    trigger?.addEventListener('click', () => {
      if (stage.matches(':modal')) { stage.close(); return; }
      stage.close();
      stage.classList.add('is-expanded');
      stage.showModal();
      document.documentElement.classList.add('theme-detail-locked');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', trigger.dataset.closeLabel ?? '');
      trigger.focus({ preventScroll: true });
    });
    stage.addEventListener('close', restore);
  });
</script>

<style>
  :global(html.theme-detail-locked){overflow:hidden}
  .theme-detail-page{background:var(--paper);color:var(--ink);padding-bottom:1px}
  .theme-detail-page>.shell{width:min(calc(100% - 64px),1360px)}
  .theme-detail-head{padding:clamp(40px,5vw,72px) 0 clamp(32px,4vw,52px)}
  .theme-detail-head nav a{display:inline-flex;min-height:44px;align-items:center;gap:10px;color:var(--slate);font-size:.8125rem;font-weight:600;text-decoration:none}
  .theme-detail-head nav a:hover{color:var(--ink)}
  .theme-detail-heading{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(32px,6vw,96px);align-items:end;margin-top:clamp(28px,4vw,52px)}
  .theme-detail-heading h1{margin:14px 0 0;font:400 clamp(3.4rem,7vw,6.5rem)/.92 var(--serif);letter-spacing:-.045em;overflow-wrap:normal}
  .theme-detail-subtitle{display:block;margin-top:18px;color:var(--slate);font:500 1rem/1.5 var(--sans);letter-spacing:normal}
  .theme-detail-summary{max-width:620px;margin:22px 0 0;color:var(--slate);font-size:clamp(1rem,1.3vw,1.1875rem);line-height:1.65}
  .theme-spec{min-width:0;border:1px solid var(--l2b-line);border-radius:var(--l2b-radius-lg);background:var(--l2b-surface);box-shadow:var(--l2b-shadow-md);overflow:hidden}
  .theme-spec h2{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0;border-bottom:1px solid var(--l2b-line);padding:13px 18px;background:var(--l2b-mist);font:500 .6875rem/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--l2b-slate)}
  .theme-spec h2 code{border-radius:5px;padding:2px 7px;color:var(--l2b-signal-text);background:var(--l2b-signal-soft);font:500 .6875rem var(--mono);letter-spacing:.02em;text-transform:none}
  .theme-spec dl{margin:0;padding:4px 18px}
  .theme-spec dl>div{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--l2b-line);padding:11px 0;font-size:.8125rem}
  .theme-spec dl>div:first-child{border-top:0}
  .theme-spec dt{color:var(--slate)}
  .theme-spec dd{margin:0;font-weight:600;text-align:right}
  .theme-palette{border-top:1px solid var(--l2b-line);padding:14px 18px 16px}
  .theme-palette>span{color:var(--slate);font-size:.8125rem}
  .theme-palette ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0 0;padding:0;list-style:none}
  .theme-palette li{display:grid;gap:3px;min-width:0}
  .theme-palette i{display:block;height:34px;border:1px solid rgb(21 37 28 / .12);border-radius:8px}
  .theme-palette li span{font-size:.75rem;font-weight:600}
  .theme-palette code{color:var(--slate);font:500 .6875rem var(--mono);text-transform:uppercase}
  .theme-detail-boundary{max-width:900px;margin:22px 0 0;color:var(--slate);font-size:.875rem;line-height:1.6}
  .theme-detail-preview{padding-bottom:clamp(64px,8vw,112px)}
  .theme-detail-stage{position:relative;display:grid;grid-template-columns:minmax(0,1fr) clamp(300px,25vw,370px);gap:16px;width:100%;max-width:none;max-height:none;margin:0;border:1px solid var(--l2b-line);border-radius:var(--l2b-radius-lg);padding:14px;background:var(--l2b-mist);background-image:var(--l2b-grid);background-size:24px 24px;color:inherit;overflow:visible}
  .theme-detail-browser{min-width:0;overflow:hidden;border:1px solid var(--l2b-line-strong);border-radius:12px;background:#fff;box-shadow:var(--l2b-shadow-md)}
  .theme-detail-bar{display:flex;align-items:center;gap:10px;min-height:46px;padding:0 9px 0 16px;border-bottom:1px solid var(--l2b-line);background:var(--l2b-paper)}
  .browser-dots{display:flex;gap:6px}.browser-dots i{width:9px;height:9px;border-radius:50%;background:#c8d1c4}
  .theme-detail-bar>span:not(.browser-dots){min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--slate);font:500 .75rem var(--mono)}
  .theme-detail-bar button{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;margin-left:auto;padding:0;border:0;border-radius:10px;background:transparent;color:var(--ink);cursor:pointer}
  .theme-detail-bar button:hover{background:var(--l2b-mist)}.theme-detail-bar button .collapse-icon{display:none}
  .theme-detail-screen{height:clamp(520px,52vw,720px);overflow:hidden;background:white}.theme-detail-screen iframe{display:block;width:100%;height:100%;border:0;background:white}
  .theme-detail-side{display:flex;flex-direction:column;min-width:0;border-radius:12px;padding:clamp(24px,2.6vw,36px) clamp(18px,2vw,26px);background:var(--l2b-surface);border:1px solid var(--l2b-line)}
  .theme-detail-side .eyebrow{margin:0}.theme-detail-side h2{margin:12px 0 0;font:400 clamp(2.1rem,3.4vw,3rem)/1 var(--serif);letter-spacing:-.035em;overflow-wrap:normal}
  .theme-detail-side>p:not(.eyebrow){margin:16px 0 0;color:var(--slate);font-size:.875rem;line-height:1.6}
  .theme-detail-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}.theme-detail-tags span{border:1px solid var(--l2b-line-strong);border-radius:6px;padding:5px 9px;color:var(--l2b-slate);font:500 .6875rem var(--mono)}
  .theme-detail-side ul{display:grid;gap:12px;margin:22px 0 0;padding:0;list-style:none}.theme-detail-side li{display:grid;grid-template-columns:20px 1fr;gap:8px;color:var(--slate);font-size:.8125rem;line-height:1.5}
  .theme-detail-side li :global(.interface-icon){color:var(--l2b-signal-text)}
  .theme-detail-side-actions{display:grid;gap:10px;margin-top:auto;padding-top:26px}.theme-detail-side-actions a,.theme-detail-facts>.pill{display:flex;justify-content:space-between;gap:12px;min-height:48px;font-size:.8125rem;text-decoration:none;white-space:normal}
  .theme-detail-side>small{margin-top:14px;color:var(--slate);font-size:.75rem;line-height:1.5}
  .theme-detail-side .theme-detail-boundary{font-size:.8125rem}
  .theme-detail-stage.is-expanded{position:fixed;inset:12px;z-index:100;width:calc(100% - 24px);height:calc(100dvh - 24px);padding:14px;border-radius:18px;overflow:hidden}.theme-detail-stage::backdrop{background:#0f1c15d9;backdrop-filter:blur(6px)}
  .is-expanded .theme-detail-browser{display:grid;grid-template-rows:46px minmax(0,1fr)}.is-expanded .theme-detail-screen{height:100%;min-height:0}.is-expanded .theme-detail-side{overflow-y:auto}.is-expanded .theme-detail-bar button .expand-icon{display:none}.is-expanded .theme-detail-bar button .collapse-icon{display:block}

  /* Anatomía: wireframe con los colores del tema y leyenda numerada. */
  .theme-anatomy{padding-bottom:clamp(72px,9vw,128px)}
  .theme-anatomy>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:12px clamp(28px,6vw,96px);align-items:end}
  .theme-anatomy>header .eyebrow{grid-column:1/-1;margin:0}
  .theme-anatomy h2{margin:0;overflow-wrap:anywhere;font:400 clamp(2.2rem,4.2vw,3.6rem)/1.05 var(--serif);letter-spacing:-.035em;text-wrap:balance}
  .theme-anatomy>header>p:last-child{margin:0;color:var(--slate);font-size:1rem;line-height:1.7}
  .theme-anatomy-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(28px,5vw,72px);align-items:start;margin-top:clamp(32px,4vw,52px)}
  .theme-wire{position:relative;min-width:0;margin:0;border:1px solid var(--l2b-line);border-radius:var(--l2b-radius-lg);padding:14px;background:var(--l2b-mist);background-image:var(--l2b-grid);background-size:24px 24px}
  .theme-wire-chrome{display:flex;align-items:center;gap:5px;border:1px solid var(--l2b-line-strong);border-bottom:0;border-radius:10px 10px 0 0;padding:9px 12px;background:var(--l2b-paper)}
  .theme-wire-chrome i{width:7px;height:7px;border-radius:50%;background:#c8d1c4}
  .theme-wire-chrome span{min-width:0;overflow-wrap:anywhere;margin-left:8px;color:var(--slate);font:500 .625rem var(--mono)}
  .theme-wire-page{display:grid;gap:8px;border:1px solid var(--l2b-line-strong);border-radius:0 0 10px 10px;padding:10px;color:var(--theme-ink);background:var(--theme-paper)}
  .theme-wire-page>div{position:relative;border:1px dashed color-mix(in srgb,var(--theme-ink) 26%,transparent);border-radius:6px}
  .theme-wire-page>div::before{position:absolute;z-index:3;top:-9px;left:-9px;display:grid;width:22px;height:22px;place-items:center;border-radius:50%;color:#fff;background:var(--l2b-forest);box-shadow:0 0 0 3px var(--l2b-paper);font:600 .5625rem var(--mono);content:attr(data-part)}
  .theme-wire-nav{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px}
  .theme-wire-nav b{font:400 .875rem var(--serif);overflow-wrap:anywhere}
  .theme-wire-nav span{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:4px 10px;min-width:0}
  .theme-wire-nav em{font:normal 500 .5625rem var(--sans);opacity:.75;overflow-wrap:anywhere}
  .theme-wire-hero{display:grid;min-height:230px}
  .theme-wire-hero picture{overflow:hidden;border-radius:5px}
  .theme-wire-hero>div{border-radius:5px}
  .theme-wire-hero picture,.theme-wire-hero img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--theme-image-position)}
  .theme-wire-hero>div{display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:16px}
  .theme-wire-hero small{color:var(--theme-accent);font:600 .5625rem var(--sans);letter-spacing:.1em;text-transform:uppercase}
  .theme-wire-hero strong{max-width:320px;font:400 clamp(1.2rem,2.2vw,1.65rem)/1.02 var(--serif);letter-spacing:-.02em}
  .theme-wire-hero>div>span{width:72px;height:2px;margin-top:6px;background:currentColor;opacity:.6}
  .theme-wire-split .theme-wire-hero{grid-template-columns:1fr 1fr}
  .theme-wire-split .theme-wire-hero picture{order:2}
  .theme-wire-landscape .theme-wire-hero,.theme-wire-framed .theme-wire-hero{grid-template-areas:'stack'}
  .theme-wire-landscape .theme-wire-hero>*,.theme-wire-framed .theme-wire-hero>*{grid-area:stack}
  .theme-wire-landscape .theme-wire-hero>div,.theme-wire-framed .theme-wire-hero>div{position:relative;color:#fff;background:linear-gradient(0deg,#0d140fcc,#0d140f22 70%)}
  .theme-wire-landscape .theme-wire-hero small,.theme-wire-framed .theme-wire-hero small{color:#f1ebe0}
  .theme-wire-framed .theme-wire-hero>div{align-items:center;justify-content:center;margin:14px;border:1px solid #ffffffa6;background:#0d140f8c;text-align:center}
  .theme-wire-pages{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(110px,100%),1fr));gap:8px;padding:10px}
