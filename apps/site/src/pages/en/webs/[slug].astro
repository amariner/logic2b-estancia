---
import Base from '../../../layouts/Base.astro';
import WebConceptPage from '../../../components/WebConceptPage.astro';
import { getWebPortfolio, type WebPortfolioConcept } from '../../../web-portfolio';

export function getStaticPaths() {
  return getWebPortfolio('en').map((concept) => ({ params: { slug: concept.slug }, props: { concept } }));
}

const { concept } = Astro.props as { concept: WebPortfolioConcept };
const title = `${concept.brand}: ${concept.verticalLabel.toLowerCase()} website concept | Logic2B Estancias`;
const description = `${concept.summary} A navigable fictional concept with explicit evidence boundaries.`;
const heroMaxWidth = concept.status === 'canonical' ? 1600 : 1280;
const heroSource = concept.image.replace(/\.webp$/, '');
---
<Base locale="en" route={`webs/${concept.slug}`} alternateRoute={`webs/${concept.slug}`} title={title} description={description} image={concept.image} imageAlt={concept.imageAlt} preloadImage={`${heroSource}-${heroMaxWidth}.avif`} preloadImageSrcset={`${heroSource}-640.avif 640w, ${heroSource}-960.avif 960w, ${heroSource}-${heroMaxWidth}.avif ${heroMaxWidth}w`} preloadImageSizes="100vw" preloadImageType="image/avif"><WebConceptPage locale="en" concept={concept} /></Base>
