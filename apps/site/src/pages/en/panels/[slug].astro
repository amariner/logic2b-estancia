---
import Base from '../../../layouts/Base.astro';
import PanelDetailPage from '../../../components/PanelDetailPage.astro';
import { getPublishedPanels, type PanelPortfolioItem } from '../../../panel-portfolio';

export function getStaticPaths() {
  return getPublishedPanels('en').map((panel) => ({ params: { slug: panel.slug }, props: { panel } }));
}

const { panel } = Astro.props as { panel: PanelPortfolioItem };
const titles: Record<PanelPortfolioItem['id'], string> = {
  enquiries: 'Enquiries: hospitality workspace | Logic2B Estancias',
  planning: 'Planning: hospitality workspace | Logic2B Estancias',
  'guests-arrivals': 'Guests and arrivals: hospitality workspace | Logic2B Estancias',
  preparation: 'Preparation: operations workspace | Logic2B Estancias',
  'operations-revenue': 'Operations and revenue | Logic2B Estancias',
  copilot: 'Supervised copilot | Logic2B Estancias',
};
const descriptions: Record<PanelPortfolioItem['id'], string> = {
  enquiries: 'Resolve a fictitious Terrava enquiry: availability, alternative and in-memory confirmation. Amend or cancel with undo, without live bookings.',
  planning: 'Explore fourteen days of fictitious Terrava planning, filter eight homes and review stays and local changes. No live inventory or external connections.',
  'guests-arrivals': 'Review sample guests linked to confirmed fictitious Terrava stays. Shared dates and property, without real personal data or guest reporting.',
  preparation: 'Inspect room 408, its preparation window and a fictitious checklist in Aurem. Check the human review step and its operating boundaries.',
  'operations-revenue': 'Explore a fictitious 28-day scenario with revenue, occupancy and formulas in Aurem. Check its boundaries and unavailable forecasting.',
  copilot: 'Review a fictitious draft with sources, versions and human supervision in Aurem. Check that no model, provider or external delivery is involved.',
};
const title = titles[panel.id];
const description = descriptions[panel.id];
---

<Base locale="en" route={`panels/${panel.slug}`} alternateRoute={`paneles/${panel.alternateSlug}`} title={title} description={description}><PanelDetailPage locale="en" panel={panel} /></Base>
