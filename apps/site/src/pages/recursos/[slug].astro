---
import Base from '../../layouts/Base.astro';
import { SPANISH_RESOURCES, SPANISH_RESOURCE_SLUGS, type SpanishResourceSlug } from '../../resources';

export function getStaticPaths() {
  return SPANISH_RESOURCE_SLUGS.map((slug) => ({ params: { slug } }));
}

const article = SPANISH_RESOURCES[Astro.params.slug as SpanishResourceSlug];
---
<Base locale="es" route={`recursos/${Astro.params.slug}`} title={`${article.seoTitle} | Logic2B Estancias`} description={article.description} translated={false}>
  <article class="resource shell"><header><p class="eyebrow">{article.eyebrow}</p><h1 class="display">{article.title}</h1><p>{article.intro}</p></header><div class="resource-body">{article.sections.map(([title, body], index) => <section><span>0{index + 1}</span><div><h2>{title}</h2><p>{body}</p></div></section>)}</div><aside class="resource-cta card"><h2>Descubre qué capa necesita tu alojamiento.</h2><p>El diagnóstico muestra una recomendación antes de pedir tus datos.</p><a class="pill" href="/diagnostico/" data-track="cta_click" data-section="resource">Empezar diagnóstico →</a></aside></article>
</Base>
