---
import Base from '../../layouts/Base.astro';
import ThemeDetail from '../../components/ThemeDetail.astro';
import { getWebPortfolio, type WebPortfolioConcept } from '../../web-portfolio';
import { themeMetadata } from '../../theme-detail';
export function getStaticPaths() { return getWebPortfolio('es').map(concept => ({ params: { slug: concept.slug }, props: { concept } })); }
const { concept } = Astro.props as { concept: WebPortfolioConcept };
const metadata = themeMetadata('es', concept);
---
<Base locale="es" route={`temas/${concept.slug}`} alternateRoute={`temas/${concept.slug}`} title={metadata.title} description={metadata.description} image={concept.image} imageAlt={concept.imageAlt}><ThemeDetail locale="es" concept={concept} /></Base>
