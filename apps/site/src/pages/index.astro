---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
---
<Base locale="es" title="Web y gestor de estancias online | Logic2B Estancias" description="Web gestionada y gestor de estancias online para casas rurales, apartamentos y hoteles. Ordena consultas, reservas y operación con el equipo de Logic2B." preloadImage="/media/remanso/hero-1280.avif" preloadImageSrcset="/media/remanso/hero-640.avif 640w, /media/remanso/hero-960.avif 960w, /media/remanso/hero-1280.avif 1280w" preloadImageSizes="(max-width: 640px) calc(100vw - 28px), (max-width: 800px) calc(100vw - 40px), (max-width: 1100px) 760px, 650px" preloadImageType="image/avif"><Landing locale="es" /></Base>
