---
import Base from '../../layouts/Base.astro';
import WebConceptPage from '../../components/WebConceptPage.astro';
import { getWebPortfolio, type WebPortfolioConcept } from '../../web-portfolio';

export function getStaticPaths() {
  return getWebPortfolio('es').map((concept) => ({ params: { slug: concept.slug }, props: { concept } }));
}

const { concept } = Astro.props as { concept: WebPortfolioConcept };
const title = `${concept.brand}: concepto web para ${concept.verticalLabel.toLowerCase()} | Logic2B Estancias`;
const description = `${concept.summary} Concepto ficticio y navegable con límites explícitos.`;
const heroMaxWidth = concept.status === 'canonical' ? 1600 : 1280;
---
<Base locale="es" route={`webs/${concept.slug}`} alternateRoute={`webs/${concept.slug}`} title={title} description={description} image={concept.image} imageAlt={concept.imageAlt} preloadImage={`/media/${concept.slug}/hero-${heroMaxWidth}.avif`} preloadImageSrcset={`/media/${concept.slug}/hero-640.avif 640w, /media/${concept.slug}/hero-960.avif 960w, /media/${concept.slug}/hero-${heroMaxWidth}.avif ${heroMaxWidth}w`} preloadImageSizes="100vw" preloadImageType="image/avif"><WebConceptPage locale="es" concept={concept} /></Base>
